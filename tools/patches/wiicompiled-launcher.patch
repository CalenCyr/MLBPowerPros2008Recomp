+#pragma once
+
+// Pre-boot settings screen drawn with the runtime's ImGui before the guest starts.
+namespace launcher {
+enum class Result { Play, Quit, Relaunch };
+
+// Runs the launcher when enabled ([launcher] show_on_startup, default on). Skipped when
+// WIICOMPILED_SKIP_LAUNCHER is set and for automated runs (WIICOMPILED_BENCH, scripted pad input).
+// Relaunch means a setting that needs a fresh renderer was saved: shut the renderer and the process
+// transcript down (so the standard handles are the original ones again), then call Relaunch().
+Result Run(int argc, char** argv);
+
+// Starts this executable again, same arguments, with WIICOMPILED_SKIP_LAUNCHER=1.
+bool Relaunch();
+} // namespace launcher
