+            PpcInstruction.Synthetic(baseAddr + 0x14, 0, "rlwinm", new PpcOperand[] { new PpcRegisterOperand("r0", 0), new PpcRegisterOperand("r0", 0), new PpcImmediateOperand(2), new PpcImmediateOperand(0), new PpcImmediateOperand(29) }),
