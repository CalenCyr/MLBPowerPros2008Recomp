+    private static bool IndexComesFromByteLoad(IReadOnlyList<PpcInstruction> ordered, int startIndex, string register)
+    {
+        // Follow the shift that builds the byte offset back to its source; true when that source
+        // is written by a byte load.
+        var current = register;
+        for (var i = startIndex - 1; i >= 0 && startIndex - i <= MaxBacktrackInstructions; i--)
+        {
+            var ins = ordered[i];
+            if (ins.Operands.Count < 2 || ins.Operands[0] is not PpcRegisterOperand reg ||
+                !string.Equals(reg.Name, current, StringComparison.OrdinalIgnoreCase))
+            {
+                continue;
+            }
+            if (ins.Mnemonic is "rlwinm" or "slwi" && ins.Operands[1] is PpcRegisterOperand source)
+            {
+                current = source.Name;
+                continue;
+            }
+            return ins.Mnemonic is "lbz" or "lbzx" or "lbzu" or "lbzux";
+        }
+        return false;
+    }
