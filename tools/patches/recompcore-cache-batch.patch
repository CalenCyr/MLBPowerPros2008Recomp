+// POWERPROS_CACHE_BATCH_BEGIN
+namespace
+{
+u32 PowerProsCacheBatchCount(const CPUState* cpu, u32 raw, u32 cia, bool allowed,
+                           u32 pending_exceptions, bool dcache, bool lockstep)
+{
+  // Experimental RL8E54 module, compiled with loop budget 256. Preserve its
+  // final iteration and generated back-edge/system-call execution exactly.
+  if (!allowed || raw != 0x7C0018ACu || cia != 0x8009C4A4u || cpu->pc != cia ||
+      cpu->exception || pending_exceptions || dcache || lockstep ||
+      cpu->ctr < 2 || cpu->downcount >= 0 || cpu->downcount <= -254 ||
+      !cpu->ram || cpu->ram_size < 0x0009C4B4u)
+    return 1;
+  const auto read = [cpu](u32 offset) {
+    const u8* p = cpu->ram + offset;
+    return static_cast<u32>(p[0]) << 24 | static_cast<u32>(p[1]) << 16 |
+           static_cast<u32>(p[2]) << 8 | p[3];
+  };
+  if (read(0x9C4A4) != 0x7C0018ACu || read(0x9C4A8) != 0x38630020u ||
+      read(0x9C4AC) != 0x4200FFF8u || read(0x9C4B0) != 0x44000002u)
+    return 1;
+  const u32 until_back_edge = static_cast<u32>((256 + cpu->downcount + 1) / 2);
+  return cpu->ctr < until_back_edge ? cpu->ctr : until_back_edge;
+}
+
+template <typename Invalidate>
+void PowerProsRunCacheBatch(CPUState* cpu, u32 count, Invalidate&& invalidate)
+{
+  // Keep every per-line operation and wrapping u32 effective address. Only
+  // intermediate addi/bdnz pairs move here; generated C executes the last pair.
+  const u32 address = cpu->gpr[3];
+  for (u32 i = 0; i < count; ++i)
+    invalidate(address + i * 32u);
+  cpu->gpr[3] += (count - 1u) * 32u;
+  cpu->ctr -= count - 1u;
+  cpu->downcount -= static_cast<s64>(count - 1u) * 2;
+}
+}
