+// Return-from-interrupt preemption for direct-ABI HLE that paces on the host (GXCopyDisp's VI
+// pacing). Deferred VI/alarm/audio callbacks only leave threads READY and the scheduler pending;
+// on hardware the interrupt return then switches to a higher-priority READY thread. Without this,
+// a guest loop that never blocks (MLB's NOW LOADING screen) starved its loader thread forever:
+// the loader's 5 ms OSSleepTicks ticker was only ever woken from SelectThread.
+extern "C" void OS_HLE_PreemptionPoint()
+{
+    if (!OS_HLE_InterruptsEnabled() || ::Memory::Read32(kSchedulerIdleFlagAddr) != 0 ||
+        VI_HLE_IsAdvancingRetrace()) {
+        return;
+    }
+    CpuContext* cpu = CurrentCpuContext();
+    if (cpu == nullptr) {
+        cpu = &GetPersistentCpuContext();
+    }
+    const uint32_t savedR3 = cpu->gpr[3];
+    cpu->gpr[3] = 0;  // no forced switch: SelectThread keeps the current thread unless outranked
+    SelectThread_801a9c08(cpu);
+    cpu->gpr[3] = savedR3;
+}
+
 extern "C" void SelectThread_801a9c08(CpuContext* ctx)
