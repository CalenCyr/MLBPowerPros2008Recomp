@@ -0,0 +1,35 @@
+// Guest functions the HLE layer calls directly by their Mario Kart Wii address,
+// forwarded to the same SDK function in MLB Power Pros 2008 (RL8E54). Addresses
+// come from tools/identify_sdk_functions.py / align_sdk_by_anchors.py in the
+// MLB recomp project; functions MLB does not link abort with their name.
+#include "game_profile.h"
+
+#ifdef WIICOMPILED_GAME_RL8E54
+
+#include "abi_bridge.h"
+
+#include <cstdlib>
+
+namespace {
+[[noreturn]] void Missing(const char* name) {
+    ShowRuntimeFatalPopup("MKW-only guest function reached", name);
+    std::abort();
+}
+} // namespace
+
+#define FORWARD(mkw, mlb) \
+    extern "C" void func_##mlb(CpuContext* ctx); \
+    extern "C" void func_##mkw(CpuContext* ctx) { func_##mlb(ctx); }
+#define MISSING(mkw, name) \
+    extern "C" void func_##mkw(CpuContext*) { Missing(name); }
+
+FORWARD(801A0620, 8009B448)  // InsertAlarm
+FORWARD(801A1ED8, 8009CCD8)  // OSSaveContext
+FORWARD(801A961C, 800A3C0C)  // __OSThreadInit
+FORWARD(801AADE0, 800A53A4)  // __OSTimeToSystemTime
+FORWARD(8055531C, 80AA0718)  // StaticR _prolog -> ovl_main.rel _prolog
+MISSING(8012B830, "AXFXReverbStdExpCallback")
+MISSING(801D8D30, "NHTTPStartup")
+MISSING(801D9E94, "NHTTPi_GetSystemInfoP")
+
+#endif // WIICOMPILED_GAME_RL8E54
