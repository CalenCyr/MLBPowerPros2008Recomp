+void GuestFiberManager::DebugDumpThreads() {
+    std::lock_guard<std::mutex> lock(s_mutex);
+    VI_DebugDump();
+    std::cerr << "[threads] GXCopyDisp=" << ::g_debugCopyDispCount.load() << " GXBegin=" << ::g_debugGxBeginCount.load() << std::endl;
+    std::cerr << "[threads] current=0x" << std::hex << s_currentGuestThread << std::dec
+              << " fibers=" << s_fibers.size() << std::endl;
+    for (const auto& [address, fiber] : s_fibers) {
+        std::cerr << "[threads] thread 0x" << std::hex << address << " entry=0x" << fiber.entryPoint
+                  << std::dec << " state=" << static_cast<uint32_t>(fiber.state)
+                  << (fiber.terminated ? " terminated" : "") << std::endl;
+        SystemBridge::DumpCpuState(&fiber.cpuContext);
+    }
+}
+
+namespace {
+#if defined(_WIN32)
+// The guest fibers run on the thread that starts the process; static init runs there too.
+HANDLE DebugMainThread() {
+    HANDLE handle = nullptr;
+    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &handle,
+                    THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0);
+    return handle;
+}
+
+// Suspends the guest thread and names each native frame through the translated-function
+// registry, which is where a blocked guest is actually waiting.
+void DebugDumpMainThreadStack(HANDLE thread) {
+    CONTEXT context{};
+    context.ContextFlags = CONTEXT_FULL;
+    if (SuspendThread(thread) == static_cast<DWORD>(-1)) {
+        return;
+    }
+    DWORD64 frames[48]{};
+    int count = 0;
+    if (GetThreadContext(thread, &context)) {
+        while (count < 48 && context.Rip != 0) {
+            frames[count++] = context.Rip;
+            DWORD64 imageBase = 0;
+            auto* entry = RtlLookupFunctionEntry(context.Rip, &imageBase, nullptr);
+            if (!entry) {
+                context.Rip = *reinterpret_cast<DWORD64*>(context.Rsp);
+                context.Rsp += 8;
+                continue;
+            }
+            void* handlerData = nullptr;
+            DWORD64 establisher = 0;
+            RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, context.Rip, entry, &context, &handlerData,
+                             &establisher, nullptr);
+        }
+    }
+    ResumeThread(thread);
+    std::cerr << "[threads] main host stack:";
+    for (int i = 0; i < count; ++i) {
+        if (auto info = TranslatedFunctionRegistry::FindByHostAddress(static_cast<uintptr_t>(frames[i]))) {
+            std::cerr << " " << info->name;
+        } else {
+            std::cerr << " 0x" << std::hex << frames[i] << std::dec;
+        }
+    }
+    std::cerr << std::endl;
+}
+#endif
+
+// Periodic dump for diagnosing hangs: WIICOMPILED_DEBUG_THREADS=<seconds>.
+const bool g_debugThreadsStarted = [] {
+    const char* seconds = std::getenv("WIICOMPILED_DEBUG_THREADS");
+    if (!seconds || std::atoi(seconds) <= 0) {
+        return false;
+    }
+#if defined(_WIN32)
+    HANDLE mainThread = DebugMainThread();
+#endif
+    std::thread([period = std::atoi(seconds)
+#if defined(_WIN32)
+                 , mainThread
+#endif
+    ] {
+        for (;;) {
+            std::this_thread::sleep_for(std::chrono::seconds(period));
+            GuestFiberManager::DebugDumpThreads();
+#if defined(_WIN32)
+            DebugDumpMainThreadStack(mainThread);
+#endif
+        }
+    }).detach();
+    return true;
+}();
+} // namespace
