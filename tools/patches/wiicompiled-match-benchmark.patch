@@ -0,0 +1,132 @@
+// Included inside settings_overlay's private namespace: reuse its live graphics setters.
+void DrawMatchBenchmark() {
+    if (!match_benchmark::Enabled()) return;
+    using BenchClock = std::chrono::steady_clock;
+    static const auto launched = BenchClock::now();
+    static const unsigned autoSeconds = [] {
+        const char* s = std::getenv("WIICOMPILED_MATCH_SECONDS");
+        unsigned seconds = 0;
+        return s && std::sscanf(s, "%u", &seconds) == 1 ? std::min(seconds, 600u) : 0u;
+    }();
+    static BenchClock::time_point field{}, start{}, last{};
+    static unsigned stable = 0;
+    static bool recording = false, completed = false;
+    static std::vector<double> intervals;
+    static std::ofstream csv;
+    static std::filesystem::path report;
+    static std::string message;
+    static AuroraFrameWaits base{}, previous{};
+    static AuroraGpuTiming gpuBase{}, gpuPrevious{};
+    const auto now = BenchClock::now();
+    AuroraFrameWaits waits{};
+    AuroraGpuTiming gpu{};
+    AuroraPresentTiming present{};
+    aurora_get_frame_waits(&waits);
+    aurora_get_gpu_timing(&gpu);
+    aurora_get_present_timing(&present);
+    const auto* stats = aurora_get_stats();
+    const bool onField = match_benchmark::Scene() == 409 && stats->drawCallCount >= 100;
+    if (field == BenchClock::time_point{}) {
+        stable = onField && aurora_get_queued_pipeline_count() == 0 ? stable + 1 : 0;
+        if (stable >= 60) field = now;
+    }
+    const bool ready = field != BenchClock::time_point{} && now - field >= std::chrono::seconds(5);
+    const auto begin = [&] {
+        const auto id = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+        const auto folder = RuntimeConfigFile::ApplicationDataDirectory() / "Benchmarks";
+        std::error_code ec;
+        std::filesystem::create_directories(folder, ec);
+        report = folder / ("match-" + std::to_string(id));
+        csv.open(report.string() + ".csv");
+        if (!csv) { message = "No se pudo crear el informe"; return; }
+        csv << "elapsed_s,frame_ms,draws,scale,force_16_9,backend,shader_queue,gpu_render_ms,gpu_samples,cpu_encode_ms,efb_copies,efb_source_pixels,efb_snapshots,efb_readbacks,efb_readback_wait_ms,presents\n";
+        start = last = now;
+        base = previous = waits;
+        gpuBase = gpuPrevious = gpu;
+        intervals.clear();
+        recording = true;
+        message = "Midiendo";
+        std::fprintf(stderr, "[match-bench] recording %s scale=%.0f force169=%d\n", report.string().c_str(), g_resolutionScale, g_forceAspect169);
+    };
+    const auto finish = [&] {
+        recording = false;
+        completed = true;
+        csv.close();
+        auto sorted = intervals;
+        std::sort(sorted.begin(), sorted.end());
+        const double elapsed = std::chrono::duration<double>(now - start).count();
+        const double frames = static_cast<double>(waits.presents - base.presents);
+        const auto percentile = [&](double p) { return sorted.empty() ? 0.0 : sorted[std::min(sorted.size()-1, static_cast<size_t>(p * sorted.size()))]; };
+        std::ofstream summary(report.string() + ".txt");
+        summary << "Yankees vs Colorado; CPU vs CPU; Coors Field; seeded start\n"
+                << "scale=" << g_resolutionScale << " force_16_9=" << g_forceAspect169 << " backend=" << GraphicsApiDisplayName() << '\n'
+                << "seconds=" << elapsed << " presented_frames=" << frames << " fps=" << (elapsed > 0 ? frames/elapsed : 0) << '\n'
+                << "host_frame_p50_ms=" << percentile(.50) << " p95_ms=" << percentile(.95) << " p99_ms=" << percentile(.99) << '\n';
+        const uint64_t samples = gpu.samples - gpuBase.samples;
+        summary << "gpu_supported=" << gpu.supported << " gpu_samples=" << samples << " gpu_dropped=" << gpu.dropped - gpuBase.dropped << '\n';
+        if (samples) summary << "gpu_render_mean_ms=" << double(gpu.totalNs - gpuBase.totalNs)/1e6/samples << '\n';
+        const double encoded = std::max(1.0, double(waits.encodedFrames - base.encodedFrames));
+        summary << "cpu_encode_mean_ms=" << double(waits.encodeNs - base.encodeNs)/1e6/encoded << '\n'
+                << "efb_texture_copies=" << waits.efbTextureCopies - base.efbTextureCopies << " efb_source_pixels=" << waits.efbCopySourcePixels - base.efbCopySourcePixels << '\n'
+                << "efb_snapshots=" << waits.efbSnapshotCopies - base.efbSnapshotCopies << " efb_readbacks=" << waits.efbReadbacks - base.efbReadbacks << '\n'
+                << "GPU markers exclude presenter work and demanded EFB prefixes. CPU autoplay is not a bit-exact replay.\n";
+        summary.close();
+        message = "Informe guardado en UserData/Benchmarks";
+        std::fprintf(stderr, "[match-bench] saved %s.txt\n", report.string().c_str());
+    };
+    if (ready && autoSeconds && !recording && !completed) begin();
+    if (recording) {
+        const double ms = std::chrono::duration<double, std::milli>(now - last).count();
+        intervals.push_back(ms);
+        const uint64_t samples = gpu.samples - gpuPrevious.samples;
+        csv << std::chrono::duration<double>(now - start).count() << ',' << ms << ',' << stats->drawCallCount << ','
+            << g_resolutionScale << ',' << g_forceAspect169 << ',' << GraphicsApiDisplayName() << ',' << aurora_get_queued_pipeline_count() << ',';
+        if (samples) csv << double(gpu.totalNs - gpuPrevious.totalNs)/1e6/samples;
+        csv << ',' << samples << ',' << double(waits.encodeNs - previous.encodeNs)/1e6 << ','
+            << waits.efbTextureCopies - previous.efbTextureCopies << ',' << waits.efbCopySourcePixels - previous.efbCopySourcePixels << ','
+            << waits.efbSnapshotCopies - previous.efbSnapshotCopies << ',' << waits.efbReadbacks - previous.efbReadbacks << ','
+            << double(waits.efbReadbackWaitNs - previous.efbReadbackWaitNs)/1e6 << ',' << waits.presents - previous.presents << '\n';
+        previous = waits; gpuPrevious = gpu; last = now;
+        if (now - start >= std::chrono::seconds(autoSeconds ? autoSeconds : 30)) {
+            finish();
+            if (autoSeconds) std::_Exit(0);
+        }
+    }
+    if (autoSeconds && !completed && now - launched > std::chrono::seconds(120 + autoSeconds)) {
+        std::fprintf(stderr, "[match-bench] timeout: actual field was not ready\n");
+        std::fflush(stderr);
+        std::_Exit(3);
+    }
+    ImGui::SetNextWindowPos(ImVec2(16, 40), ImGuiCond_FirstUseEver);
+    ImGui::SetNextWindowBgAlpha(.90f);
+    if (ImGui::Begin("Prueba GPU - Yankees / Colorado", nullptr, ImGuiWindowFlags_AlwaysAutoResize)) {
+        ImGui::TextUnformatted(ready ? "Partido automatico de prueba" : "Preparando partido y shaders...");
+        ImGui::BeginDisabled(recording);
+        for (int scale = 1; scale <= 4; ++scale) {
+            if (scale > 1) ImGui::SameLine();
+            char label[8]; std::snprintf(label, sizeof(label), "x%d", scale);
+            if (ImGui::Button(label)) { SetResolutionScale(float(scale)); field = now; stable = 0; completed = false; }
+        }
+        if (ImGui::Checkbox("Forzar 16:9", &g_forceAspect169)) {
+            SetMkwForceAspect169(g_forceAspect169);
+            RuntimeConfigFile::SetForceAspect169(g_forceAspect169);
+            field = now; completed = false;
+        }
+        if (ImGui::Button("Mas opciones (F10)")) g_topBarVisible = !g_topBarVisible;
+        ImGui::EndDisabled();
+        ImGui::Text("FPS %.1f | %s | x%.0f", present.framesPerSecond, GraphicsApiDisplayName(), g_resolutionScale);
+        if (gpu.supported && gpu.samples) ImGui::Text("GPU render: %.2f ms | dibujos: %u", double(gpu.lastNs)/1e6, stats->drawCallCount);
+        else ImGui::TextUnformatted("Tiempo GPU: no disponible");
+        if (!recording) {
+            ImGui::BeginDisabled(!ready);
+            if (ImGui::Button("Medir 30 segundos")) begin();
+            ImGui::EndDisabled();
+        } else {
+            ImGui::Text("Midiendo: %.1f s", std::chrono::duration<double>(now-start).count());
+            if (ImGui::Button("Detener y guardar")) finish();
+        }
+        if (!message.empty()) ImGui::TextUnformatted(message.c_str());
+        ImGui::TextDisabled("Ajustes temporales. Informes: UserData/Benchmarks");
+    }
+    ImGui::End();
+}
