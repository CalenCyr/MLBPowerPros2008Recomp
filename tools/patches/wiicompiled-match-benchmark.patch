new file mode 100644
index 0000000..35917ad
--- /dev/null
+++ b/runtime/src/match_benchmark.cpp
@@ -0,0 +1,99 @@
+#include "match_benchmark.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+#include <cstdlib>
+#include <cstdio>
+#include <atomic>
+#include "settings_overlay.h"
+
+#if defined(WIICOMPILED_GAME_RL8E54)
+extern "C" void func_80C8BAF0(CpuContext*);
+extern "C" void func_80973828(CpuContext*);
+extern "C" void func_807A8BE8(CpuContext*);
+#endif
+namespace match_benchmark {
+static std::atomic<uint32_t> currentScene{0};
+uint32_t Scene() { return currentScene.load(); }
+void OnHostFrame() {
+#if defined(WIICOMPILED_GAME_RL8E54)
+    if (!Enabled()) return;
+    const uint32_t manager = Memory::Read32(0x81033268u);
+    if (!manager || !Memory::Contains(manager, 1100) || Memory::Read32(manager) != 0x80D4EB88u) return;
+    const uint32_t scene = Memory::Read32(manager + 1024);
+    currentScene.store(Memory::Read32(manager + 1032));
+    if (Scene() == 3 && scene && Memory::Contains(scene, 76) && (Memory::Read32(scene + 56) == 5 || Memory::Read32(scene + 56) == 6) && Memory::Read32(scene + 72) != 0)
+        Memory::Write32(scene + 72, 3);
+#endif
+}
+bool Enabled() {
+#if defined(WIICOMPILED_GAME_RL8E54)
+    static const bool enabled = [] { const char* v = std::getenv("WIICOMPILED_MATCH_BENCH"); return v && *v == '1'; }();
+    return enabled;
+#else
+    return false;
+#endif
+}
+void OnGuestFrame(CpuContext* cpu) {
+#if defined(WIICOMPILED_GAME_RL8E54)
+    if (!Enabled() || !cpu || cpu->gpr[13] != 0x80322060u) return;
+    const uint32_t manager = Memory::Read32(0x81033268u);
+    if (!manager || !Memory::Contains(manager, 1100) || Memory::Read32(manager) != 0x80D4EB88u) return;
+    const uint32_t mode = Memory::Read32(manager + 1032);
+    currentScene.store(mode);
+    const uint32_t next = Memory::Read32(manager + 1028);
+    const uint32_t scene = Memory::Read32(manager + 1024);
+    const uint32_t phase = scene && Memory::Contains(scene, 60) ? Memory::Read32(scene + 56) : 0;
+    const auto action = DecideBoot(mode, next, Memory::Read8(manager + 1040) == 1, phase);
+    static uint32_t last = ~0u;
+    if (mode != last) { std::fprintf(stderr, "[match-bench] scene=%u next=%u phase=%u\n", mode, next, phase); last = mode; }
+    // Scene 3 is the opening movie. Let its own stop/cleanup phase run.
+    if (mode == 3 && (phase == 5 || phase == 6) && Memory::Read32(scene + 72) != 0) {
+        Memory::Write32(scene + 72, 3);
+    }
+    if (action == BootAction::LoadData) {
+        settings_overlay::NotifyStrapInputAccepted();
+        Memory::Write32(manager + 1028, 3);
+        Memory::Write8(manager + 1040, 1);
+        Memory::Write8(manager + 1043, 1);
+    } else if (action == BootAction::PrepareMatch) {
+        static bool prepared = false;
+        if (prepared) {
+            Memory::Write32(manager + 1028, 409);
+            return;
+        }
+        prepared = true;
+        // Call the original game initializer, preserving the suspended guest's ABI.
+        const CpuContext saved = *cpu;
+        Memory::Write32(cpu->gpr[13] - 32744, 0x4D4C4208u);
+        func_80C8BAF0(cpu);
+        const uint32_t config = Memory::Read32(0x8104E1D8u);
+        const uint32_t common = Memory::Read32(0x8103D118u);
+        Memory::Write8(config + 19, 3); // New York Yankees (AL East)
+        Memory::Write8(config + 20, 27); // Colorado Rockies (NL West)
+        for (uint32_t side = 0; side < 2; ++side) {
+            const uint8_t team = side == 0 ? 3 : 27;
+            Memory::Write8(common + 1752 + side * 2204, team);
+            Memory::Write8(common + 1753 + side * 2204, team);
+            cpu->gpr[3] = side;
+            cpu->gpr[4] = team;
+            func_80973828(cpu);
+        }
+        cpu->gpr[3] = 27;
+        func_807A8BE8(cpu);
+        Memory::Write8(config + 31, static_cast<uint8_t>(cpu->gpr[3]));
+        Memory::Write8(common + 4, static_cast<uint8_t>(cpu->gpr[3]));
+        Memory::Write8(config + 18, 0);
+        Memory::Write8(config + 13, 0); // Exhibition, with no human controller mask.
+        Memory::Write8(config + 14, 0);
+        Memory::Write8(config + 26, 3);
+        Memory::Write8(config + 27, 3);
+        Memory::Write16(common + 976, 0);
+        Memory::Write8(common + 978, 0);
+        *cpu = saved;
+        Memory::Write32(manager + 1028, 409);
+        Memory::Write8(manager + 1043, 1);
+        std::fprintf(stderr, "[match-bench] prepared teams=3,27 stadium=%u common=%08x\n", Memory::Read8(config + 31), common);
+    }
+#endif
+}
+}
