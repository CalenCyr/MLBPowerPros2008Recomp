+#pragma once
+#include <cstdint>
+struct CpuContext;
+namespace match_benchmark {
+enum class BootAction { Wait, LoadData, PrepareMatch };
+constexpr BootAction DecideBoot(uint32_t mode, uint32_t next, bool transition, uint32_t phase) {
+    if ((mode == 1 || mode == 2) && !transition && (phase == 5 || phase == 6)) return BootAction::LoadData;
+    if (mode == 3 && next == 4 && transition) return BootAction::PrepareMatch;
+    return BootAction::Wait;
+}
+bool Enabled();
+uint32_t Scene();
+void OnGuestFrame(CpuContext* cpu);
+void OnHostFrame();
+}
