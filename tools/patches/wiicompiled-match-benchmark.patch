diff --git a/aurora-main/lib/webgpu/gpu_timing.hpp b/aurora-main/lib/webgpu/gpu_timing.hpp
new file mode 100644
index 0000000..048693b
--- /dev/null
+++ b/aurora-main/lib/webgpu/gpu_timing.hpp
@@ -0,0 +1,72 @@
+#pragma once
+#include "gpu.hpp"
+#include <aurora/gfx.h>
+#include <array>
+#include <atomic>
+#include <cstring>
+
+// Bounded, nonblocking timestamp readback. Only the encode worker reserves slots;
+// spontaneous map callbacks release them after consuming their own buffers.
+namespace aurora::webgpu::timing {
+struct Slot {
+  std::atomic<bool> busy{false};
+  wgpu::QuerySet queries;
+  wgpu::Buffer resolve, readback;
+};
+inline std::array<Slot, 8> slots;
+inline std::atomic<uint64_t> totalNs{0}, samples{0}, lastNs{0}, dropped{0};
+inline int begin(const wgpu::CommandEncoder& encoder) {
+  if (!g_device.HasFeature(wgpu::FeatureName::TimestampQuery)) return -1;
+  for (size_t i = 0; i < slots.size(); ++i) {
+    auto& slot = slots[i];
+    bool idle = false;
+    if (!slot.busy.compare_exchange_strong(idle, true)) continue;
+    if (!slot.queries) {
+      const wgpu::QuerySetDescriptor q{.label = "Benchmark GPU timestamps", .type = wgpu::QueryType::Timestamp, .count = 2};
+      slot.queries = g_device.CreateQuerySet(&q);
+      const wgpu::BufferDescriptor r{.label = "Benchmark timestamp resolve", .usage = wgpu::BufferUsage::QueryResolve | wgpu::BufferUsage::CopySrc, .size = 256};
+      const wgpu::BufferDescriptor b{.label = "Benchmark timestamp readback", .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst, .size = 256};
+      slot.resolve = g_device.CreateBuffer(&r);
+      slot.readback = g_device.CreateBuffer(&b);
+    }
+    const wgpu::PassTimestampWrites writes{.querySet = slot.queries, .beginningOfPassWriteIndex = 0};
+    const wgpu::ComputePassDescriptor marker{.label = "Benchmark start marker", .timestampWrites = &writes};
+    encoder.BeginComputePass(&marker).End();
+    return static_cast<int>(i);
+  }
+  ++dropped;
+  return -1;
+}
+inline void end(const wgpu::CommandEncoder& encoder, int index) {
+  if (index < 0) return;
+  auto& s = slots[index];
+  const wgpu::PassTimestampWrites writes{.querySet = s.queries, .endOfPassWriteIndex = 1};
+  const wgpu::ComputePassDescriptor marker{.label = "Benchmark end marker", .timestampWrites = &writes};
+  encoder.BeginComputePass(&marker).End();
+  encoder.ResolveQuerySet(s.queries, 0, 2, s.resolve, 0);
+  encoder.CopyBufferToBuffer(s.resolve, 0, s.readback, 0, 16);
+}
+inline void submitted(int index) {
+  if (index < 0) return;
+  slots[index].readback.MapAsync(wgpu::MapMode::Read, 0, 16, wgpu::CallbackMode::AllowSpontaneous,
+    [index](wgpu::MapAsyncStatus status, wgpu::StringView) {
+      auto& s = slots[index];
+      if (status == wgpu::MapAsyncStatus::Success) {
+        uint64_t values[2]{};
+        std::memcpy(values, s.readback.GetConstMappedRange(0, 16), 16);
+        s.readback.Unmap();
+        if (values[1] >= values[0]) {
+          const auto ns = values[1] - values[0];
+          totalNs.fetch_add(ns);
+          lastNs.store(ns);
+          samples.fetch_add(1);
+        }
+      } else { ++dropped; }
+      s.busy.store(false);
+    });
+}
+inline AuroraGpuTiming get() {
+  return {totalNs.load(), samples.load(), lastNs.load(), dropped.load(),
+          g_device && g_device.HasFeature(wgpu::FeatureName::TimestampQuery) ? 1u : 0u};
+}
+}
