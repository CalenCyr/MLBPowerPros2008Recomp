diff --git a/runtime/src/hle/input/pad.cpp b/runtime/src/hle/input/pad.cpp
index f9ddd8d..e6b2bc0 100644
--- a/runtime/src/hle/input/pad.cpp
+++ b/runtime/src/hle/input/pad.cpp
@@ -91,7 +91,8 @@ void WritePadStatus(uint32_t base, const PADStatus& status) {
 
 // Scripted GameCube pad on port 0 for automated probes:
 // WIICOMPILED_PAD_SCRIPT="startMs-endMs:hexButtons,..." holds PAD_BUTTON_* bits (A 0x100,
-// START 0x1000, UP 0x8) during each SDL_GetTicks window; the port reports connected.
+// START 0x1000, UP 0x8; 0x10000-0x80000 C-stick right/left/up/down) during each SDL_GetTicks
+// window; the port reports connected.
 void ApplyPadScript(PADStatus* statuses) {
     struct Step { unsigned long long start, end; unsigned int hold; };
     static const std::vector<Step> script = [] {
@@ -111,7 +112,13 @@ void ApplyPadScript(PADStatus* statuses) {
     PADStatus& status = statuses[0];
     status.err = PAD_ERR_NONE;
     for (const Step& step : script) {
