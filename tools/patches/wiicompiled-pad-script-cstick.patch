+        if (now < step.start || now >= step.end) continue;
+        status.button |= static_cast<u16>(step.hold);
+        // Bits 16-19 push the C-stick right, left, up or down (menus open player data with it).
+        if (step.hold & 0x10000) status.substickX = 127;
+        if (step.hold & 0x20000) status.substickX = -127;
+        if (step.hold & 0x40000) status.substickY = 127;
