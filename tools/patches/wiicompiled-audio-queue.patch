+// The guest produces audio on its own thread and stalls for up to ~100 ms (loading, busy
+// frames). The queue absorbs that: playback aims at kTargetMs, and the hard limit only
+// guards against runaway growth.
+constexpr uint32_t kTargetMs = 80;
+constexpr uint32_t kQueueLimitMs = 250;
 
+uint32_t AudioBackend::BytesForMsLocked(uint32_t ms) const {
     const uint64_t bytesPerSecond = static_cast<uint64_t>(m_spec.freq) *
                                     static_cast<uint64_t>(m_spec.channels) *
