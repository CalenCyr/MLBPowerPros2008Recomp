-    return static_cast<uint32_t>((bytesPerSecond * queueMs) / 1000u);
+    return static_cast<uint32_t>((bytesPerSecond * ms) / 1000u);
+}
+
+uint32_t AudioBackend::QueueLimitBytesLocked() const {
+    return BytesForMsLocked(kQueueLimitMs);
+}
+
+// Keeps the queue near kTargetMs instead of cutting it: catch-up after a stall used to
+// stack latency until the limit dropped blocks, and a drained queue underran. Playback
+// speed moves by at most 2% (not heard as pitch). An empty queue pauses the device until
+// the target is buffered again, so a long stall is a short silence instead of crackle.
+void AudioBackend::RegulateLocked() {
+    const int queued = SDL_GetAudioStreamQueued(m_stream);
+    if (queued < 0) {
+        return;
+    }
+    const uint32_t target = BytesForMsLocked(kTargetMs);
+    if (!m_playing) {
+        if (static_cast<uint32_t>(queued) >= target && SDL_ResumeAudioStreamDevice(m_stream)) {
+            m_playing = true;
+        }
+        return;
+    }
+    const float error = (static_cast<float>(queued) - static_cast<float>(target)) / static_cast<float>(target);
+    const float ratio = std::clamp(1.0f + 0.02f * error, 0.98f, 1.02f);
+    if (std::fabs(ratio - m_ratio) >= 0.001f && SDL_SetAudioStreamFrequencyRatio(m_stream, ratio)) {
+        m_ratio = ratio;
+    }
+}
+
+AudioBackend::Stats AudioBackend::TakeStats() {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    Stats s = m_stats;
+    s.ratio = m_ratio;
+    m_stats = {};
+    return s;
 }
 
