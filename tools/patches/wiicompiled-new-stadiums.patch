+++ b/runtime/src/hle/mlb/new_stadiums.cpp
@@ -0,0 +1,203 @@
+// MLB Power Pros 2008 (RL8E54) game-specific natives: stadiums added by mods (mods::NewStadiums).
+//
+// The game knows 40 stadiums. GetStadiumFiles (0x80C7AF48) reads their files from a 40-entry
+// table. The Exhibition stadium select screen builds a carousel of stadium numbers at +0x296C
+// (count +0x2968, cursor +0x2938, room for 38: 30 MLB + the unlocked originals) and shows the
+// entry under the cursor with ShowStadium (0x80CD3F6C) after every move.
+//
+// New stadiums are extra carousel entries after the game's. The list has 1 to 8 free slots, so
+// they scroll through them as a window: ShowStadium sees the cursor enter or leave the slots and
+// moves the window instead (pressing right on the last slot shows the next new stadium). A slot
+// holds the new stadium's base stadium number, so the rest of the game (dimensions, saves) sees a
+// stadium it knows; only its files and menu pictures differ:
+//   - ShowStadium loads and shows the new stadium's menu pack in place of the base's;
+//   - GetStadiumFiles returns the new stadium's files when it was the one picked (Exhibition).
+// docs/ingenieria-inversa.md, section 5, "Lista de estadios del juego".
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "mods.h"
+
+namespace {
+
+constexpr uint32_t kStadiumTable = 0x80E9F9D0;   // 40 x {gfx file id, tbl file id, tbl root pointer}
+constexpr uint32_t kMenuTable = 0x80EA23D8;      // [number] -> stadium menu pack file id (this screen)
+constexpr uint32_t kDisplayTable = 0x80D99E38;   // (number - 1) * 0x1C: {menu pack id, texture pointers}
+constexpr uint32_t kMatchConfig = 0x8104E1D8;    // -> config; +13 mode (0 Exhibition), +31 stadium
+constexpr uint32_t kCursor = 0x2938, kShown = 0x293C, kIdle = 0x2940, kRequested = 0x2941, kCount = 0x2968,
+                   kList = 0x296C, kDisplay1 = 0x2A18, kDisplay2 = 0x2A1C;
+constexpr uint32_t kListRoom = 38;
+constexpr uint32_t kResourceManager = 0x8064ED54, kIsBusy = 0x8064FEE0, kRequest = 0x8064FEC0,
+                   kIsLoaded = 0x8064FEE8, kShowMenuPack = 0x807A8EBC;
+
+uint32_t R(uint32_t a) { return Memory::Read32(a); }
+void W(uint32_t a, uint32_t v) { Memory::Write32(a, v); }
+
+uint32_t Call(CpuContext* cpu, uint32_t target, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0) {
+    cpu->gpr[3] = a;
+    cpu->gpr[4] = b;
+    cpu->gpr[5] = c;
+    InvokeIndirectCpu(target, cpu);
+    return cpu->gpr[3];
+}
+
+struct State {
+    uint32_t screen = 0;
+    uint32_t gameCount = 0;  // the game's own entries
+    uint32_t slots = 0;      // free list slots used for new stadiums
+    uint32_t window = 0;     // first new stadium in the slots
+    uint32_t cursor = 0;     // cursor seen at the previous call
+    std::vector<bool> requested;
+    int32_t shownExtra = -1;
+    const mods::NewStadium* picked = nullptr;  // new stadium under the cursor
+    const mods::NewStadium* forced = nullptr;  // WIICOMPILED_MATCH_BENCH_STADIUM
+} g;
+
+void FillSlots(uint32_t screen) {
+    const auto& stadiums = mods::NewStadiums();
+    for (uint32_t i = 0; i < g.slots; ++i) W(screen + kList + 4 * (g.gameCount + i), stadiums[g.window + i].base);
+}
+
+// First call for a freshly built carousel: append the window of new stadiums.
+void Attach(uint32_t screen) {
+    const auto& stadiums = mods::NewStadiums();
+    g.screen = screen;
+    g.gameCount = std::min(R(screen + kCount), kListRoom);
+    g.slots = std::min<uint32_t>(kListRoom - g.gameCount, static_cast<uint32_t>(stadiums.size()));
+    g.window = 0;
+    g.requested.assign(stadiums.size(), false);
+    g.shownExtra = -1;
+    g.picked = nullptr;
+    FillSlots(screen);
+    W(screen + kCount, g.gameCount + g.slots);
+    g.cursor = R(screen + kCursor);
+}
+
+// Turns a move onto/off the slots into a window scroll; returns the new stadium under the cursor.
+const mods::NewStadium* Track(uint32_t screen) {
+    const auto& stadiums = mods::NewStadiums();
+    const uint32_t total = static_cast<uint32_t>(stadiums.size());
+    const uint32_t first = g.gameCount, last = g.gameCount + g.slots - 1;
+    uint32_t cursor = R(screen + kCursor);
+    const uint32_t before = g.cursor;
+    uint32_t window = g.window;
+    if (before == last && cursor == 0 && window + g.slots < total) {          // right past the last slot
+        ++window;
+        cursor = last;
+    } else if (before == first && cursor == first - 1 && window > 0 && first > 0) {  // left past the first
+        --window;
+        cursor = first;
+    } else if (before == 0 && cursor == last) {                                // wrapped left from the start
+        window = total - g.slots;
+    } else if (before == first - 1 && cursor == first) {                       // entered from the left
+        window = 0;
+    }
+    if (window != g.window) {
+        g.window = window;
+        FillSlots(screen);
+    }
+    W(screen + kCursor, cursor);
+    g.cursor = cursor;
+    return cursor >= first && cursor <= last ? &stadiums[g.window + (cursor - first)] : nullptr;
+}
+
+}  // namespace
+
+namespace new_stadiums {
+
+// For the match benchmark: the base stadium number of new stadium `code`, which the next match
+// then loads; 0 if there is no such stadium.
+uint32_t ForceForMatch(const char* code) {
+    for (const auto& stadium : mods::NewStadiums()) {
+        if (stadium.code == code) {
+            g.forced = &stadium;
+            return stadium.base;
+        }
+    }
+    return 0;
+}
+
+}  // namespace new_stadiums
+
+// ShowStadium(screen, number, force) (0x80CD3F6C) of the Exhibition stadium select. The game's
+// version: when the resource manager is idle it loads the stadium's menu pack once (flag at
+// +0x2941 + number), and once loaded draws it on both display objects (modes 1 and 2) unless it is
+// already the one shown (+0x293C). Same here, plus the new stadiums.
+extern "C" void MLB_ShowStadium_80CD3F6C(CpuContext* ctx) {
+    const uint32_t screen = ctx->gpr[3];
+    const uint32_t number = ctx->gpr[4];
+    const uint32_t force = ctx->gpr[5];
+    const bool haveNew = !mods::NewStadiums().empty();
+    if (haveNew && (screen != g.screen || R(screen + kCount) != g.gameCount + g.slots)) Attach(screen);
+    const mods::NewStadium* extra = haveNew && g.slots != 0 ? Track(screen) : nullptr;
+    g.picked = extra;
+
+    const bool idle = Call(ctx, kIsBusy, Call(ctx, kResourceManager)) == 0;
+    Memory::Write8(screen + kIdle, idle ? 1 : 0);
+    if (idle && force == 0) return;
+
+    if (extra != nullptr) {
+        const size_t index = static_cast<size_t>(extra - mods::NewStadiums().data());
+        const uint32_t menu = extra->menu != 0 ? extra->menu : R(kMenuTable + 4 * extra->base);
+        if (!g.requested[index]) {
+            Call(ctx, kRequest, Call(ctx, kResourceManager), menu);
+            g.requested[index] = true;
+            return;
+        }
+        if (g.shownExtra == static_cast<int32_t>(index) || Call(ctx, kIsLoaded, Call(ctx, kResourceManager), menu) == 0) {
+            return;
+        }
+        // Draw it as the base stadium with its menu pack swapped in; the display objects cache the
+        // last (mode, stadium) at +0xDC/+0xE0, so invalidate them before and after.
+        const uint32_t entry = kDisplayTable + (extra->base - 1) * 0x1C;
+        const uint32_t saved = R(entry);
+        W(entry, menu);
+        for (const uint32_t at : {kDisplay1, kDisplay2}) W(R(screen + at) + 0xE0, 0xFFFFFFFFu);
+        Call(ctx, kShowMenuPack, R(screen + kDisplay1), 1, extra->base);
+        Call(ctx, kShowMenuPack, R(screen + kDisplay2), 2, extra->base);
+        W(entry, saved);
+        for (const uint32_t at : {kDisplay1, kDisplay2}) W(R(screen + at) + 0xE0, 0xFFFFFFFFu);
+        W(screen + kShown, 0xFFFFFFFFu);
+        g.shownExtra = static_cast<int32_t>(index);
+        return;
+    }
+    g.shownExtra = -1;
+    const uint32_t file = R(kMenuTable + 4 * number);
+    if (Memory::Read8(screen + kRequested + number) == 0) {
+        Call(ctx, kRequest, Call(ctx, kResourceManager), file);
+        Memory::Write8(screen + kRequested + number, 1);
+    } else if (Call(ctx, kIsLoaded, Call(ctx, kResourceManager), file) != 0 && R(screen + kShown) != number) {
+        Call(ctx, kShowMenuPack, R(screen + kDisplay1), 1, number);
+        Call(ctx, kShowMenuPack, R(screen + kDisplay2), 2, number);
+        W(screen + kShown, number);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(80CD3F6C, MLB_ShowStadium_80CD3F6C, (CpuContext* ctx), (ctx));
+
+// GetStadiumFiles(out, number) (0x80C7AF48): out = table[number - 1] (gfx id, tbl id, tbl root).
+extern "C" void MLB_GetStadiumFiles_80C7AF48(CpuContext* ctx) {
+    const uint32_t out = ctx->gpr[3];
+    const uint32_t number = ctx->gpr[4];
+    const uint32_t entry = kStadiumTable + (number - 1) * 12;
+    uint32_t gfx = R(entry), tbl = R(entry + 4), root = R(entry + 8);
+    const mods::NewStadium* stadium = g.forced != nullptr ? g.forced : g.picked;
+    const uint32_t config = R(kMatchConfig);
+    const bool exhibition = config != 0 && Memory::Read8(config + 13) == 0;
+    if (stadium != nullptr && stadium->base == number && exhibition) {
+        gfx = stadium->gfx;
+        tbl = stadium->tbl;
+        root = 0x40000000u | stadium->tblRoot;
+        std::fprintf(stderr, "[stadiums] loading \"%s\" (files %u/%u) for stadium %u\n", stadium->name.c_str(), gfx,
+                     tbl, number);
+        std::fflush(stderr);
+    }
+    W(out, gfx);
+    W(out + 4, tbl);
+    W(out + 8, root);
+}
+PPC_NATIVE_OVERRIDE_VOID(80C7AF48, MLB_GetStadiumFiles_80C7AF48, (CpuContext* ctx), (ctx));
