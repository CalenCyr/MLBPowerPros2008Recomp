+// Names (lower-case, no leading slash) and record indices of the disc's PROJECT.BIN entries.
+struct ProjectIndex {
+    std::map<std::string, uint32_t> names;
+    std::vector<bool> used;  // by record index
+};
+
+bool ReadProjectIndex(const std::filesystem::path& original, ProjectIndex& index) {
+    std::ifstream src(original, std::ios::binary);
+    std::vector<char> head(0x40);
+    if (!src.read(head.data(), static_cast<std::streamsize>(head.size()))) return false;
+    const uint32_t recordsOff = Be32(head, 0x14), orderOff = Be32(head, 0x28), namesOff = Be32(head, 0x2C),
+                   dataOff = Be32(head, 0x34);
+    if (!(recordsOff < orderOff && orderOff < namesOff && namesOff < dataOff)) return false;
+    std::vector<char> header(dataOff);
+    src.seekg(0);
+    if (!src.read(header.data(), static_cast<std::streamsize>(header.size()))) return false;
+    index.used.assign((orderOff - recordsOff) / 0x1C, false);
+    for (uint32_t slot = 1; orderOff + slot * 8 + 8 <= namesOff; ++slot) {
+        const uint32_t record = Be32(header, orderOff + slot * 8);
+        if (record == 0 && Be32(header, orderOff + slot * 8 + 4) == 0) break;
+        if (record >= index.used.size()) return false;
+        index.used[record] = true;
+        std::string name(header.data() + namesOff + Be32(header, recordsOff + record * 0x1C + 4));
+        index.names[Lower(name.substr(name.rfind('/') == 0 ? 1 : 0))] = record;
+    }
+    return true;
+}
