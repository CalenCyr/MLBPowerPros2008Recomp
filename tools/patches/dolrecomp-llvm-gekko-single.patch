+Value *convertToSingleBits(IRBuilder<> &builder, Value *x, bool ftz) {
+  Value *exponent = builder.CreateTrunc(
+      builder.CreateAnd(builder.CreateLShr(x, 52), builder.getInt64(0x7ff)),
+      builder.getInt32Ty());
+  Value *sign = builder.CreateTrunc(
+      builder.CreateAnd(builder.CreateLShr(x, 32), builder.getInt64(0x80000000ULL)),
+      builder.getInt32Ty());
+  Value *truncated = builder.CreateTrunc(
+      builder.CreateOr(
+          builder.CreateAnd(builder.CreateLShr(x, 32), builder.getInt64(0xc0000000ULL)),
+          builder.CreateAnd(builder.CreateLShr(x, 29), builder.getInt64(0x3fffffffULL))),
+      builder.getInt32Ty());
+  Value *direct = builder.CreateOr(
+      builder.CreateICmpUGT(exponent, builder.getInt32(896)),
+      builder.CreateICmpEQ(builder.CreateAnd(x, builder.getInt64(0x7fffffffffffffffULL)),
+                           builder.getInt64(0)));
+  if (ftz)
+    return builder.CreateSelect(direct, truncated, sign);
+  // 874 <= exp <= 896: denormalise by shifting; below 874 Gekko truncates.
+  Value *denormal = builder.CreateAnd(
+      builder.CreateNot(direct), builder.CreateICmpUGE(exponent, builder.getInt32(874)));
+  Value *shift = builder.CreateSelect(
+      denormal, builder.CreateSub(builder.getInt32(905), exponent), builder.getInt32(0));
+  Value *mantissa = builder.CreateOr(
+      builder.getInt32(0x80000000u),
+      builder.CreateTrunc(
+          builder.CreateLShr(builder.CreateAnd(x, builder.getInt64(0x000fffffffffffffULL)), 21),
+          builder.getInt32Ty()));
+  Value *shifted = builder.CreateOr(builder.CreateLShr(mantissa, shift), sign);
+  return builder.CreateSelect(denormal, shifted, truncated);
+}
