+bool AutomationStopPending(const std::filesystem::path& root)
+{
+  if (root.empty())
+    return false;
+  for (const auto& path : automation::ListCommandFiles(root / "commands"))
+  {
+    automation::Command command;
+    std::string error;
+    if (automation::ParseCommandFile(path, &command, &error) &&
+        command.type == automation::CommandType::Stop)
+      return true;
+  }
+  return false;
+}
