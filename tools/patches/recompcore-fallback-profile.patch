+// POWERPROS_FALLBACK_PROFILE_BEGIN
+namespace
+{
+struct PowerProsFallbackProfile
+{
+  static constexpr u64 stride = 1024;
+  static constexpr std::size_t max_sites = 4096;
+  std::string path;
+  u64 observed[2]{};
+  u64 dropped[2]{};
+  std::unordered_map<u64, u64> sites[2];
+
+  void Reset(const char* output)
+  {
+    path = output ? output : "";
+    for (int kind = 0; kind < 2; ++kind)
+    {
+      observed[kind] = dropped[kind] = 0;
+      sites[kind].clear();
+    }
+  }
+
+  void Observe(u32 pc, u32 raw, bool cache_fast)
+  {
+    if (path.empty())
+      return;
+    const int kind = cache_fast ? 1 : 0;
+    if ((++observed[kind] % stride) != 0)
+      return;
+    const u64 key = (static_cast<u64>(pc) << 32) | raw;
+    auto found = sites[kind].find(key);
+    if (found != sites[kind].end())
+      ++found->second;
+    else if (sites[kind].size() < max_sites)
+      sites[kind].emplace(key, 1);
+    else
+      ++dropped[kind];
+  }
+
+  bool Write() const
+  {
+    if (path.empty())
+      return true;
+    std::FILE* file = std::fopen(path.c_str(), "w");
+    if (!file)
+      return false;
+    bool ok = std::fprintf(file, "kind,pc,raw,count\nstride,00000000,00000000,%llu\n",
+                           static_cast<unsigned long long>(stride)) >= 0;
+    for (int kind = 0; kind < 2; ++kind)
+    {
+      const char* label = kind ? "cache_fast" : "slow";
+      ok &= std::fprintf(file, "total_%s,00000000,00000000,%llu\ndropped_%s,00000000,00000000,%llu\n",
+                         label, static_cast<unsigned long long>(observed[kind]),
+                         label, static_cast<unsigned long long>(dropped[kind])) >= 0;
+      for (const auto& site : sites[kind])
+        ok &= std::fprintf(file, "%s,%08X,%08X,%llu\n", label,
+                           static_cast<u32>(site.first >> 32), static_cast<u32>(site.first),
+                           static_cast<unsigned long long>(site.second)) >= 0;
+    }
+    return std::fclose(file) == 0 && ok;
+  }
+};
+PowerProsFallbackProfile g_powerpros_fallback_profile;
+}
+// POWERPROS_FALLBACK_PROFILE_END
+
+void PowerProsResetFallbackProfile()
+{
+  g_powerpros_fallback_profile.Reset(std::getenv("STATICRECOMP_FALLBACK_PROFILE"));
+}
+
+void PowerProsWriteFallbackProfile()
+{
+  if (!g_powerpros_fallback_profile.Write())
+    std::fprintf(stderr, "[powerpros-diagnostic] fallback profile write failed\n");
 }
 
