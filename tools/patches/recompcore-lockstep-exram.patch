+// POWERPROS_LOCKSTEP_EXRAM_BEGIN
+// The pinned module and MMU journal MEM1, not Wii MEM2. Keep complete MEM2
+// images only while checking a block; replay must not read native's post-image
+// or leak shadow writes back into the canonical native execution.
+struct PowerProsExramSnapshot
+{
+  u8* memory = nullptr;
+  std::vector<u8> pre;
+  std::vector<u8> post;
+  void Capture(u8* bytes, u32 size)
+  {
+    memory = bytes;
+    pre.clear();
+    post.clear();
+    if (bytes && size)
+      pre.assign(bytes, bytes + size);
+  }
+  bool BeginShadow(u8* bytes, u32 size)
+  {
+    if (bytes != memory || (bytes ? size : 0u) != pre.size())
+      return false;
+    if (!pre.empty())
+    {
+      post.assign(bytes, bytes + size);
+      std::memcpy(bytes, pre.data(), pre.size());
+    }
+    return true;
+  }
+  template <typename Report>
+  u64 Differences(Report&& report) const
+  {
+    if (post.empty() || std::memcmp(memory, post.data(), post.size()) == 0)
+      return 0;
+    u64 count = 0;
+    for (std::size_t i = 0; i < post.size(); ++i)
+      if (memory[i] != post[i])
+      {
+        if (count < 32)
+          report(static_cast<u32>(i), post[i], memory[i]);
+        ++count;
+      }
+    return count;
+  }
+  void RestoreNative()
+  {
+    if (!post.empty())
+      std::memcpy(memory, post.data(), post.size());
+  }
+};
+// POWERPROS_LOCKSTEP_EXRAM_END
