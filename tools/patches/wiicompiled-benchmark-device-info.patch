 // Included inside settings_overlay's private namespace: reuse its live graphics setters.
+// CPU, threads, RAM, GPU and OS, one per line, for the panel and the saved report.
+std::string BenchmarkDeviceInfo() {
+    char cpu[49] = {};
+#if defined(__x86_64__) || defined(__i386__)
+    unsigned r[4];
+    if (__get_cpuid(0x80000000u, &r[0], &r[1], &r[2], &r[3]) && r[0] >= 0x80000004u) {
+        for (unsigned i = 0; i < 3; ++i) {
+            __get_cpuid(0x80000002u + i, &r[0], &r[1], &r[2], &r[3]);
+            std::memcpy(cpu + i * 16, r, 16);
+        }
+    }
+#endif
+    std::string name = cpu;
+    name.erase(name.find_last_not_of(' ') + 1);
+    name.erase(0, name.find_first_not_of(' '));
+    const std::string gpu = aurora_get_adapter_name();
+    char ram[32];
+    std::snprintf(ram, sizeof(ram), "%.1f GB", SDL_GetSystemRAM() / 1024.0);
+    return "CPU: " + (name.empty() ? std::string("desconocida") : name) + " (" + std::to_string(SDL_GetNumLogicalCPUCores()) +
+           " hilos)\nRAM: " + ram + "\nGPU: " + (gpu.empty() ? std::string("desconocida") : gpu) + "\nSistema: " + SDL_GetPlatform();
+}
+
+// Live load, sampled twice a second on its own thread. CPU is this process over all logical
+// cores, as in Task Manager; GPU and VRAM come from the same Windows counters (pdh.dll is loaded
+// at run time so the build needs no extra library). -1 means not available.
+struct BenchUsage {
+    std::atomic<double> cpuPct{-1}, ramMb{-1}, systemUsedGb{-1}, gpuPct{-1}, vramMb{-1};
+};
+BenchUsage& BenchmarkUsage() {
+    static BenchUsage usage;
+#if defined(_WIN32)
+    static std::once_flag started;
+    std::call_once(started, [] {
+        std::thread([] {
+            HMODULE pdh = LoadLibraryW(L"pdh.dll");
+            const auto proc = [&](const char* name) { return pdh ? GetProcAddress(pdh, name) : nullptr; };
+            const auto open = reinterpret_cast<decltype(&PdhOpenQueryW)>(proc("PdhOpenQueryW"));
+            const auto add = reinterpret_cast<decltype(&PdhAddEnglishCounterW)>(proc("PdhAddEnglishCounterW"));
+            const auto collect = reinterpret_cast<decltype(&PdhCollectQueryData)>(proc("PdhCollectQueryData"));
+            const auto values = reinterpret_cast<decltype(&PdhGetFormattedCounterArrayW)>(proc("PdhGetFormattedCounterArrayW"));
+            PDH_HQUERY query = nullptr;
+            PDH_HCOUNTER gpuCounter = nullptr, vramCounter = nullptr;
+            if (open && add && collect && values && open(nullptr, 0, &query) == ERROR_SUCCESS) {
+                const std::wstring pid = std::to_wstring(GetCurrentProcessId());
+                if (add(query, (L"\\GPU Engine(pid_" + pid + L"_*engtype_3D)\\Utilization Percentage").c_str(), 0, &gpuCounter) != ERROR_SUCCESS) gpuCounter = nullptr;
+                if (add(query, (L"\\GPU Process Memory(pid_" + pid + L"_*)\\Dedicated Usage").c_str(), 0, &vramCounter) != ERROR_SUCCESS) vramCounter = nullptr;
+                collect(query);
+            }
+            // Sum over the counter's instances (one per engine or adapter).
+            const auto total = [&](PDH_HCOUNTER counter) {
+                DWORD bytes = 0, count = 0;
+                if (!counter || values(counter, PDH_FMT_DOUBLE, &bytes, &count, nullptr) != static_cast<PDH_STATUS>(PDH_MORE_DATA)) return -1.0;
+                std::vector<unsigned char> buffer(bytes);
+                auto* items = reinterpret_cast<PDH_FMT_COUNTERVALUE_ITEM_W*>(buffer.data());
+                if (values(counter, PDH_FMT_DOUBLE, &bytes, &count, items) != ERROR_SUCCESS) return -1.0;
+                double sum = 0;
+                for (DWORD i = 0; i < count; ++i) {
+                    if (items[i].FmtValue.CStatus == ERROR_SUCCESS) sum += items[i].FmtValue.doubleValue;
+                }
+                return sum;
+            };
+            const auto hundredNs = [](const FILETIME& t) { return (uint64_t(t.dwHighDateTime) << 32) | t.dwLowDateTime; };
+            const double cores = std::max(1, SDL_GetNumLogicalCPUCores());
+            uint64_t lastCpu = 0;
+            auto lastWall = std::chrono::steady_clock::now();
+            for (bool first = true;; first = false) {
+                FILETIME created, exited, kernel, user;
+                GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user);
+                const uint64_t cpu = hundredNs(kernel) + hundredNs(user);
+                const auto wall = std::chrono::steady_clock::now();
+                const double wallHundredNs = std::chrono::duration<double, std::ratio<1, 10000000>>(wall - lastWall).count();
+                if (!first && wallHundredNs > 0) usage.cpuPct = 100.0 * double(cpu - lastCpu) / wallHundredNs / cores;
+                lastCpu = cpu;
+                lastWall = wall;
+                PROCESS_MEMORY_COUNTERS memory{};
+                if (K32GetProcessMemoryInfo(GetCurrentProcess(), &memory, sizeof(memory))) usage.ramMb = memory.WorkingSetSize / 1048576.0;
+                MEMORYSTATUSEX system{};
+                system.dwLength = sizeof(system);
+                if (GlobalMemoryStatusEx(&system)) usage.systemUsedGb = double(system.ullTotalPhys - system.ullAvailPhys) / 1073741824.0;
+                if (query && collect(query) == ERROR_SUCCESS) {
+                    const double gpu = total(gpuCounter), vram = total(vramCounter);
+                    usage.gpuPct = gpu < 0 ? -1.0 : std::min(100.0, gpu);
+                    usage.vramMb = vram < 0 ? -1.0 : vram / 1048576.0;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds(500));
+            }
+        }).detach();
+    });
+#endif
+    return usage;
+}
