 // Included inside settings_overlay's private namespace: reuse its live graphics setters.
+// CPU, threads, RAM, GPU and OS, one per line, for the panel and the saved report.
+std::string BenchmarkDeviceInfo() {
+    char cpu[49] = {};
+#if defined(__x86_64__) || defined(__i386__)
+    unsigned r[4];
+    if (__get_cpuid(0x80000000u, &r[0], &r[1], &r[2], &r[3]) && r[0] >= 0x80000004u) {
+        for (unsigned i = 0; i < 3; ++i) {
+            __get_cpuid(0x80000002u + i, &r[0], &r[1], &r[2], &r[3]);
+            std::memcpy(cpu + i * 16, r, 16);
+        }
+    }
+#endif
+    std::string name = cpu;
+    name.erase(name.find_last_not_of(' ') + 1);
+    name.erase(0, name.find_first_not_of(' '));
+    const std::string gpu = aurora_get_adapter_name();
+    char ram[32];
+    std::snprintf(ram, sizeof(ram), "%.1f GB", SDL_GetSystemRAM() / 1024.0);
+    return "CPU: " + (name.empty() ? std::string("desconocida") : name) + " (" + std::to_string(SDL_GetNumLogicalCPUCores()) +
+           " hilos)\nRAM: " + ram + "\nGPU: " + (gpu.empty() ? std::string("desconocida") : gpu) + "\nSistema: " + SDL_GetPlatform();
+}
