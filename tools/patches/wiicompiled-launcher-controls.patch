+// Included in launcher::Run: the settings model and callbacks remain shared
+// with the normal launch path. ImGui containers clip and scroll their content.
+auto drawSettings = [&] {
+    static bool popupLastFrame = false;
+    const bool popupProtected = popupLastFrame;
+    const float fit = std::min(w / kArtW, h / kArtH);
+    const ImVec2 artOrigin((w-kArtW*fit)*.5f,(h-kArtH*fit)*.5f);
+    const auto at = [&](float x,float y) { return ImVec2(artOrigin.x+x*fit,artOrigin.y+y*fit); };
+    // The framed artwork only suits windows near its 16:9 shape; other shapes get a
+    // panel that fills the window instead of a letterboxed one.
+    const float aspect = w / h, artAspect = kArtW / kArtH;
+    const bool framed = art.ok && aspect > artAspect * .9f && aspect < artAspect * 1.12f;
+    if (framed) {
+        auto* bg=ImGui::GetBackgroundDrawList();
+        bg->AddImage(art.settingsBlur ? art.settingsBlur : art.settings,ImVec2(0,0),size,ImVec2(0,0),ImVec2(1,1),Rgba(75,100,155));
+        bg->AddImage(art.settings,at(0,0),at(kArtW,kArtH));
+        // Cover the old static separator and keyboard-only footer in the UI;
+        // the original artwork files remain untouched.
+        bg->AddImage(art.settings,at(846,236),at(855,762),ImVec2(837/kArtW,236/kArtH),ImVec2(846/kArtW,762/kArtH));
+        bg->AddRectFilledMultiColor(at(125,787),at(1548,853),Rgba(5,60,169),Rgba(5,85,201),Rgba(5,65,177),Rgba(5,45,145));
+    } else {
+        if (art.ok) ImGui::GetBackgroundDrawList()->AddImage(art.settingsBlur ? art.settingsBlur : art.settings,ImVec2(0,0),size,ImVec2(0,0),ImVec2(1,1),Rgba(75,100,155));
+        else DrawBackground(ImGui::GetBackgroundDrawList(),w,h,u,t,g_title);
+        ImGui::GetBackgroundDrawList()->AddRectFilled(ImVec2(w*.04f,h*.06f),ImVec2(w*.96f,h*.94f),Rgba(15,100,210),20);
+        ImGui::GetBackgroundDrawList()->AddRectFilledMultiColor(ImVec2(w*.04f+6,h*.06f+6),ImVec2(w*.96f-6,h*.94f-6),Rgba(25,140,245),Rgba(25,140,245),Rgba(4,66,177),Rgba(4,66,177));
+        ImGui::GetBackgroundDrawList()->AddRect(ImVec2(w*.04f,h*.06f),ImVec2(w*.96f,h*.94f),IM_COL32_WHITE,20,0,5);
+    }
+    const float scale=std::clamp(framed ? fit : std::min(w/1280.f,h/720.f),.8f,1.5f);
+    const ImVec2 panelPos=framed ? at(123,119) : ImVec2(w*.055f,h*.075f);
+    const ImVec2 panelSize=framed ? ImVec2(1425*fit,735*fit) : ImVec2(w*.89f,h*.85f);
+    ImGui::SetNextWindowPos(panelPos,ImGuiCond_Always);
+    ImGui::SetNextWindowSize(panelSize,ImGuiCond_Always);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(20 * scale, 16 * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 16 * scale);
+    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 8 * scale);
+    ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(10 * scale, 9 * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(12 * scale, 8 * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize,0);
+    ImGui::PushStyleVar(ImGuiStyleVar_PopupBorderSize,2);
+    ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0,0,0,0));
+    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(.05f,.25f,.65f,1));
+    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(.14f, .34f, .58f, 1));
+    ImGui::PushStyleColor(ImGuiCol_ButtonActive, ImVec4(.78f, .40f, .08f, 1));
+    ImGui::PushStyleColor(ImGuiCol_Header, ImVec4(.27f, .38f, .53f, 1));
+    ImGui::PushStyleColor(ImGuiCol_NavCursor, ImVec4(1, .76f, .25f, 1));
+    ImGui::PushStyleColor(ImGuiCol_PopupBg,ImVec4(.03f,.21f,.60f,.99f));
+    ImGui::PushStyleColor(ImGuiCol_FrameBg,ImVec4(.025f,.14f,.43f,1));
+    ImGui::PushStyleColor(ImGuiCol_FrameBgHovered,ImVec4(.12f,.39f,.75f,1));
+    ImGui::PushStyleColor(ImGuiCol_FrameBgActive,ImVec4(.20f,.46f,.85f,1));
+    ImGui::PushStyleColor(ImGuiCol_TextDisabled,ImVec4(.70f,.84f,1,1));
+    ImGui::PushStyleColor(ImGuiCol_Border,ImVec4(.70f,.85f,1,.85f));
+    ImGui::PushFont(g_menu);
+    // Settings lists move row by row with the pad/keys (below); ImGui's focus navigation is only
+    // used by the controls grid. NoNavInputs keeps ImGui reading the pad without moving focus.
+    const ImGuiWindowFlags listNav = tab != 2 ? ImGuiWindowFlags_NoNavInputs : 0;
+    ImGui::Begin("Ajustes del launcher", nullptr, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings | listNav);
+    ImGui::SetWindowFontScale(scale);
+    if (framed) {
+        const ImVec2 closeA=at(1465,120),closeB=at(1548,200);
+        const auto mouse=ImGui::GetIO().MousePos;
+        if (click && mouse.x>=closeA.x && mouse.x<closeB.x && mouse.y>=closeA.y && mouse.y<closeB.y) settingsOpen=false;
+    }
+    const float available = ImGui::GetContentRegionAvail().x - (framed ? 100*fit : 0);
+    float used = 0;
+    const int firstTab=art.ok && modsOnly ? kModsTab : 0;
+    const int tabCount=art.ok ? (modsOnly ? 2 : kModsTab) : int(tabs.size());
+    for (int i = firstTab; i < firstTab+tabCount; ++i) {
+        const float width = ImGui::CalcTextSize(tabs[i].name).x + ImGui::GetStyle().FramePadding.x * 2;
+        if (i != firstTab && used + width + 10 * scale <= available) { ImGui::SameLine(); used += 10 * scale; }
+        else used = 0;
+        ImGui::PushID(i);
+        const bool active = tab == i;
+        if (active) ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(.78f, .40f, .08f, 1));
+        if (launcher_visuals::PillButton(tabs[i].name,ImVec2(0,0),active)) { tab = i; row = 0; }
+        if (active) ImGui::PopStyleColor();
+        ImGui::PopID();
+        used += width;
+    }
+    if (framed) ImGui::SetCursorPosY(std::max(ImGui::GetCursorPosY(),(236-119)*fit));
+    ImGui::Separator();
+    const float footer = 58 * scale;
+    const float compactInfo = tab != 2 && available < 800 * scale ? 40 * scale : 0;
+    const float height = std::max(60.f, ImGui::GetContentRegionAvail().y - footer - compactInfo);
+    bool controlsBusy = false;
+    if (tab == 2) {
+        ImGui::BeginChild("Controles", ImVec2(0, height));
+        controlsBusy = launcher_controls::Draw();
+        ImGui::Separator();
+        Option& remote = option(2, 0);
+        bool remoteOn = remote.value != 0;
+        if (ImGui::Checkbox(remote.label, &remoteOn)) { remote.value = remoteOn; apply(2, 0); }
+        ImGui::EndChild();
+    } else {
+        const bool wide = available >= 800 * scale;
+        Tab& current = tabs[tab];
+        const int count = int(current.options.size());
+        const float rowHeight = 68 * scale;
+        pageRows = std::max(1, int((height - 60 * scale) / rowHeight));
+        row = std::clamp(row, 0, std::max(0, count - 1));
+        scroll = row / pageRows * pageRows;
+        const int shown = std::min(pageRows, count - scroll);
+        const float listWidth = wide ? available * .53f : available;
+        ImGui::BeginChild("Opciones", ImVec2(listWidth, height), 0, listNav);
+        ImGui::BeginChild("Lista", ImVec2(0, height - 56 * scale), 0, listNav);
+        ImGui::SetCursorPosY(ImGui::GetCursorPosY() + 5 * scale);  // room for the first pill's rim
+        for (int i = scroll; i < scroll + shown; ++i) {
+            Option& opt = current.options[i];
+            ImGui::PushID(i);
+            const float width = ImGui::GetContentRegionAvail().x;
+            ImGui::BeginGroup();
+            ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + width * .51f);
+            if (i == row) ImGui::TextColored(ImVec4(1, .82f, .4f, 1), "%s", opt.label);
+            else ImGui::TextUnformatted(opt.label);
+            ImGui::PopTextWrapPos();
+            ImGui::EndGroup();
+            ImGui::SameLine(width * .55f);
+            if (launcher_visuals::PillButton(opt.choices[opt.value].c_str(), ImVec2(width * .45f, 46 * scale), i == row)) { row = i; change(tab, i, 1); }
+            // The mouse only takes the selection when it moves, so a resting cursor does not fight the pad.
+            if (ImGui::IsItemHovered() && MouseMoved()) row = i;
+            if (ImGui::IsItemHovered() && ImGui::IsMouseClicked(ImGuiMouseButton_Right)) { row = i; change(tab, i, -1); }
