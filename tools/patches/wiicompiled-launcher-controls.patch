diff --git a/runtime/tests/launcher_controls_probe.inc b/runtime/tests/launcher_controls_probe.inc
new file mode 100644
index 0000000..9a9b90d
--- /dev/null
+++ b/runtime/tests/launcher_controls_probe.inc
@@ -0,0 +1,145 @@
+// Runs against the real SDL event queue and PADRead, without starting guest code.
+// Set WIICOMPILED_LAUNCHER_PROBE=1 in an isolated portable test directory.
+bool ProbeTick() {
+    static bool enabled = [] { const char* e = std::getenv("WIICOMPILED_LAUNCHER_PROBE"); return e && std::string(e) == "1"; }();
+    if (!enabled) return false;
+    const auto require = [](bool ok, const char* label) {
+        if (!ok) { std::fprintf(stderr, "launcher-probe FAILED: %s (%s)\n", label, SDL_GetError()); std::fflush(stderr); std::_Exit(2); }
+        std::fprintf(stderr, "launcher-probe PASS: %s\n", label);
+    };
+    static int frame = 0;
+    static SDL_JoystickID id = 0;
+    static SDL_Joystick* joystick = nullptr;
+    // Position and button go in the same frame: when the window has focus the SDL backend feeds
+    // the real cursor every frame, and ImGui applies a queued position+button pair together.
+    static ImVec4 target{};
+    const auto click = [](bool down) {
+        ImGui::GetIO().AddMousePosEvent((target.x + target.z) * .5f, (target.y + target.w) * .5f);
+        ImGui::GetIO().AddMouseButtonEvent(0, down);
+    };
+    const auto key = [](SDL_Scancode code) {
+        SDL_Event e{}; e.type = SDL_EVENT_KEY_DOWN; e.key.scancode = code; e.key.down = true; SDL_PushEvent(&e);
+    };
+    if (frame == 0) {
+        require(RuntimeConfigFile::PortableRootDirectory().has_value(), "isolated portable state");
+        if (const char* reload = std::getenv("WIICOMPILED_LAUNCHER_PROBE_RELOAD"); reload && std::string(reload) == "1") {
+            auto* response = PADGetStickResponse(0);
+            require(response && response->mainSensitivity == .5f && response->subSensitivity == 2.f, "response reloads in a new process");
+            const auto& a = RuntimeConfigFile::ControllerButton(0);
+            require(a && *a == "east", "button mapping reloads in a new process");
+            std::fprintf(stderr, "launcher-probe COMPLETE\n"); std::fflush(stderr);
+            return true;
+        }
+        int count = 0;
+        auto** windows = SDL_GetWindows(&count);
+        if (windows && count) SDL_RaiseWindow(windows[0]);
+        SDL_free(windows);
+        SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+        SDL_VirtualJoystickDesc desc{}; SDL_INIT_INTERFACE(&desc);
+        desc.type = SDL_JOYSTICK_TYPE_GAMEPAD; desc.vendor_id = 0x054c; desc.product_id = 0x0ce6;
+        desc.naxes = SDL_GAMEPAD_AXIS_COUNT; desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+        desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1;
+        desc.button_mask = (1u << SDL_GAMEPAD_BUTTON_COUNT) - 1; desc.name = "Launcher PS integration probe";
+        id = SDL_AttachVirtualJoystick(&desc); require(id != 0, "attach virtual PlayStation pad");
+        joystick = SDL_OpenJoystick(id); require(joystick != nullptr, "open virtual pad");
+    }
+    if (frame == 15) {
+        bool assigned = false;
+        for (uint32_t i = 0; i < PADCount(); ++i) {
+            auto* pad = PADGetSDLGamepadForIndex(i);
+            if (pad && SDL_GetGamepadID(pad) == id) { PADSetPortForIndex(i, 0); assigned = true; }
+        }
+        require(assigned, "assign virtual pad to player one");
+        SDL_SetJoystickVirtualButton(joystick, SDL_GAMEPAD_BUTTON_LEFT_STICK, true);  // L3: ImGui ignores it
+    }
+    if (frame == 25) {
+        require(UsingGamepad() && PlayStationPrompts() && std::string(AcceptPrompt()) == "Cruz", "PlayStation prompts after pad input");
+        SDL_SetJoystickVirtualButton(joystick, SDL_GAMEPAD_BUTTON_LEFT_STICK, false); key(SDL_SCANCODE_F9);
+    }
+    if (frame == 35) {
+        require(!UsingGamepad() && std::string(AcceptPrompt()) == "Enter", "keyboard prompts after keyboard input");
+        SDL_SetJoystickVirtualAxis(joystick, SDL_GAMEPAD_AXIS_LEFTX, 4000);
+    }
+    if (frame == 45) {
+        require(!UsingGamepad(), "resting stick noise keeps keyboard prompts");
+        SDL_SetJoystickVirtualAxis(joystick, SDL_GAMEPAD_AXIS_LEFTX, 20000);
+    }
+    if (frame == 55) {
+        require(UsingGamepad(), "stick movement switches prompts");
+        auto* dz = PADGetDeadZones(0); require(dz != nullptr, "dead zone available");
+        dz->useDeadzones = true; dz->stickDeadZone = 3000;
+        *PADGetStickResponse(0) = {.5f, 2.f};
+        PADStatus states[PAD_CHANMAX]{}; PADBlockInput(false); PADRead(states);
+        const auto expected = aurora::pad::ShapeStick(20000, 0, 3000, true, .5f);
+        require(states[0].stickX == expected.x && states[0].stickY == 0, "actual PADRead uses configured response curve");
+        SDL_SetJoystickVirtualAxis(joystick, SDL_GAMEPAD_AXIS_LEFTX, 32767);
+    }
+    if (frame == 65) {
+        PADStatus states[PAD_CHANMAX]{}; PADRead(states);
+        require(states[0].stickX == 127, "fine sensitivity retains full stick travel");
+        PADSerializeMappings();
+        std::ifstream saved(RuntimeConfigFile::ResolveConfigPath().parent_path() / "stick_response.txt");
+        int version = 0; float main = 0, sub = 0; saved >> version >> main >> sub;
+        require(version == 1 && main == .5f && sub == 2.f, "response settings persist");
+        SDL_SetJoystickVirtualAxis(joystick, SDL_GAMEPAD_AXIS_LEFTX, 0);
+    }
+    if (frame == 70) {
+        // The stick also moved ImGui's focus (and the scroll); take the hit box once it rests.
+        const auto r=bindingRects[0];
+        require(r.z>r.x && r.w>r.y,"binding rows expose hitboxes");
+        target = r;
+    }
+    if (frame==71) click(true);
+    if (frame==72) click(false);
+    if (frame==78) require(capture.kind==CaptureKind::Button && capture.row==0,"clicking a binding captures in place");
+    if (frame == 85) SDL_SetJoystickVirtualButton(joystick, SDL_GAMEPAD_BUTTON_EAST, true);
+    if (frame == 95) {
+        require(capture.kind == CaptureKind::None, "button capture completes from SDL event");
+        PADStatus states[PAD_CHANMAX]{}; PADRead(states);
+        require((states[0].button & PAD_BUTTON_A) && !(states[0].button & PAD_BUTTON_B), "rebinding swaps duplicate and reaches gameplay PADRead");
+        SDL_SetJoystickVirtualButton(joystick, SDL_GAMEPAD_BUTTON_EAST, false);
+        const auto r=axisRects[PAD_AXIS_LEFT_Y_POS];
+        require(r.z>r.x && r.w>r.y,"stick group exposes direction rows");
+        target = r;
+    }
+    if (frame==97) click(true);
+    if (frame==98) click(false);
+    if (frame==101) {
+        require(capture.kind==CaptureKind::Axis && capture.row==PAD_AXIS_LEFT_Y_POS && !ImGui::IsPopupOpen(nullptr,ImGuiPopupFlags_AnyPopupId),
+                "clicking a stick direction captures in place");
+        SDL_SetJoystickVirtualButton(joystick, SDL_GAMEPAD_BUTTON_NORTH, true);
+    }
+    if (frame==111) {
+        require(capture.kind==CaptureKind::None, "stick direction capture completes from a button");
+        PADStatus states[PAD_CHANMAX]{}; PADRead(states);
+        require(states[0].stickY > 100, "a button can drive a stick direction");
+        SDL_SetJoystickVirtualButton(joystick, SDL_GAMEPAD_BUTTON_NORTH, false);
+        const auto r=bindingRects[0];
+        target = r;
+    }
+    if (frame==113) click(true);
+    if (frame==114) click(false);
+    if (frame==118) {
+        require(capture.kind==CaptureKind::Button, "second capture starts");
+        SDL_Event e{}; e.type = SDL_EVENT_KEY_DOWN; e.key.scancode = SDL_SCANCODE_ESCAPE; e.key.down = true; SDL_PushEvent(&e);
+    }
+    if (frame==122) {
+        require(capture.kind==CaptureKind::None, "Esc cancels the capture");
+        testing = true;
+    }
+    if (frame == 125) {
+        require(testing, "stick test retains its mode");
+        SDL_CloseJoystick(joystick); SDL_DetachVirtualJoystick(id);
+    }
+    if (frame == 140) {
+        bool present = false;
+        for (uint32_t i = 0; i < PADCount(); ++i) {
+            auto* pad = PADGetSDLGamepadForIndex(i); if (pad && SDL_GetGamepadID(pad) == id) present = true;
+        }
+        require(!present, "disconnect handled");
+        std::fprintf(stderr, "launcher-probe COMPLETE\n"); std::fflush(stderr);
+        return true;
+    }
+    ++frame;
+    return false;
+}
diff --git a/runtime/tests/launcher_nav_probe.inc b/runtime/tests/launcher_nav_probe.inc
new file mode 100644
index 0000000..3311b8f
--- /dev/null
+++ b/runtime/tests/launcher_nav_probe.inc
@@ -0,0 +1,52 @@
+// Included in launcher::Run. WIICOMPILED_LAUNCHER_PROBE=nav (with WIICOMPILED_LAUNCHER_PAGE=settings,
+// in an isolated portable directory) drives the settings list with an SDL virtual pad: rows move
+// one at a time, left/right and Cross change the row, a held Cross does not repeat, R1 changes tab.
+auto navProbeTick = [&]() -> bool {
+    static int frame = 0;
+    static SDL_JoystickID id = 0;
+    static SDL_Joystick* joystick = nullptr;
+    static int start = 0, choices = 1;
+    const auto require = [](bool ok, const char* label) {
+        if (!ok) { std::fprintf(stderr, "launcher-nav FAILED: %s\n", label); std::fflush(stderr); std::_Exit(2); }
+        std::fprintf(stderr, "launcher-nav PASS: %s\n", label);
+    };
+    const auto button = [&](SDL_GamepadButton b, bool down) { SDL_SetJoystickVirtualButton(joystick, b, down); };
+    if (frame == 0) {
+        require(RuntimeConfigFile::PortableRootDirectory().has_value() && settingsOpen && tab == 0, "isolated settings page");
+        SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+        SDL_VirtualJoystickDesc desc{}; SDL_INIT_INTERFACE(&desc);
+        desc.type = SDL_JOYSTICK_TYPE_GAMEPAD; desc.vendor_id = 0x054c; desc.product_id = 0x0ce6;
+        desc.naxes = SDL_GAMEPAD_AXIS_COUNT; desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+        desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1;
+        desc.button_mask = (1u << SDL_GAMEPAD_BUTTON_COUNT) - 1; desc.name = "Launcher nav probe";
+        id = SDL_AttachVirtualJoystick(&desc);
+        joystick = SDL_OpenJoystick(id);
+        require(joystick != nullptr, "attach virtual pad");
+    }
+    if (frame == 20 || frame == 30) button(SDL_GAMEPAD_BUTTON_DPAD_DOWN, true);
+    if (frame == 24 || frame == 34) button(SDL_GAMEPAD_BUTTON_DPAD_DOWN, false);
+    if (frame == 44) {
+        require(row == 2, "down moves one row per press");
+        start = option(0, 2).value; choices = int(option(0, 2).choices.size());
+        button(SDL_GAMEPAD_BUTTON_DPAD_RIGHT, true);
+    }
+    if (frame == 48) button(SDL_GAMEPAD_BUTTON_DPAD_RIGHT, false);
+    if (frame == 56) {
+        require(option(0, 2).value == (start + 1) % choices, "right changes the selected row");
+        button(SDL_GAMEPAD_BUTTON_SOUTH, true);
+    }
+    if (frame == 104) {
+        require(option(0, 2).value == (start + 2) % choices, "held Cross changes once");
+        button(SDL_GAMEPAD_BUTTON_SOUTH, false);
+    }
+    if (frame == 110) button(SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, true);
+    if (frame == 114) button(SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, false);
+    if (frame == 124) {
+        require(settingsOpen && tab == 1 && row == 0, "R1 moves to the next tab");
+        SDL_CloseJoystick(joystick); SDL_DetachVirtualJoystick(id);
+        std::fprintf(stderr, "launcher-nav COMPLETE\n"); std::fflush(stderr);
+        return true;
+    }
+    ++frame;
+    return false;
+};
diff --git a/runtime/tests/stick_response_tests.cpp b/runtime/tests/stick_response_tests.cpp
new file mode 100644
index 0000000..6f43734
--- /dev/null
+++ b/runtime/tests/stick_response_tests.cpp
@@ -0,0 +1,30 @@
+#include "../../aurora-main/include/dolphin/stick_response.hpp"
+#include <cstdlib>
+#include <cmath>
+#include <initializer_list>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    using aurora::pad::ShapeStick;
+    auto center = ShapeStick(1800, 1200, 3000, true, 1.0f);
+    require(center.x == 0 && center.y == 0);
+    auto edge = ShapeStick(3001, 0, 3000, true, 1.0f);
+    require(edge.x == 0 && edge.y == 0);
+    for (float sensitivity : {0.5f, 1.0f, 2.0f}) {
+        require(ShapeStick(32767, 0, 3000, true, sensitivity).x == 127);
+        require(ShapeStick(-32768, 0, 3000, true, sensitivity).x == -127);
+    }
+    auto fine = ShapeStick(16000, 0, 3000, true, 0.5f);
+    auto normal = ShapeStick(16000, 0, 3000, true, 1.0f);
+    auto fast = ShapeStick(16000, 0, 3000, true, 2.0f);
+    require(fine.x < normal.x && normal.x < fast.x);
+    auto diagonal = ShapeStick(23170, 23170, 3000, true, 1.0f);
+    require(diagonal.x == diagonal.y && diagonal.x == 90);
+    int previous = 0;
+    for (int raw = 3000; raw <= 32767; ++raw) {
+        auto next = ShapeStick(raw, 0, 3000, true, 1.5f);
+        require(next.x >= previous && next.x - previous <= 1);
+        previous = next.x;
+    }
+    require(ShapeStick(1000, 0, 3000, false, 1.0f).x > 0);
+    require(ShapeStick(16000, 0, 3000, true, NAN).x == normal.x);
+}
