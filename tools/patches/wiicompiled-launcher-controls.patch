new file mode 100644
index 0000000..7f4717d
--- /dev/null
+++ b/runtime/include/launcher_visuals.h
@@ -0,0 +1,35 @@
+#pragma once
+#include "power_pros_ui.h"
+#include <string>
+namespace launcher_visuals {
+// Keep native focus/activation while drawing the launcher's original glossy
+// blue/orange pills over ImGui's button geometry.
+inline bool PillButton(const char* label, ImVec2 size = ImVec2(0,0), bool selected = false) {
+    // Only the pill is visible; ImGui's rectangular frame would show around its rounded ends.
+    ImGui::PushStyleColor(ImGuiCol_Button,IM_COL32(0,0,0,0));
+    ImGui::PushStyleColor(ImGuiCol_ButtonHovered,IM_COL32(0,0,0,0));
+    ImGui::PushStyleColor(ImGuiCol_ButtonActive,IM_COL32(0,0,0,0));
+    const bool pressed = ImGui::Button(label,size);
+    ImGui::PopStyleColor(3);
+    ImVec2 a=ImGui::GetItemRectMin(), b=ImGui::GetItemRectMax();
+    const bool highlight=selected || ImGui::IsItemHovered() || (ImGui::IsItemFocused() && ImGui::GetIO().NavVisible);
+    const float u=ImGui::GetFontSize()/24.f;
+    // The rim reaches 4u outside the button: keep it inside the container
+    // horizontally so full-width pills are not cut at the edge.
+    const float rim=4*u+2;
+    a.x=std::max(a.x,ImGui::GetWindowDrawList()->GetClipRectMin().x+rim);
+    b.x=std::min(b.x,ImGui::GetWindowDrawList()->GetClipRectMax().x-rim);
+    power_pros_ui::Pill(ImGui::GetWindowDrawList(),a,b,
+        highlight ? IM_COL32(255,200,90,255) : IM_COL32(45,111,212,255),
+        highlight ? IM_COL32(242,118,18,255) : IM_COL32(10,45,138,255),u);
+    const char* end=ImGui::FindRenderedTextEnd(label);
+    std::string text(label,end);
+    const float fs=ImGui::GetFontSize();
+    const auto ts=power_pros_ui::TextSize(power_pros_ui::g_bold,fs,text.c_str());
+    ImGui::GetWindowDrawList()->PushClipRect(a,b,true);
+    power_pros_ui::ShadowedText(ImGui::GetWindowDrawList(),power_pros_ui::g_bold,fs,
+        ImVec2(a.x+(b.x-a.x-ts.x)*.5f,a.y+(b.y-a.y-ts.y)*.5f),IM_COL32_WHITE,text.c_str());
+    ImGui::GetWindowDrawList()->PopClipRect();
+    return pressed;
+}
+}
