+    ImGui::TextDisabled("Clic o %s en una asignación y pulsa la nueva entrada · Esc cancela · clic derecho quita", AcceptPrompt());
+    if (!notice.empty()) ImGui::TextColored(ImVec4(.6f, 1, .7f, 1), "%s", notice.c_str());
+    ImGui::PopTextWrapPos();
+
+    uint32_t count = 0, axisCount = 0;
+    auto* mappings = keyboard ? nullptr : PADGetButtonMappings(port, &count);
+    auto* keys = keyboard ? PADGetKeyButtonBindings(port, &count) : nullptr;
+    auto* axes = keyboard ? nullptr : PADGetAxisMappings(port, &axisCount);
+    auto* keyAxes = keyboard ? PADGetKeyAxisBindings(port, &axisCount) : nullptr;
+    auto* dead = keyboard ? nullptr : PADGetDeadZones(port);
+    auto* response = PADGetStickResponse(port);
+    if (!mappings && !keys) {
+        ImGui::TextWrapped("Este jugador no tiene mando. Elige uno en Dispositivo o usa Teclado y ratón.");
