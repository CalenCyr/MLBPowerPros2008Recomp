+                    for (int i = 0; i < PAD_BUTTON_COUNT; ++i)
+                        for (uint32_t j = 0; j < count; ++j)
+                            if (mappings[j].padButton == ControllerNames::kGameCubeButtons[i].padButton) PersistButton(port, i, mappings[j].nativeButton);
