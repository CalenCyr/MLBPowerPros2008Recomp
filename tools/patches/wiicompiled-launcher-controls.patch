+void HandleEvents(const AuroraEvent* events) {
+    LoadPromptStyle();
+    // Test runners are background processes on Windows. Only the opt-in
+    // portable virtual-device probe may exercise the event path without focus.
+    static const bool probeInput = [] {
+        const char* value = std::getenv("WIICOMPILED_LAUNCHER_PROBE");
+        return value && std::string(value) == "1" && RuntimeConfigFile::PortableRootDirectory().has_value();
+    }();
+    if (!events) return;
+    for (auto* ev = events; ev->type != AURORA_NONE; ++ev) {
+        if (ev->type == AURORA_CONTROLLER_ADDED || ev->type == AURORA_CONTROLLER_REMOVED)
+            settings_overlay::PrepareLauncherControllers(true);
+        if (ev->type == AURORA_SDL_EVENT) controller_mapping_wizard::HandleSdlEvent(ev->sdl);
+        if (ev->type != AURORA_SDL_EVENT || (SDL_GetKeyboardFocus() == nullptr && !probeInput)) continue;
+        const auto& e = ev->sdl;
+        if (e.type == SDL_EVENT_KEY_DOWN || e.type == SDL_EVENT_MOUSE_BUTTON_DOWN) gamepad = false;
+        if (e.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN ||
+            (e.type == SDL_EVENT_GAMEPAD_AXIS_MOTION && std::abs(int(e.gaxis.value)) > 16000)) {
+            gamepad = true;
+            lastPad = e.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN ? e.gbutton.which : e.gaxis.which;
+        }
+        if (capture.kind == CaptureKind::None) continue;
+        if (e.type == SDL_EVENT_KEY_DOWN && e.key.scancode == SDL_SCANCODE_ESCAPE) { Cancel(); continue; }
+        if (!capture.released) continue;
+        if ((capture.kind == CaptureKind::Key || capture.kind == CaptureKind::KeyAxis) &&
+            e.type == SDL_EVENT_KEY_DOWN && !e.key.repeat && e.key.scancode != SDL_SCANCODE_F10) Complete(e.key.scancode);
+        else if ((capture.kind == CaptureKind::Key || capture.kind == CaptureKind::KeyAxis) && e.type == SDL_EVENT_MOUSE_BUTTON_DOWN &&
+                 e.button.button > 0 && e.button.button <= 5 &&
+                 (e.button.x < captureRect.x || e.button.x >= captureRect.z || e.button.y < captureRect.y || e.button.y >= captureRect.w))
+            Complete(uint32_t(-int(e.button.button) - 1));
+        else if ((capture.kind == CaptureKind::Button || capture.kind == CaptureKind::Axis) &&
+                 e.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN && e.gbutton.which == capture.device)
+            Complete(e.gbutton.button);
+        else if ((capture.kind == CaptureKind::Button || capture.kind == CaptureKind::Axis) &&
+                 e.type == SDL_EVENT_GAMEPAD_AXIS_MOTION && e.gaxis.which == capture.device && std::abs(int(e.gaxis.value)) >= 16384)
+            Complete(PADEncodeAxisButton(e.gaxis.axis, e.gaxis.value < 0));
+    }
+}
+bool UsingGamepad() { return gamepad; }
+bool PlayStationPrompts() {
+    LoadPromptStyle();
+    if (promptStyle != 0) return promptStyle == 1;
+    auto* pad = SDL_GetGamepadFromID(lastPad);
+    const auto type = pad ? SDL_GetGamepadType(pad) : SDL_GAMEPAD_TYPE_UNKNOWN;
+    return type == SDL_GAMEPAD_TYPE_PS3 || type == SDL_GAMEPAD_TYPE_PS4 || type == SDL_GAMEPAD_TYPE_PS5;
+}
+const char* AcceptPrompt() { return !gamepad ? "Enter" : PlayStationPrompts() ? "Cruz" : "A"; }
+const char* BackPrompt() { return !gamepad ? "Esc" : PlayStationPrompts() ? "Círculo" : "B"; }
+const char* TabPrompt() { return !gamepad ? "Q / E" : PlayStationPrompts() ? "L1 / R1" : "LB / RB"; }
+const char* DeviceLabel() { return !gamepad ? "Teclado / ratón" : PlayStationPrompts() ? "Mando PlayStation" : "Mando"; }
+bool Capturing() { return capture.kind != CaptureKind::None || testing || captureGraceFrames > 0 || waitForRelease; }
