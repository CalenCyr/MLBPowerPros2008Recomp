+std::filesystem::path PromptPath() { return RuntimeConfigFile::ResolveConfigPath().parent_path() / "launcher_prompts.txt"; }
+void LoadPromptStyle() {
+    static bool loaded = false;
+    if (loaded) return;
+    loaded = true;
+    int value = 1;
+    if (std::ifstream(PromptPath()) >> value; value >= 0 && value <= 2) promptStyle = value;
+}
+enum class CaptureKind { None, Button, Key, KeyAxis, Axis };
+struct Capture {
+    CaptureKind kind = CaptureKind::None;
+    int row = 0;
+    uint32_t port = 0;
+    SDL_JoystickID device = 0;
+    bool released = false;
+    double deadline = 0;
+} capture;
+
+// Short names in the chosen prompt family; the persisted config keeps positional names.
+std::string NativeName(uint32_t value, PADButton action = 0) {
+    if (value == PAD_NATIVE_BUTTON_DISABLED) return "Sin asignar";
+    const bool ps = PlayStationPrompts();
+    if (value == PAD_NATIVE_BUTTON_INVALID) {
+        if (action == PAD_TRIGGER_L) return ps ? "L2 (predeterminado)" : "LT (predeterminado)";
+        if (action == PAD_TRIGGER_R) return ps ? "R2 (predeterminado)" : "RT (predeterminado)";
+        return "Predeterminado";
+    }
+    if (PADIsAxisButton(value)) {
+        const bool negative = PADAxisButtonNegative(value);
+        switch (PADAxisButtonAxis(value)) {
+        case SDL_GAMEPAD_AXIS_LEFT_TRIGGER: return ps ? "L2" : "LT";
+        case SDL_GAMEPAD_AXIS_RIGHT_TRIGGER: return ps ? "R2" : "RT";
+        case SDL_GAMEPAD_AXIS_LEFTX: return negative ? "Stick izq. izquierda" : "Stick izq. derecha";
+        case SDL_GAMEPAD_AXIS_LEFTY: return negative ? "Stick izq. arriba" : "Stick izq. abajo";
+        case SDL_GAMEPAD_AXIS_RIGHTX: return negative ? "Stick der. izquierda" : "Stick der. derecha";
+        case SDL_GAMEPAD_AXIS_RIGHTY: return negative ? "Stick der. arriba" : "Stick der. abajo";
+        default: break;
+        }
+    }
+    switch (value) {
+    case SDL_GAMEPAD_BUTTON_SOUTH: return ps ? "Cruz" : "A";
+    case SDL_GAMEPAD_BUTTON_EAST: return ps ? "Círculo" : "B";
+    case SDL_GAMEPAD_BUTTON_WEST: return ps ? "Cuadrado" : "X";
+    case SDL_GAMEPAD_BUTTON_NORTH: return ps ? "Triángulo" : "Y";
+    case SDL_GAMEPAD_BUTTON_START: return ps ? "OPTIONS" : "Menú";
+    case SDL_GAMEPAD_BUTTON_BACK: return ps ? "SHARE / CREATE" : "Vista";
+    case SDL_GAMEPAD_BUTTON_GUIDE: return ps ? "PS" : "Guía";
+    case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER: return ps ? "L1" : "LB";
+    case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER: return ps ? "R1" : "RB";
+    case SDL_GAMEPAD_BUTTON_LEFT_STICK: return ps ? "L3" : "LS";
+    case SDL_GAMEPAD_BUTTON_RIGHT_STICK: return ps ? "R3" : "RS";
+    case SDL_GAMEPAD_BUTTON_DPAD_UP: return "Cruceta arriba";
+    case SDL_GAMEPAD_BUTTON_DPAD_DOWN: return "Cruceta abajo";
+    case SDL_GAMEPAD_BUTTON_DPAD_LEFT: return "Cruceta izquierda";
+    case SDL_GAMEPAD_BUTTON_DPAD_RIGHT: return "Cruceta derecha";
+    case SDL_GAMEPAD_BUTTON_TOUCHPAD: return "Panel táctil";
+    default: return ControllerNames::NativeButtonForValue(value).label;
+    }
+}
+std::string AxisName(const PADAxisMapping& m) {
+    if (m.nativeAxis.nativeAxis >= 0)
+        return NativeName(PADEncodeAxisButton(uint32_t(m.nativeAxis.nativeAxis), m.nativeAxis.sign == AXIS_SIGN_NEGATIVE));
+    return m.nativeButton < 0 ? "Sin asignar" : NativeName(uint32_t(m.nativeButton));
+}
+std::string KeyName(int value) {
+    if (value == PAD_KEY_INVALID) return "Sin asignar";
+    if (value < -1) return "Ratón " + std::to_string(-value - 1);
+    const char* name = value < SDL_SCANCODE_COUNT ? SDL_GetScancodeName(SDL_Scancode(value)) : "";
+    return name && *name ? name : "Sin asignar";
+}
+void PersistButton(uint32_t selectedPort, int row, uint32_t value) {
+    const auto& action = ControllerNames::kGameCubeButtons[row];
+    PADSetButtonMapping(selectedPort, {value, action.padButton});
+    // Keep existing secondary mappings when editing the primary one.
+    const auto configName = [](uint32_t native) {
+        std::string name = ControllerNames::NativeButtonForValue(native).configName;
+        if (PADIsAxisButton(native) && PADAxisButtonThreshold(native) != 50)
+            name += "@" + std::to_string(PADAxisButtonThreshold(native));
+        return name;
+    };
+    std::string config = configName(value);
+    uint32_t count = 0;
+    if (auto* alt = PADGetAltButtonMappings(selectedPort, &count))
+        for (uint32_t i = 0; i < count; ++i)
+            if (alt[i].padButton == action.padButton && alt[i].nativeButton != PAD_NATIVE_BUTTON_INVALID)
+                config += std::string(",") + configName(alt[i].nativeButton);
+    RuntimeConfigFile::SetControllerButton(row, config);
+}
+void Complete(uint32_t value) {
+    const auto c = capture;
+    capture = {};
+    captureGraceFrames = 2;
+    waitForRelease = true;
+    uint32_t count = 0;
+    if (c.kind == CaptureKind::Button) {
+        auto* mappings = PADGetButtonMappings(c.port, &count);
+        if (!mappings || count != PAD_BUTTON_COUNT) return;
+        uint32_t previous = PAD_NATIVE_BUTTON_DISABLED;
+        for (uint32_t i = 0; i < count; ++i)
+            if (mappings[i].padButton == ControllerNames::kGameCubeButtons[c.row].padButton) previous = mappings[i].nativeButton;
+        notice = "Botón guardado.";
+        if (value != PAD_NATIVE_BUTTON_DISABLED)
+            for (int i = 0; i < PAD_BUTTON_COUNT; ++i) {
+                if (i == c.row) continue;
+                for (uint32_t j = 0; j < count; ++j)
+                    if (mappings[j].padButton == ControllerNames::kGameCubeButtons[i].padButton &&
+                        PADAxisButtonIdentity(mappings[j].nativeButton) == PADAxisButtonIdentity(value)) {
+                        PersistButton(c.port, i, previous);
+                        notice = "Se intercambiaron los botones para evitar duplicados.";
+                    }
+            }
+        PersistButton(c.port, c.row, value);
+    } else if (c.kind == CaptureKind::Key) {
+        auto* keys = PADGetKeyButtonBindings(c.port, &count);
+        const auto target = ControllerNames::kGameCubeButtons[c.row].padButton;
+        int previous = PAD_KEY_INVALID;
+        for (uint32_t i = 0; keys && i < count; ++i) if (keys[i].padButton == target) previous = keys[i].scancode;
+        for (uint32_t i = 0; keys && i < count; ++i)
+            if (int(value) != PAD_KEY_INVALID && keys[i].padButton != target && keys[i].scancode == int(value))
+                PADSetKeyButtonBinding(c.port, {previous, keys[i].padButton});
+        PADSetKeyButtonBinding(c.port, {int(value), target});
+        notice = "Tecla guardada; los duplicados se intercambian.";
+    } else if (c.kind == CaptureKind::KeyAxis) {
+        PADSetKeyAxisBinding(c.port, {int(value), uint16_t(c.row), 1});
+        notice = "Dirección guardada.";
+    } else if (c.kind == CaptureKind::Axis) {
+        // Like Dolphin, a stick direction or analog trigger may also come from a plain button.
+        if (PADIsAxisButton(value))
+            PADSetAxisMapping(c.port, {{int(PADAxisButtonAxis(value)), PADAxisButtonNegative(value) ? AXIS_SIGN_NEGATIVE : AXIS_SIGN_POSITIVE},
+                                      int(PAD_NATIVE_BUTTON_INVALID), uint16_t(c.row)});
+        else
+            PADSetAxisMapping(c.port, {{-1, AXIS_SIGN_POSITIVE}, int(value), uint16_t(c.row)});
+        notice = "Dirección guardada.";
+    }
+    PADSerializeMappings();
+}
+void Begin(CaptureKind kind, int row) {
+    capture = {kind, row, uint32_t(port), 0, false, ImGui::GetTime() + 8};
+    int index = PADGetIndexForPort(port);
+    if (auto* pad = index >= 0 ? PADGetSDLGamepadForIndex(index) : nullptr) capture.device = SDL_GetGamepadID(pad);
+}
+// Cancelling also waits for release, so the Esc/Circle that cancelled does not reach the menu.
+void Cancel() { capture = {}; waitForRelease = true; captureGraceFrames = 2; }
+bool Neutral(SDL_Gamepad* pad) {
+    bool neutral = SDL_GetMouseState(nullptr, nullptr) == 0;
+    const bool* keys = SDL_GetKeyboardState(nullptr);
+    for (int i = 0; i < SDL_SCANCODE_COUNT; ++i) neutral &= !keys[i];
+    if (pad) {
+        for (int i = 0; i < SDL_GAMEPAD_BUTTON_COUNT; ++i) neutral &= !SDL_GetGamepadButton(pad, SDL_GamepadButton(i));
+        for (int i = 0; i < SDL_GAMEPAD_AXIS_COUNT; ++i) neutral &= std::abs(int(SDL_GetGamepadAxis(pad, SDL_GamepadAxis(i)))) < 8000;
+    }
+    return neutral;
+}
+void UpdateCapture() {
+    if (captureGraceFrames > 0) --captureGraceFrames;
+    const int index = PADGetIndexForPort(port);
+    if (waitForRelease && Neutral(index >= 0 ? PADGetSDLGamepadForIndex(index) : nullptr)) waitForRelease = false;
+    if (capture.kind == CaptureKind::None) return;
+    if (ImGui::GetTime() > capture.deadline) { Cancel(); notice = "Tiempo agotado; se conserva la asignación."; return; }
+    auto* pad = SDL_GetGamepadFromID(capture.device);
+    if (!pad && (capture.kind == CaptureKind::Button || capture.kind == CaptureKind::Axis)) {
+        Cancel(); notice = "El mando se desconectó. Vuelve a conectarlo."; return;
+    }
+    // Only accept input after the press that started the capture is released.
+    if (Neutral(pad)) capture.released = true;
+}
+// One Dolphin-style row: the GameCube input, then what drives it. Click to
+// capture in place, click again or Esc to cancel, right click to clear.
+void BindingRow(const char* label, CaptureKind kind, int row, const std::string& bound, ImVec4* rect) {
+    ImGui::PushID(int(kind) * 64 + row);
+    ImGui::AlignTextToFramePadding();
+    ImGui::TextUnformatted(label);
+    ImGui::SameLine(ImGui::GetFontSize() * 5.6f);
+    const bool active = capture.kind == kind && capture.row == row;
+    const std::string text = !active ? bound
+        : std::string(capture.released ? "Pulsa la entrada... " : "Suelta... ") +
+              std::to_string(int(std::ceil(std::max(0.0, capture.deadline - ImGui::GetTime()))));
+    if (active) ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(.78f, .40f, .08f, 1));
+    if (ImGui::Button((text + "###b").c_str(), ImVec2(-FLT_MIN, 0))) {
+        if (active) Cancel();
+        else Begin(kind, row);
+    }
+    if (active) ImGui::PopStyleColor();
+    const ImVec2 a = ImGui::GetItemRectMin(), b = ImGui::GetItemRectMax();
+    if (active) captureRect = {a.x, a.y, b.x, b.y};
+    if (rect) *rect = {a.x, a.y, b.x, b.y};
+    // Axes cannot be left without a source; buttons and keys can.
+    if (!active && kind != CaptureKind::Axis && ImGui::IsItemClicked(ImGuiMouseButton_Right)) {
+        Begin(kind, row);
+        Complete(kind == CaptureKind::Button ? PAD_NATIVE_BUTTON_DISABLED : uint32_t(PAD_KEY_INVALID));
+    }
+    ImGui::SetItemTooltip(kind == CaptureKind::Axis ? "Clic: asignar" : "Clic: asignar · Clic derecho: quitar");
+    ImGui::PopID();
+}
+// GameCube-style octagonal gate with the dead zone and the signal MLB receives.
+void DrawGate(const PADStatus& status, bool sub, float deadZone) {
+    const float width = ImGui::GetContentRegionAvail().x;
+    const float size = std::min(width, ImGui::GetFontSize() * 6);
+    const ImVec2 p = ImGui::GetCursorScreenPos();
+    const ImVec2 c(p.x + width * .5f, p.y + size * .5f);
+    ImGui::Dummy(ImVec2(width, size));
+    auto* dl = ImGui::GetWindowDrawList();
+    const float r = size * .46f;
+    std::array<ImVec2, 8> gate;
+    for (int i = 0; i < 8; ++i) gate[i] = ImVec2(c.x + std::cos(i * IM_PI / 4) * r, c.y + std::sin(i * IM_PI / 4) * r);
+    dl->AddConvexPolyFilled(gate.data(), 8, IM_COL32(8, 24, 48, 255));
+    dl->AddPolyline(gate.data(), 8, IM_COL32(170, 210, 250, 255), ImDrawFlags_Closed, 2);
+    dl->AddLine(ImVec2(c.x - r, c.y), ImVec2(c.x + r, c.y), IM_COL32(80, 108, 135, 160));
+    dl->AddLine(ImVec2(c.x, c.y - r), ImVec2(c.x, c.y + r), IM_COL32(80, 108, 135, 160));
+    if (deadZone > 0) dl->AddCircle(c, r * deadZone, IM_COL32(255, 120, 90, 200), 32, 1.5f);
+    // Same integer hardware-gate conversion as the MLB PAD HLE, then MLB's
+    // 88/64 normalization. This is the actual input signal, not a second curve.
+    const int x = int(sub ? status.substickX : status.stickX) * (sub ? 74 : 87) / 127;
+    const int y = int(sub ? status.substickY : status.stickY) * (sub ? 74 : 87) / 127;
+    const float divisor = sub ? 64.f : 88.f;
+    const ImVec2 aim(c.x + std::clamp(x / divisor, -1.f, 1.f) * r, c.y - std::clamp(y / divisor, -1.f, 1.f) * r);
+    dl->AddCircleFilled(aim, std::max(3.f, size * .045f), IM_COL32(255, 210, 90, 255));
+    ImGui::TextDisabled("Señal del juego: X %d  Y %d", x, y);
+}
+// Groups flow into as many columns as fit, top to bottom, like Dolphin's dialog.
+template <typename F> void Group(const char* title, F&& body) {
+    ImGui::BeginChild(title, ImVec2(0, 0), ImGuiChildFlags_Borders | ImGuiChildFlags_AutoResizeY | ImGuiChildFlags_NavFlattened);
+    ImGui::TextColored(ImVec4(1, .79f, .35f, 1), "%s", title);
+    ImGui::Separator();
+    body();
+    ImGui::EndChild();
+}
