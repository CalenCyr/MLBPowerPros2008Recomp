+                ImGui::TextDisabled("%s", selected.restart ? "Se aplica al iniciar el juego." : "Se aplica al momento.");
+            }
+            if (current.footer) { ImGui::Spacing(); ImGui::TextUnformatted(current.footer); }
+            ImGui::PopTextWrapPos(); ImGui::EndChild();
+        }
+        if (!wide && count) {
+            // Compact windows keep the explanation reachable by keyboard/pad.
+            if (launcher_visuals::PillButton("Información del ajuste")) ImGui::OpenPopup("Información");
+            ImGui::SetNextWindowSize(ImVec2(std::min(520.f, w - 50), std::min(420.f, h - 80)), ImGuiCond_Appearing);
+            ImGui::SetNextWindowPos(ImGui::GetMainViewport()->GetCenter(), ImGuiCond_Appearing, ImVec2(.5f, .5f));
+            if (ImGui::BeginPopupModal("Información", nullptr, ImGuiWindowFlags_NoResize)) {
+                ImGui::BeginChild("Texto", ImVec2(0, -ImGui::GetFrameHeightWithSpacing()));
+                ImGui::PushTextWrapPos(0);
+                ImGui::TextUnformatted(current.options[row].help);
+                ImGui::PopTextWrapPos(); ImGui::EndChild();
+                if (launcher_visuals::PillButton("Cerrar") || ImGui::IsKeyPressed(ImGuiKey_Escape, false) ||
+                    ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight, false) || ImGui::IsKeyPressed(ImGuiKey_GamepadFaceUp, false))
+                    ImGui::CloseCurrentPopup();
+                ImGui::EndPopup();
+            }
+        }
+        // Pad/keyboard: up/down choose the row, left/right or Cross change it. The page follows the row.
+        if (!ImGui::IsPopupOpen(nullptr, ImGuiPopupFlags_AnyPopupId) && !popupProtected && count) {
+            if (Up()) row = std::max(0, row - 1);
+            if (Down()) row = std::min(count - 1, row + 1);
+            if (Left()) change(tab, row, -1);
+            if (Right() || Accept()) change(tab, row, 1);
+            if (!wide && Pressed({SDL_SCANCODE_I}, {ImGuiKey_GamepadFaceUp})) ImGui::OpenPopup("Información");
+        }
+        if (!ImGui::IsPopupOpen(nullptr, ImGuiPopupFlags_AnyPopupId)) {
+            if (KeyPressed(SDL_SCANCODE_PAGEUP) || ImGui::IsKeyPressed(ImGuiKey_GamepadL2)) row = std::max(0, scroll - pageRows);
+            if (KeyPressed(SDL_SCANCODE_PAGEDOWN) || ImGui::IsKeyPressed(ImGuiKey_GamepadR2)) row = std::min(std::max(0, count - 1), scroll + pageRows);
+        }
+    }
+    ImGui::Separator();
+    if (launcher_visuals::PillButton("Volver")) settingsOpen = false;
+    ImGui::SameLine();
+    const bool wideList = available >= 800 * scale;
+    if (tab == 2)
+        ImGui::TextWrapped("Cruceta: moverse · %s: asignar · %s: pestaña · %s: volver", launcher_controls::AcceptPrompt(),
+                           launcher_controls::TabPrompt(), launcher_controls::BackPrompt());
+    else
+        ImGui::TextWrapped("Arriba/abajo: elegir · Izquierda/derecha o %s: cambiar · %s: pestaña · %s: volver%s",
+                           launcher_controls::AcceptPrompt(), launcher_controls::TabPrompt(), launcher_controls::BackPrompt(),
+                           wideList ? "" : launcher_controls::UsingGamepad() ? (launcher_controls::PlayStationPrompts() ? " · Triángulo: info" : " · Y: info") : " · I: info");
+    const bool popupNow = ImGui::IsPopupOpen(nullptr, ImGuiPopupFlags_AnyPopupId);
+    if (!controlsBusy && !popupProtected && !popupNow) {
+        if (Pressed({SDL_SCANCODE_Q}, {ImGuiKey_GamepadL1})) { tab = firstTab+(tab-firstTab+tabCount-1)%tabCount; row = 0; }
+        if (Pressed({SDL_SCANCODE_E}, {ImGuiKey_GamepadR1})) { tab = firstTab+(tab-firstTab+1)%tabCount; row = 0; }
+        if (Back()) settingsOpen = false;
+    }
+    popupLastFrame = popupNow;
+    ImGui::End();
+    ImGui::PopFont(); ImGui::PopStyleColor(12); ImGui::PopStyleVar(7);
+};
+drawSettings();
