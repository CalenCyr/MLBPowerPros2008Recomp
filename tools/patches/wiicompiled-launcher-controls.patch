@@ -0,0 +1,20 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+namespace aurora::pad {
+struct Stick { std::int8_t x{}, y{}; };
+// Shared by PADRead and the controller lab. Sensitivity changes the response
+// curve while preserving center, direction and full travel.
+inline Stick ShapeStick(int x, int y, int deadZone, bool enabled, float sensitivity) {
+    const double magnitude = std::hypot(double(x), double(y));
+    const double zone = enabled ? std::clamp(deadZone, 0, 32000) : 0;
+    if (magnitude <= zone) return {};
+    if (!std::isfinite(sensitivity)) sensitivity = 1.0f;
+    sensitivity = std::clamp(sensitivity, 0.5f, 2.0f);
+    const double travel = std::clamp((magnitude - zone) / (32767.0 - zone), 0.0, 1.0);
+    const double scale = std::pow(travel, 1.0 / sensitivity) * 127.0 / magnitude;
+    return {static_cast<std::int8_t>(std::clamp(int(std::lround(x * scale)), -127, 127)),
+            static_cast<std::int8_t>(std::clamp(int(std::lround(y * scale)), -127, 127))};
+}
+}
