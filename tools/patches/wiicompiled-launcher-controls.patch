+                    if (p == currentPage) ImGui::PopStyleColor();
+                }
+            }
+        } else ImGui::TextDisabled("%d ajustes", count);
+        ImGui::EndChild();
+        if (wide) {
+            ImGui::SameLine();
+            ImGui::BeginChild("Ayuda", ImVec2(0, height), ImGuiChildFlags_Borders, listNav);
+            ImGui::PushTextWrapPos(0);
