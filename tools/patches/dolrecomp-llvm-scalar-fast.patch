+/* Scalar fadds/fmuls/fsubs chain: inline fast path plus helper path on NaN.
+ * The inline path follows the RecompCore/Dolphin helpers, which do not model
+ * inexact results; dr_cpu tracks XX/FI/FR (and FX from XX); those are masked. */
+#define SCALAR_FPSCR_MASK (~0x82060000u)
+static int check_scalar(CPUState *generated, CPUState *reference,
+                        const u64 values[10], u32 fpscr, u32 iteration) {
+  static const u8 inputs[] = {2, 3, 5, 7, 9};
+  static const u8 outputs[] = {1, 4, 6, 8};
+  for (u32 i = 0; i < 5; i++) {
+    set_pair(generated, inputs[i], values[i * 2], values[i * 2 + 1]);
+    set_pair(reference, inputs[i], values[i * 2], values[i * 2 + 1]);
+  }
+  for (u32 i = 0; i < 4; i++) {
+    set_pair(generated, outputs[i], values[i], values[9 - i]);
+    set_pair(reference, outputs[i], values[i], values[9 - i]);
+  }
+  prepare(generated, 0x80003E00u, fpscr);
+  func_80003E00(generated);
+  prepare(reference, 0x80003E00u, fpscr);
+  ppc_fadds(reference, 1, 2, 3);
+  ppc_fmuls(reference, 4, 1, 5);
+  ppc_fsubs(reference, 6, 4, 7);
+  ppc_fmuls(reference, 8, 6, 9);
+  for (u32 i = 0; i < 4; i++) {
+    if (!same_pair(generated, reference, outputs[i]) ||
+        (generated->fpscr & SCALAR_FPSCR_MASK) !=
+            (reference->fpscr & SCALAR_FPSCR_MASK)) {
+      fprintf(stderr,
+              "scalar mismatch iteration=%u fpscr=0x%08X f%u "
+              "generated=%016llX/%016llX reference=%016llX/%016llX "
+              "fpscr generated=%08X reference=%08X\n",
+              iteration, fpscr, outputs[i],
+              (unsigned long long)to_bits(generated->fpr[outputs[i]]),
+              (unsigned long long)to_bits(generated->ps1[outputs[i]]),
+              (unsigned long long)to_bits(reference->fpr[outputs[i]]),
+              (unsigned long long)to_bits(reference->ps1[outputs[i]]),
+              generated->fpscr, reference->fpscr);
+      return 0;
+    }
+  }
+  return 1;
+}
