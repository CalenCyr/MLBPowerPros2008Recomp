diff --git a/runtime/include/power_pros_ui.h b/runtime/include/power_pros_ui.h
index 0fb9d28..242e2cc 100644
--- a/runtime/include/power_pros_ui.h
+++ b/runtime/include/power_pros_ui.h
@@ -12,9 +12,49 @@
 #include <initializer_list>
 #include <iterator>
 #include <vector>
+#include <cstdlib>
+#include <string_view>
+
+#if defined(_WIN32)
+extern "C" __declspec(dllimport) unsigned short __stdcall GetUserDefaultUILanguage(void);
+#endif
 
 namespace power_pros_ui {
 
+// ---- Language ----------------------------------------------------------------------------------
+// Spanish or English. Config.toml [ui] language = "es" / "en"; "auto" (or nothing) follows the
+// system's language: Spanish when it is Spanish, English otherwise.
+enum class Lang { Es, En };
+
+inline Lang SystemLang() {
+#if defined(_WIN32)
+    return (GetUserDefaultUILanguage() & 0x3FF) == 0x0A ? Lang::Es : Lang::En;   // PRIMARYLANGID == LANG_SPANISH
+#else
+    const char* l = std::getenv("LANG");
+    return l && l[0] == 'e' && l[1] == 's' ? Lang::Es : Lang::En;
+#endif
+}
+
+inline Lang LangFromSetting(std::string_view value) {
+    if (value == "es") return Lang::Es;
+    if (value == "en") return Lang::En;
+    return SystemLang();
+}
+
+inline Lang g_lang = SystemLang();
+
+// The text in the current language. Literals only: both stay valid for the whole program.
+inline const char* Tr(const char* es, const char* en) { return g_lang == Lang::En ? en : es; }
+
+// A text in both languages that reads as the current one wherever a const char* is expected
+// (constants, option labels).
+struct Phrase {
+    const char* es;
+    const char* en;
+    const char* get() const { return Tr(es, en); }
+    operator const char*() const { return get(); }
+};
+
 // ---- Fonts -------------------------------------------------------------------------------------
 // System fonts only; ImGui's built-in font is the fallback. Baked large and drawn smaller.
 inline ImFont* g_text = nullptr;
