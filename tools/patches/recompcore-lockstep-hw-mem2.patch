+// ponytail: full MEM2 copy per native MMIO write; lockstep-only cost. MEM1 hardware writes are
+// not recorded (MEM1 compares only native-journaled offsets); add here if one shows up.
+void StaticRecompLockstepVerifier::BeginNativeHwWrite()
+{
+  const u8* exram = m_core.m_guest.exram;
+  if (exram)
+    m_ls_hw_scratch.assign(exram, exram + m_core.m_guest.exram_size);
+}
+
+void StaticRecompLockstepVerifier::EndNativeHwWrite()
+{
+  const u8* exram = m_core.m_guest.exram;
+  const size_t size = m_ls_hw_scratch.size();
+  if (!exram || size != m_core.m_guest.exram_size || m_journal.native_mmio.empty())
+    return;
+  constexpr size_t kPage = 4096;
+  std::vector<std::pair<u32, u8>> delta;
+  for (size_t page = 0; page < size; page += kPage)
+  {
+    const size_t len = size - page < kPage ? size - page : kPage;
+    if (std::memcmp(exram + page, m_ls_hw_scratch.data() + page, len) == 0)
+      continue;
+    for (size_t i = page; i < page + len; ++i)
+      if (exram[i] != m_ls_hw_scratch[i])
+        delta.emplace_back(static_cast<u32>(i), exram[i]);
+  }
+  if (delta.empty())
+    return;
+  ++m_ls_hw_mem2_writes;
+  m_ls_hw_mem2_bytes += delta.size();
+  if (m_ls_hw_mem2_writes <= 16)
+  {
+    const LsWrite& w = m_journal.native_mmio.back();
+    std::fprintf(stderr, "[lockstep] hw_mem2 write #%llu entry=0x%08X ea=0x%08X data=0x%08X size=%u bytes=%zu\n",
+                 (unsigned long long)m_ls_hw_mem2_writes, m_ls_entry, w.addr, w.data, (unsigned)w.size,
+                 delta.size());
+  }
+  m_journal.native_hw_mem2[m_journal.native_mmio.size() - 1] = std::move(delta);
+}
+
