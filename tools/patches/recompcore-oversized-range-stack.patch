--- a/Source/Core/Core/HW/Memmap.cpp
+++ b/Source/Core/Core/HW/Memmap.cpp
@@ -17,6 +17,10 @@
 #include <set>
 #include <span>
 #include <tuple>
+#ifdef _WIN32
+#include <cstdio>
+#include <windows.h>
+#endif
 
 #include "Common/ChunkFile.h"
 #include "Common/CommonTypes.h"
@@ -627,6 +631,17 @@
   if (span.size() < size)
   {
     // The start address is in a valid region, but the end address is beyond the end of that region.
+#ifdef _WIN32
+    {  // Caller stack for oversized ranges: the alert alone does not name the HLE path.
+      void* frames[32];
+      const unsigned short count = RtlCaptureStackBackTrace(0, 32, frames, nullptr);
+      std::fprintf(stderr, "[oversized-range] size=%zx address=%08x exe=%p\n", size, address,
+                   static_cast<void*>(GetModuleHandleW(nullptr)));
+      for (unsigned short i = 0; i < count; ++i)
+        std::fprintf(stderr, "[oversized-range] frame %u %p\n", i, frames[i]);
+      std::fflush(stderr);
+    }
+#endif
     PanicAlertFmt("Oversized range in GetPointerForRange. {:x} bytes at {:#010x}", size, address);
     return nullptr;
   }
