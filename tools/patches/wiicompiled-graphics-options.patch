diff --git a/aurora-main/lib/webgpu/fsr.cpp b/aurora-main/lib/webgpu/fsr.cpp
new file mode 100644
index 0000000..3e3fe2c
--- /dev/null
+++ b/aurora-main/lib/webgpu/fsr.cpp
@@ -0,0 +1,303 @@
+#include "fsr.hpp"
+
+#include <array>
+#include <cmath>
+
+// FSR 1 = EASU (edge-adaptive spatial upsampling: 12 taps, a direction and length estimated from
+// luma, a lanczos-like lobe stretched along the edge, then clamped to the nearest 2x2 to avoid
+// ringing) followed by RCAS (robust contrast-adaptive sharpening on a 5-tap cross, limited so it
+// never creates new peaks). Both work on the perceptual (gamma) values the XFB copy holds.
+namespace aurora::webgpu::fsr {
+namespace {
+
+constexpr char kShader[] = R"""(
+struct Params {
+    in_size: vec2<f32>,
+    out_size: vec2<f32>,
+    sharp: f32,
+    pad0: f32,
+    pad1: f32,
+    pad2: f32,
+};
+
+@group(0) @binding(0) var src_sampler: sampler;
+@group(0) @binding(1) var src: texture_2d<f32>;
+@group(1) @binding(0) var<uniform> p: Params;
+
+@vertex
+fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {
+    var pos = array<vec2<f32>, 3>(vec2(-1.0, 1.0), vec2(-1.0, -3.0), vec2(3.0, 1.0));
+    return vec4<f32>(pos[i], 0.0, 1.0);
+}
+
+fn tap(c: vec2<i32>) -> vec3<f32> {
+    let hi = vec2<i32>(p.in_size) - vec2<i32>(1);
+    return textureLoad(src, clamp(c, vec2<i32>(0), hi), 0).rgb;
+}
+
+fn luma(c: vec3<f32>) -> f32 {
+    return c.b * 0.5 + (c.r * 0.5 + c.g);
+}
+
+// Accumulates the direction and edge length seen from one of the four bilinear corners.
+fn set_f(dir: ptr<function, vec2<f32>>, len: ptr<function, f32>, w: f32,
+         la: f32, lb: f32, lc: f32, ld: f32, le: f32) {
+    let dc = ld - lc;
+    let cb = lc - lb;
+    var len_x = max(abs(dc), abs(cb));
+    len_x = select(1.0 / len_x, 0.0, len_x == 0.0);
+    let dir_x = ld - lb;
+    len_x = clamp(abs(dir_x) * len_x, 0.0, 1.0);
+    len_x = len_x * len_x;
+    let ec = le - lc;
+    let ca = lc - la;
+    var len_y = max(abs(ec), abs(ca));
+    len_y = select(1.0 / len_y, 0.0, len_y == 0.0);
+    let dir_y = le - la;
+    len_y = clamp(abs(dir_y) * len_y, 0.0, 1.0);
+    len_y = len_y * len_y;
+    *dir = *dir + vec2<f32>(dir_x, dir_y) * w;
+    *len = *len + (len_x + len_y) * w;
+}
+
+fn tap_w(acc_c: ptr<function, vec3<f32>>, acc_w: ptr<function, f32>, off: vec2<f32>, dir: vec2<f32>,
+         len2: vec2<f32>, lob: f32, clp: f32, c: vec3<f32>) {
+    var v = vec2<f32>(off.x * dir.x + off.y * dir.y, off.x * (-dir.y) + off.y * dir.x);
+    v = v * len2;
+    let d2 = min(v.x * v.x + v.y * v.y, clp);
+    var wb = 0.4 * d2 - 1.0;
+    var wa = lob * d2 - 1.0;
+    wb = wb * wb;
+    wa = wa * wa;
+    wb = 1.5625 * wb - 0.5625;
+    let w = wb * wa;
+    *acc_c = *acc_c + c * w;
+    *acc_w = *acc_w + w;
+}
+
+@fragment
+fn fs_easu(@builtin(position) frag: vec4<f32>) -> @location(0) vec4<f32> {
+    var pp = frag.xy * (p.in_size / p.out_size) - vec2<f32>(0.5);
+    let fp = floor(pp);
+    pp = pp - fp;
+    let f0 = vec2<i32>(fp);
+    let b = tap(f0 + vec2<i32>(0, -1));
+    let c = tap(f0 + vec2<i32>(1, -1));
+    let e = tap(f0 + vec2<i32>(-1, 0));
+    let f = tap(f0);
+    let g = tap(f0 + vec2<i32>(1, 0));
+    let h = tap(f0 + vec2<i32>(2, 0));
+    let i = tap(f0 + vec2<i32>(-1, 1));
+    let j = tap(f0 + vec2<i32>(0, 1));
+    let k = tap(f0 + vec2<i32>(1, 1));
+    let l = tap(f0 + vec2<i32>(2, 1));
+    let n = tap(f0 + vec2<i32>(0, 2));
+    let o = tap(f0 + vec2<i32>(1, 2));
+    let bl = luma(b); let cl = luma(c); let el = luma(e); let fl = luma(f);
+    let gl = luma(g); let hl = luma(h); let il = luma(i); let jl = luma(j);
+    let kl = luma(k); let ll = luma(l); let nl = luma(n); let ol = luma(o);
+
+    var dir = vec2<f32>(0.0);
+    var len = 0.0;
+    set_f(&dir, &len, (1.0 - pp.x) * (1.0 - pp.y), bl, el, fl, gl, jl);
+    set_f(&dir, &len, pp.x * (1.0 - pp.y), cl, fl, gl, hl, kl);
+    set_f(&dir, &len, (1.0 - pp.x) * pp.y, fl, il, jl, kl, nl);
+    set_f(&dir, &len, pp.x * pp.y, gl, jl, kl, ll, ol);
+
+    let dir2 = dir * dir;
+    var dir_r = dir2.x + dir2.y;
+    let zro = dir_r < (1.0 / 32768.0);
+    dir_r = select(inverseSqrt(dir_r), 1.0, zro);
+    dir.x = select(dir.x, 1.0, zro);
+    dir = dir * dir_r;
+    len = len * 0.5;
+    len = len * len;
+    let stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
+    let len2 = vec2<f32>(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+    let lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+    let clp = 1.0 / lob;
+
+    var acc_c = vec3<f32>(0.0);
+    var acc_w = 0.0;
+    tap_w(&acc_c, &acc_w, vec2<f32>(0.0, -1.0) - pp, dir, len2, lob, clp, b);
+    tap_w(&acc_c, &acc_w, vec2<f32>(1.0, -1.0) - pp, dir, len2, lob, clp, c);
+    tap_w(&acc_c, &acc_w, vec2<f32>(-1.0, 1.0) - pp, dir, len2, lob, clp, i);
+    tap_w(&acc_c, &acc_w, vec2<f32>(0.0, 1.0) - pp, dir, len2, lob, clp, j);
+    tap_w(&acc_c, &acc_w, vec2<f32>(0.0, 0.0) - pp, dir, len2, lob, clp, f);
+    tap_w(&acc_c, &acc_w, vec2<f32>(-1.0, 0.0) - pp, dir, len2, lob, clp, e);
+    tap_w(&acc_c, &acc_w, vec2<f32>(1.0, 1.0) - pp, dir, len2, lob, clp, k);
+    tap_w(&acc_c, &acc_w, vec2<f32>(2.0, 1.0) - pp, dir, len2, lob, clp, l);
+    tap_w(&acc_c, &acc_w, vec2<f32>(2.0, 0.0) - pp, dir, len2, lob, clp, h);
+    tap_w(&acc_c, &acc_w, vec2<f32>(1.0, 0.0) - pp, dir, len2, lob, clp, g);
+    tap_w(&acc_c, &acc_w, vec2<f32>(1.0, 2.0) - pp, dir, len2, lob, clp, o);
+    tap_w(&acc_c, &acc_w, vec2<f32>(0.0, 2.0) - pp, dir, len2, lob, clp, n);
+
+    let mn = min(min(f, g), min(j, k));
+    let mx = max(max(f, g), max(j, k));
+    let color = min(mx, max(mn, acc_c / acc_w));
+    return vec4<f32>(color, 1.0);
+}
+
+@fragment
+fn fs_rcas(@builtin(position) frag: vec4<f32>) -> @location(0) vec4<f32> {
+    let sp = vec2<i32>(floor(frag.xy));
+    let b = tap(sp + vec2<i32>(0, -1));
+    let d = tap(sp + vec2<i32>(-1, 0));
+    let e = tap(sp);
+    let f = tap(sp + vec2<i32>(1, 0));
+    let h = tap(sp + vec2<i32>(0, 1));
+    let mn4 = min(min(b, d), min(f, h));
+    let mx4 = max(max(b, d), max(f, h));
+    // Largest lobe that neither pushes the result below 0 nor above 1 (peak = 1, -4).
+    let hit_min = min(mn4, e) / max(4.0 * mx4, vec3<f32>(1.0 / 32768.0));
+    let hit_max = (vec3<f32>(1.0) - max(mx4, e)) / (4.0 * min(mn4, e) - vec3<f32>(4.0));
+    let lobe_rgb = max(-hit_min, hit_max);
+    let limit = 0.25 - 1.0 / 16.0;
+    let lobe = max(-limit, min(max(lobe_rgb.r, max(lobe_rgb.g, lobe_rgb.b)), 0.0)) * p.sharp;
+    let color = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
+    return vec4<f32>(clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
+}
+)""";
+
+struct Pipelines {
+  wgpu::RenderPipeline easu;
+  wgpu::RenderPipeline rcas;
+  wgpu::BindGroupLayout paramsLayout;
+  wgpu::Sampler sampler;
+};
+Pipelines g_pipelines;
+
+struct Slot {
+  uint32_t inW = 0, inH = 0, outW = 0, outH = 0;
+  float sharpness = -1.f;
+  wgpu::Texture easuTexture, rcasTexture;
+  wgpu::Buffer easuParams, rcasParams;
+  wgpu::BindGroup easuParamsGroup, rcasParamsGroup, rcasSource, output;
+};
+// One slot per frame that can be in flight, as for MetalFX: a cached output stays valid while
+// later frames encode into the other slots.
+std::array<Slot, 4> g_slots;
+size_t g_nextSlot = 0;
+
+struct alignas(16) Params {
+  float inW, inH, outW, outH, sharp, pad[3];
+};
+
+constexpr wgpu::TextureFormat kFormat = wgpu::TextureFormat::RGBA8Unorm;
+
+void create_pipelines() {
+  wgpu::ShaderSourceWGSL source{};
+  source.code = kShader;
+  const wgpu::ShaderModuleDescriptor moduleDescriptor{.nextInChain = &source, .label = "FSR 1 Module"};
+  auto module = g_device.CreateShaderModule(&moduleDescriptor);
+
+  const wgpu::BindGroupLayoutEntry paramsEntry{
+      .binding = 0,
+      .visibility = wgpu::ShaderStage::Fragment,
+      .buffer = wgpu::BufferBindingLayout{.type = wgpu::BufferBindingType::Uniform, .minBindingSize = sizeof(Params)},
+  };
+  const wgpu::BindGroupLayoutDescriptor paramsLayoutDescriptor{.entryCount = 1, .entries = &paramsEntry};
+  g_pipelines.paramsLayout = g_device.CreateBindGroupLayout(&paramsLayoutDescriptor);
+  const std::array layouts{g_CopyBindGroupLayout, g_pipelines.paramsLayout};
+  const wgpu::PipelineLayoutDescriptor layoutDescriptor{.bindGroupLayoutCount = layouts.size(),
+                                                        .bindGroupLayouts = layouts.data()};
+  auto layout = g_device.CreatePipelineLayout(&layoutDescriptor);
+
+  auto make = [&](const char* entry, const char* label) {
+    const wgpu::ColorTargetState target{.format = kFormat, .writeMask = wgpu::ColorWriteMask::All};
+    const wgpu::FragmentState fragment{.module = module, .entryPoint = entry, .targetCount = 1, .targets = &target};
+    const wgpu::RenderPipelineDescriptor descriptor{
+        .label = label,
+        .layout = layout,
+        .vertex = wgpu::VertexState{.module = module, .entryPoint = "vs_main"},
+        .primitive = wgpu::PrimitiveState{.topology = wgpu::PrimitiveTopology::TriangleList},
+        .multisample = wgpu::MultisampleState{.count = 1, .mask = UINT32_MAX},
+        .fragment = &fragment,
+    };
+    return g_device.CreateRenderPipeline(&descriptor);
+  };
+  g_pipelines.easu = make("fs_easu", "FSR EASU");
+  g_pipelines.rcas = make("fs_rcas", "FSR RCAS");
+  wgpu::SamplerDescriptor samplerDescriptor{};
+  samplerDescriptor.magFilter = wgpu::FilterMode::Nearest;
+  samplerDescriptor.minFilter = wgpu::FilterMode::Nearest;
+  g_pipelines.sampler = g_device.CreateSampler(&samplerDescriptor);
+}
+
+wgpu::Texture make_target(uint32_t w, uint32_t h, const char* label) {
+  const wgpu::TextureDescriptor descriptor{
+      .label = label,
+      .usage = wgpu::TextureUsage::RenderAttachment | wgpu::TextureUsage::TextureBinding,
+      .size = {w, h, 1},
+      .format = kFormat,
+  };
+  return g_device.CreateTexture(&descriptor);
+}
+
+wgpu::BindGroup params_group(wgpu::Buffer& buffer, const Params& params) {
+  const wgpu::BufferDescriptor descriptor{.usage = wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst,
+                                          .size = sizeof(Params)};
+  buffer = g_device.CreateBuffer(&descriptor);
+  g_queue.WriteBuffer(buffer, 0, &params, sizeof(Params));
+  const wgpu::BindGroupEntry entry{.binding = 0, .buffer = buffer, .size = sizeof(Params)};
+  const wgpu::BindGroupDescriptor groupDescriptor{.layout = g_pipelines.paramsLayout, .entryCount = 1, .entries = &entry};
+  return g_device.CreateBindGroup(&groupDescriptor);
+}
+
+void draw(wgpu::CommandEncoder& encoder, const wgpu::Texture& target, const wgpu::RenderPipeline& pipeline,
+          const wgpu::BindGroup& source, const wgpu::BindGroup& params, const char* label) {
+  const wgpu::RenderPassColorAttachment attachment{
+      .view = target.CreateView(),
+      .loadOp = wgpu::LoadOp::Clear,
+      .storeOp = wgpu::StoreOp::Store,
+  };
+  const wgpu::RenderPassDescriptor descriptor{.label = label, .colorAttachmentCount = 1, .colorAttachments = &attachment};
+  auto pass = encoder.BeginRenderPass(&descriptor);
+  pass.SetPipeline(pipeline);
+  pass.SetBindGroup(0, source);
+  pass.SetBindGroup(1, params);
+  pass.Draw(3);
+  pass.End();
+}
+
+} // namespace
+
+wgpu::BindGroup upscale(wgpu::CommandEncoder& encoder, const PresentSource& source, uint32_t outputWidth,
+                        uint32_t outputHeight, float sharpness) {
+  const uint32_t inW = source.size.width, inH = source.size.height;
+  if (!inW || !inH || !outputWidth || !outputHeight || (inW >= outputWidth && inH >= outputHeight) || !source.bindGroup) {
+    return {};
+  }
+  if (!g_pipelines.easu) create_pipelines();
+  auto& slot = g_slots[g_nextSlot++ % g_slots.size()];
+  if (slot.inW != inW || slot.inH != inH || slot.outW != outputWidth || slot.outH != outputHeight ||
+      slot.sharpness != sharpness) {
+    slot = {};
+    slot.inW = inW;
+    slot.inH = inH;
+    slot.outW = outputWidth;
+    slot.outH = outputHeight;
+    slot.sharpness = sharpness;
+    slot.easuTexture = make_target(outputWidth, outputHeight, "FSR EASU output");
+    slot.rcasTexture = make_target(outputWidth, outputHeight, "FSR RCAS output");
+    const float w = static_cast<float>(outputWidth), h = static_cast<float>(outputHeight);
+    slot.easuParamsGroup = params_group(slot.easuParams, Params{static_cast<float>(inW), static_cast<float>(inH), w, h,
+                                                                0.f, {}});
+    slot.rcasParamsGroup = params_group(slot.rcasParams, Params{w, h, w, h, std::exp2(-sharpness), {}});
+    slot.rcasSource = create_copy_bind_group(slot.easuTexture.CreateView(), g_pipelines.sampler);
+    wgpu::SamplerDescriptor linear{};
+    linear.magFilter = wgpu::FilterMode::Linear;
+    linear.minFilter = wgpu::FilterMode::Linear;
+    slot.output = create_copy_bind_group(slot.rcasTexture.CreateView(), g_device.CreateSampler(&linear));
+  }
+  draw(encoder, slot.easuTexture, g_pipelines.easu, source.bindGroup, slot.easuParamsGroup, "FSR EASU");
+  draw(encoder, slot.rcasTexture, g_pipelines.rcas, slot.rcasSource, slot.rcasParamsGroup, "FSR RCAS");
+  return slot.output;
+}
+
+void shutdown() {
+  g_slots = {};
+  g_pipelines = {};
+}
+
+} // namespace aurora::webgpu::fsr
diff --git a/aurora-main/lib/webgpu/fsr.hpp b/aurora-main/lib/webgpu/fsr.hpp
new file mode 100644
index 0000000..35b12b1
--- /dev/null
+++ b/aurora-main/lib/webgpu/fsr.hpp
@@ -0,0 +1,16 @@
+#pragma once
+
+#include "gpu.hpp"
+
+// AMD FidelityFX Super Resolution 1 (EASU upscale + RCAS sharpen) for the final presentation.
+// Port of the published FSR 1 algorithm (MIT, Copyright (c) 2021 Advanced Micro Devices) to WGSL.
+namespace aurora::webgpu::fsr {
+
+// Upscales `source` to outputWidth x outputHeight and returns a copy-layout bind group of the
+// result, or an empty bind group when it does not apply (source not smaller than the output).
+// sharpness is RCAS's value in stops: 0 is the sharpest, 2 is almost none.
+wgpu::BindGroup upscale(wgpu::CommandEncoder& encoder, const PresentSource& source, uint32_t outputWidth,
+                        uint32_t outputHeight, float sharpness);
