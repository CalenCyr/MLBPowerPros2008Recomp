+    {0x386, 1, 0x383, 1, false},  // IsSparkplug
+    {0x387, 1, 0x384, 1, false},  // IsRallyHitter
+    {0x388, 1, 0x385, 1, false},  // IsHotHitter
+    {0x389, 1, 0x386, 1, false},  // IsBackToBackHitter
+    {0x38A, 1, 0x387, 1, false},  // IsToughOut
+    {0x38B, 1, 0x388, 1, false},  // IsPushHitter
+    {0x38C, 1, 0x389, 1, false},  // IsSprayHitter
+    {0x38D, 2, 0x38A, 2, false},  // InfieldHitter
+    {0x38F, 1, 0x38C, 1, false},  // IsContactHitter
+    {0x390, 1, 0x38D, 1, false},  // IsPowerHitter
