+#include "roster_fields.inc"
+
+// A PowerUp / PowerUp+ roster is an MLB Power Pros 2007 Wii save (pm2maus.dat). 2008 keeps the same
+// roster block (1500 players of 0xB0 bytes, lineups, free agents, 32 teams) inside game_data.pack at
+// 0x20; the 2007 save holds it at 0x68C74. Teams, lineups and free agents copy over unchanged; player
+// fields are moved with kRosterFields (tools/roster/powerup_to_2008.py, docs/roster-2008.md).
+constexpr size_t kRosterPlayer = 0xB0, kRosterSlots = 1500, kRosterBlock = 0x43E80;
+constexpr size_t kSaveRoster2007 = 0x68C74, kPackRoster2008 = 0x20;
+constexpr uint32_t kRosterConverter = 3;
+
+uint32_t GetBits(const unsigned char* record, uint32_t bit, uint32_t count) {
+    uint32_t value = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t b = bit + i;
+        value = (value << 1) | ((record[b / 8] >> (7 - b % 8)) & 1u);
+    }
+    return value;
+}
+
+void SetBits(unsigned char* record, uint32_t bit, uint32_t count, uint32_t value) {
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t b = bit + i;
+        const unsigned char mask = static_cast<unsigned char>(0x80u >> (b % 8));
+        if ((value >> (count - 1 - i)) & 1u) {
+            record[b / 8] |= mask;
+        } else {
+            record[b / 8] &= static_cast<unsigned char>(~mask);
+        }
+    }
+}
+
+// Rebuilds `pack` (the player's own game_data.pack) with the roster of a PowerUp save.
+bool ConvertRoster(const std::vector<char>& save, std::vector<char>& pack, std::string& error) {
+    if (save.size() < kSaveRoster2007 + kRosterBlock) {
+        error = "not an MLB Power Pros 2007 Wii save (pm2maus.dat)";
+        return false;
+    }
+    if (pack.size() != kPackRoster2008 + kRosterBlock || std::memcmp(pack.data(), "PACKWII ", 8) != 0) {
+        error = "unexpected game_data.pack";
+        return false;
+    }
+    const auto* oldBlock = reinterpret_cast<const unsigned char*>(save.data() + kSaveRoster2007);
+    auto* newBlock = reinterpret_cast<unsigned char*>(pack.data() + kPackRoster2008);
+    // A player also in the original 2008 roster (same last and first name, 0x16..0x4D) starts from
+    // his 2008 record, so what only 2008 has (voice, the bits 2008 added) survives.
+    // tools/roster/powerup_to_2008.py does the same; both must give the same bytes.
+    const std::vector<unsigned char> original(newBlock, newBlock + kRosterSlots * kRosterPlayer);
+    std::map<std::string, const unsigned char*> originals;
+    for (size_t i = 0; i < kRosterSlots; ++i) {
+        const unsigned char* record = original.data() + i * kRosterPlayer;
+        if (record[0] != 0 || record[1] != 0) {
+            originals.try_emplace(std::string(reinterpret_cast<const char*>(record) + 0x16, 0x38), record);
+        }
+    }
+    for (size_t i = 0; i < kRosterSlots; ++i) {
+        const unsigned char* from = oldBlock + i * kRosterPlayer;
+        unsigned char* to = newBlock + i * kRosterPlayer;
+        std::memset(to, 0, kRosterPlayer);
+        if (from[0] == 0 && from[1] == 0) continue;  // empty slot
+        const auto same = originals.find(std::string(reinterpret_cast<const char*>(from) + 0x16, 0x38));
+        if (same != originals.end()) std::memcpy(to, same->second, kRosterPlayer);
+        std::memcpy(to, from, 0x5C);
+        std::memcpy(to + 0x60, from + 0x60, 0x0F);
+        for (const RosterField& field : kRosterFields) {
+            uint32_t value = GetBits(from, field.from, field.bits);
+            if (field.birthYear && value != 0) value += 1;  // PowerUp dates count from opening day 2007
+            SetBits(to, field.to, field.toBits, value);
+        }
+        // PowerUp cannot edit the bits it has no name for (it leaves whatever its base save had in
+        // that slot), so a known player keeps his 2008 ones.
+        if (same != originals.end()) {
+            for (const uint16_t bit : kRosterUnnamed) SetBits(to, bit, 1, GetBits(same->second, bit, 1));
+        }
+    }
+    const size_t players = kRosterSlots * kRosterPlayer;
+    std::memcpy(newBlock + players, oldBlock + players, kRosterBlock - players);
+    return true;
+}
+
+// One entry of PROJECT.BIN by name (lower case, no leading slash).
+bool ReadProjectEntry(const std::filesystem::path& original, const std::string& wanted, std::vector<char>& out) {
+    std::ifstream src(original, std::ios::binary);
+    std::vector<char> head(0x40);
+    if (!src.read(head.data(), static_cast<std::streamsize>(head.size()))) return false;
+    const uint32_t recordsOff = Be32(head, 0x14), orderOff = Be32(head, 0x28), namesOff = Be32(head, 0x2C),
+                   dataOff = Be32(head, 0x34);
+    std::vector<char> header(dataOff);
+    src.seekg(0);
+    src.read(header.data(), static_cast<std::streamsize>(header.size()));
+    for (uint32_t slot = 1; orderOff + slot * 8 + 8 <= namesOff; ++slot) {
+        const uint32_t index = Be32(header, orderOff + slot * 8);
+        const uint32_t start = Be32(header, orderOff + slot * 8 + 4);
+        if (index == 0 && start == 0) break;
+        const size_t record = recordsOff + static_cast<size_t>(index) * 0x1C;
+        std::string name(header.data() + namesOff + Be32(header, record + 4));
+        if (Lower(name.substr(name.rfind('/') == 0 ? 1 : 0)) != wanted) continue;
+        out.resize(Be32(header, record + 0x18));
+        src.seekg(static_cast<std::streamoff>(dataOff) + static_cast<std::streamoff>(start) * 0x800);
+        return static_cast<bool>(src.read(out.data(), static_cast<std::streamsize>(out.size())));
+    }
+    return false;
+}
+
+// roster/*.dat of a mod becomes a converted game_data.pack in the cache, rebuilt when the save changes.
+std::filesystem::path ApplyRoster(const Mod& mod, const char* cachePath) {
+    namespace fs = std::filesystem;
+    std::error_code ec;
+    fs::path save;
+    for (const auto& file : fs::directory_iterator(mod.root / "roster", ec)) {
+        if (file.is_regular_file(ec) && Lower(Utf8(file.path().extension())) == ".dat") {
+            save = file.path();
+            break;
+        }
+    }
+    if (save.empty()) return {};
+    const fs::path base = cachePath != nullptr ? fs::path(reinterpret_cast<const char8_t*>(cachePath))
+                                               : Directory().parent_path();
+    const fs::path dir = base / "mods" / "roster" / mod.root.filename();
+    // The cache name carries a hash of the field tables and of kRosterConverter (bump it when
+    // ConvertRoster changes), so a newer converter redoes old conversions.
+    uint32_t tableHash = (2166136261u ^ kRosterConverter) * 16777619u;
+    for (const RosterField& field : kRosterFields) {
+        for (const uint32_t value : {uint32_t{field.from}, uint32_t{field.bits}, uint32_t{field.to}, uint32_t{field.toBits}}) {
+            tableHash = (tableHash ^ value) * 16777619u;
+        }
+    }
+    for (const uint16_t bit : kRosterUnnamed) tableHash = (tableHash ^ bit) * 16777619u;
+    char name[32];
+    std::snprintf(name, sizeof(name), "game_data-%08x.pack", tableHash);
+    const fs::path pack = dir / name;
+    if (fs::is_regular_file(pack, ec) && fs::last_write_time(pack, ec) >= fs::last_write_time(save, ec)) return pack;
+    std::ifstream in(save, std::ios::binary);
+    const std::vector<char> saveData((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    std::vector<char> packData;
+    std::string error;
+    if (!ReadProjectEntry(RuntimeConfigFile::ResolvedDvdRoot() / "files" / "project.bin", "game_data.pack", packData)) {
+        error = "game_data.pack not found in the disc's PROJECT.BIN";
+    }
+    if (!error.empty() || !ConvertRoster(saveData, packData, error)) {
+        RT_LOG(RT_TAG_RUNTIME) << "mods: cannot load the roster " << Utf8(save) << ": " << error << std::endl;
+        return {};
+    }
+    fs::create_directories(dir, ec);
+    std::ofstream(pack, std::ios::binary | std::ios::trunc)
+        .write(packData.data(), static_cast<std::streamsize>(packData.size()));
+    RT_LOG(RT_TAG_RUNTIME) << "mods: converted roster " << Utf8(save.filename())
+                           << " (MLB Power Pros 2007 save) for 2008" << std::endl;
+    return pack;
+}
+
+// project/ packs of the enabled mods, merged into a per-user copy of PROJECT.BIN that is served as a
+// disc overlay. The copy is rebuilt only when the original or any pack changes (size and time).
+// ponytail: a full 406 MB copy; a virtual file in the DVD layer would avoid it if disk space matters.
+void ApplyProjectPacks(const std::map<std::string, std::filesystem::path>& packs, const char* cachePath) {
+    namespace fs = std::filesystem;
+    const fs::path original = RuntimeConfigFile::ResolvedDvdRoot() / "files" / "project.bin";
+    const fs::path disc = (cachePath != nullptr ? fs::path(reinterpret_cast<const char8_t*>(cachePath))
+                                                : Directory().parent_path()) / "mods" / "disc";
+    const fs::path merged = disc / "project.bin";
+    const fs::path stamp = disc / "project.bin.sources";
+    std::error_code ec;
+    auto describe = [&](const fs::path& path) {
+        const auto time = fs::last_write_time(path, ec).time_since_epoch().count();
+        return Utf8(path) + " " + std::to_string(static_cast<unsigned long long>(fs::file_size(path, ec))) + " " +
+               std::to_string(static_cast<long long>(time)) + "\n";
+    };
+    std::string sources = describe(original);
+    for (const auto& [name, path] : packs) sources += name + " = " + describe(path);
+    std::string previous;
+    if (std::ifstream in(stamp, std::ios::binary); in) previous.assign(std::istreambuf_iterator<char>(in), {});
+    if (previous != sources || !fs::is_regular_file(merged, ec)) {
+        fs::create_directories(disc, ec);
+        const fs::path partial = disc / "project.bin.partial";
+        const auto started = std::chrono::steady_clock::now();
+        std::string error;
+        if (!BuildProjectBin(original, packs, partial, error)) {
+            RT_LOG(RT_TAG_RUNTIME) << "mods: cannot build the modded PROJECT.BIN: " << error << std::endl;
+            fs::remove(partial, ec);
+            return;
+        }
+        fs::rename(partial, merged, ec);
+        if (ec) {
+            RT_LOG(RT_TAG_RUNTIME) << "mods: cannot replace " << Utf8(merged) << ": " << ec.message() << std::endl;
+            return;
+        }
+        std::ofstream(stamp, std::ios::binary) << sources;
+        RT_LOG(RT_TAG_RUNTIME) << "mods: built PROJECT.BIN with " << packs.size() << " replaced pack(s) in "
+                               << std::chrono::duration_cast<std::chrono::milliseconds>(
+                                      std::chrono::steady_clock::now() - started).count()
+                               << " ms" << std::endl;
+    } else {
+        RT_LOG(RT_TAG_RUNTIME) << "mods: reusing PROJECT.BIN with " << packs.size() << " replaced pack(s)" << std::endl;
+    }
+    RecompMod::RegisterDvdOverlayRoot(Utf8(disc));
+}
+
+} // namespace
+
+void Apply(AuroraConfig& config) {
+    static std::vector<std::string> textureRoots;
+    static std::vector<const char*> texturePointers;
+    std::map<std::string, std::filesystem::path> packs;  // first enabled mod (by name) wins
+    for (const Mod& mod : Discover()) {
+        if (!mod.enabled) continue;
+        RT_LOG(RT_TAG_RUNTIME) << "mods: enabled \"" << mod.name << "\" (" << Utf8(mod.root) << ")" << std::endl;
+        if (mod.riivolution) RecompMod::RegisterDvdOverlayRoot(Utf8(mod.root));
+        if (mod.disc) RecompMod::RegisterDvdOverlayRoot(Utf8(mod.root / "disc"));
+        if (mod.textures) textureRoots.push_back(Utf8(mod.root / "textures"));
+        if (mod.roster) {  // before project/: a roster .dat wins over the same mod's game_data.pack
+            if (const auto pack = ApplyRoster(mod, config.cachePath); !pack.empty()) {
+                packs.try_emplace("game_data.pack", pack);
+            }
+        }
+        if (mod.project) {
+            std::error_code ec;
+            for (const auto& file : std::filesystem::directory_iterator(mod.root / "project", ec)) {
+                if (file.is_regular_file(ec)) packs.try_emplace(Lower(Utf8(file.path().filename())), file.path());
+            }
+        }
+    }
+    if (!packs.empty()) ApplyProjectPacks(packs, config.cachePath);
+    if (textureRoots.empty()) return;
+    for (const std::string& root : textureRoots) texturePointers.push_back(root.c_str());
+    config.textureReplacementRoots = texturePointers.data();
+    config.textureReplacementRootCount = texturePointers.size();
+    config.allowTextureReplacements = true;
+}
