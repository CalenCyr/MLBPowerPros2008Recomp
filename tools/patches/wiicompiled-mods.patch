+++ b/runtime/include/mods.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <aurora/aurora.h>
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+// Player-installed mods: <exe dir>/mods/<folder>/ with an optional mod.toml
+// (name, author, version, description) and any of
+//   textures/      Dolphin-style texture replacements (tex1_<W>x<H>_<hash>...png/dds),
+//   disc/          files laid out like the disc's files/ tree, replacing the originals,
+//   riivolution/   Riivolution XMLs (the mod folder is then the virtual SD root),
+//   project/       PROJECT.BIN entries by name (e.g. PWM_mdl_uniform_MLB_BOS_00.pack); Apply builds a
+//                  per-user PROJECT.BIN with them and serves it instead of the disc's,
+//   roster/        a PowerUp / PowerUp+ roster (MLB Power Pros 2007 Wii save, *.dat), converted to
+//                  2008's game_data.pack on the player's PC; it applies to every mode, MLB Life too.
+// Enabled folders are listed in Config.toml under [mods] enabled. Everything is read once at
+// start-up, so toggling a mod needs a restart (the launcher relaunches).
+namespace mods {
+
+struct Mod {
+    std::string id;  // folder name
+    std::string name;
+    std::string author;
+    std::string version;
+    std::string description;
+    std::filesystem::path root;
+    bool textures = false;
+    bool disc = false;
+    bool riivolution = false;
+    bool project = false;
+    bool roster = false;
+    bool enabled = false;
+};
+
+std::filesystem::path Directory();
+std::vector<Mod> Discover();
+bool SetEnabled(const std::string& id, bool enabled);
+
+// Registers the enabled mods' disc/Riivolution overlays and texture folders. Call before
+// aurora_initialize; the texture folder strings stay alive for the process lifetime.
+void Apply(AuroraConfig& config);
+
+} // namespace mods
