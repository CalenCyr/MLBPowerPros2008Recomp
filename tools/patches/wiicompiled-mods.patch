+namespace mods {
+namespace {
+
+std::string Utf8(const std::filesystem::path& path) {
+    const std::u8string text = path.u8string();
+    return std::string(text.begin(), text.end());
+}
+
+std::string Lower(std::string text) {
+    std::transform(text.begin(), text.end(), text.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+}
+
+bool IsDirectory(const std::filesystem::path& path) {
+    std::error_code ec;
+    return std::filesystem::is_directory(path, ec);
+}
+
+uint32_t Be32(const std::vector<char>& data, size_t at) {
+    const auto* b = reinterpret_cast<const unsigned char*>(data.data() + at);
+    return (uint32_t{b[0]} << 24) | (uint32_t{b[1]} << 16) | (uint32_t{b[2]} << 8) | uint32_t{b[3]};
+}
+
+void PutBe32(std::vector<char>& data, size_t at, uint32_t value) {
+    for (int i = 0; i < 4; ++i) data[at + i] = static_cast<char>(value >> (24 - 8 * i));
+}
+
+// Writes `out` as a copy of PROJECT.BIN with the entries named in `replacements` (lower-case path
+// without the leading slash, e.g. "pwm_mdl_uniform_mlb_chc_00.pack") swapped in. Same layout as
+// tools/projectbin.py: 0x1C-byte records at [0x14] (name offset, sectors, alignment, bytes), an
+// order table at [0x28] of (record, start sector) pairs, names at [0x2C], data from [0x34] in
+// 0x800-byte sectors. Only record sizes and start sectors change.
+bool BuildProjectBin(const std::filesystem::path& original, const std::map<std::string, std::filesystem::path>& replacements,
+                     const std::filesystem::path& out, std::string& error) {
+    constexpr uint32_t kSector = 0x800;
+    std::ifstream src(original, std::ios::binary);
+    std::vector<char> head(0x40);
+    if (!src.read(head.data(), static_cast<std::streamsize>(head.size()))) {
+        error = "cannot read " + Utf8(original);
+        return false;
+    }
+    const uint32_t recordsOff = Be32(head, 0x14), orderOff = Be32(head, 0x28), namesOff = Be32(head, 0x2C),
+                   dataOff = Be32(head, 0x34);
+    if (Be32(head, 4) != kSector || !(recordsOff < orderOff && orderOff < namesOff && namesOff < dataOff)) {
+        error = "unexpected PROJECT.BIN header";
+        return false;
+    }
+    std::vector<char> header(dataOff);
+    src.seekg(0);
+    src.read(header.data(), static_cast<std::streamsize>(header.size()));
+    std::ofstream dst(out, std::ios::binary | std::ios::trunc);
+    if (!dst) {
+        error = "cannot write " + Utf8(out);
+        return false;
+    }
+    dst.write(header.data(), static_cast<std::streamsize>(header.size()));
+    std::vector<char> data;
+    uint32_t sector = 0;
+    size_t used = 0;
+    for (uint32_t slot = 1; orderOff + slot * 8 + 8 <= namesOff; ++slot) {
+        const uint32_t index = Be32(header, orderOff + slot * 8);
+        const uint32_t start = Be32(header, orderOff + slot * 8 + 4);
+        if (index == 0 && start == 0) break;
+        const size_t record = recordsOff + static_cast<size_t>(index) * 0x1C;
+        const size_t nameAt = namesOff + Be32(header, record + 4);
+        std::string name(header.data() + nameAt);
+        name = Lower(name.substr(name.rfind('/') == 0 ? 1 : 0));
+        if (const auto it = replacements.find(name); it != replacements.end()) {
+            std::ifstream file(it->second, std::ios::binary);
+            data.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+            ++used;
+        } else {
+            data.resize(Be32(header, record + 0x18));
+            src.seekg(static_cast<std::streamoff>(dataOff) + static_cast<std::streamoff>(start) * kSector);
+            src.read(data.data(), static_cast<std::streamsize>(data.size()));
+        }
+        const uint32_t bytes = static_cast<uint32_t>(data.size());
+        const uint32_t sectors = (bytes + kSector - 1) / kSector;
+        data.resize(static_cast<size_t>(sectors) * kSector, '\0');
+        dst.write(data.data(), static_cast<std::streamsize>(data.size()));
+        PutBe32(header, record + 8, sectors);
+        PutBe32(header, record + 0x18, bytes);
+        PutBe32(header, orderOff + slot * 8 + 4, sector);
+        sector += sectors;
+    }
+    if (used != replacements.size()) {
+        RT_LOG(RT_TAG_RUNTIME) << "mods: " << replacements.size() - used
+                               << " project/ file(s) match no PROJECT.BIN entry and were ignored" << std::endl;
+    }
+    dst.seekp(0);
+    dst.write(header.data(), static_cast<std::streamsize>(header.size()));
+    if (!dst) {
+        error = "write failed for " + Utf8(out);
+        return false;
+    }
+    return true;
+}
