diff --git a/runtime/src/mods.cpp b/runtime/src/mods.cpp
new file mode 100644
index 0000000..ebd3b88
--- /dev/null
+++ b/runtime/src/mods.cpp
@@ -0,0 +1,103 @@
+#include "mods.h"
+
+#include "recomp_mod_loader.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+#include <aurora/aurora.h>
+
+#include <algorithm>
+#include <cctype>
+#include <fstream>
+
+namespace mods {
+namespace {
+
+std::string Utf8(const std::filesystem::path& path) {
+    const std::u8string text = path.u8string();
+    return std::string(text.begin(), text.end());
+}
+
+std::string Lower(std::string text) {
+    std::transform(text.begin(), text.end(), text.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+}
+
+bool IsDirectory(const std::filesystem::path& path) {
+    std::error_code ec;
+    return std::filesystem::is_directory(path, ec);
+}
+
+} // namespace
+
+std::filesystem::path Directory() {
+    const auto base = RuntimeConfigFile::ExecutableDirectory().value_or(std::filesystem::current_path());
+    return base / "mods";
+}
+
+std::vector<Mod> Discover() {
+    std::vector<Mod> found;
+    const auto enabled = RuntimeConfigFile::EnabledMods();
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator(Directory(), ec)) {
+        if (!entry.is_directory(ec)) continue;
+        Mod mod;
+        mod.root = entry.path();
+        mod.id = Utf8(entry.path().filename());
+        mod.name = mod.id;
+        const auto manifest = mod.root / "mod.toml";
+        if (std::filesystem::is_regular_file(manifest, ec)) {
+            try {
+                std::ifstream input(manifest, std::ios::binary);
+                const toml::value document = toml::parse(input, Utf8(manifest));
+                auto text = [&](const char* key, std::string& out) {
+                    try {
+                        out = toml::find<std::string>(document, std::string(key));
+                    } catch (const std::exception&) {  // optional field
+                    }
+                };
+                text("name", mod.name);
+                text("author", mod.author);
+                text("version", mod.version);
+                text("description", mod.description);
+            } catch (const std::exception& error) {
+                RT_LOG(RT_TAG_RUNTIME) << "mods: ignoring unreadable " << Utf8(manifest) << ": " << error.what()
+                                       << std::endl;
+            }
+        }
+        mod.textures = IsDirectory(mod.root / "textures");
+        mod.disc = IsDirectory(mod.root / "disc");
+        mod.riivolution = IsDirectory(mod.root / "riivolution");
+        mod.enabled = std::find(enabled.begin(), enabled.end(), mod.id) != enabled.end();
+        found.push_back(std::move(mod));
+    }
+    std::sort(found.begin(), found.end(), [](const Mod& a, const Mod& b) { return Lower(a.name) < Lower(b.name); });
+    return found;
+}
+
+bool SetEnabled(const std::string& id, bool enabled) {
+    auto list = RuntimeConfigFile::EnabledMods();
+    list.erase(std::remove(list.begin(), list.end(), id), list.end());
+    if (enabled) list.push_back(id);
+    return RuntimeConfigFile::SetEnabledMods(list);
+}
+
+void Apply(AuroraConfig& config) {
+    static std::vector<std::string> textureRoots;
+    static std::vector<const char*> texturePointers;
+    for (const Mod& mod : Discover()) {
+        if (!mod.enabled) continue;
+        RT_LOG(RT_TAG_RUNTIME) << "mods: enabled \"" << mod.name << "\" (" << Utf8(mod.root) << ")" << std::endl;
+        if (mod.riivolution) RecompMod::RegisterDvdOverlayRoot(Utf8(mod.root));
+        if (mod.disc) RecompMod::RegisterDvdOverlayRoot(Utf8(mod.root / "disc"));
+        if (mod.textures) textureRoots.push_back(Utf8(mod.root / "textures"));
+    }
+    if (textureRoots.empty()) return;
+    for (const std::string& root : textureRoots) texturePointers.push_back(root.c_str());
+    config.textureReplacementRoots = texturePointers.data();
+    config.textureReplacementRootCount = texturePointers.size();
+    config.allowTextureReplacements = true;
+}
+
+} // namespace mods
