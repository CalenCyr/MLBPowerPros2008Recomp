diff --git a/src/backend/llvm/ir_cache.cpp b/src/backend/llvm/ir_cache.cpp
new file mode 100644
index 0000000..129fa99
--- /dev/null
+++ b/src/backend/llvm/ir_cache.cpp
@@ -0,0 +1,117 @@
+#include "backend/llvm/ir_cache.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include <llvm/ADT/SmallString.h>
+#include <llvm/ADT/SmallVector.h>
+#include <llvm/ADT/StringExtras.h>
+#include <llvm/Bitcode/BitcodeWriter.h>
+#include <llvm/Config/llvm-config.h>
+#include <llvm/IR/Module.h>
+#include <llvm/Support/FileSystem.h>
+#include <llvm/Support/Path.h>
+#include <llvm/Support/Process.h>
+#include <llvm/Support/SHA256.h>
+#include <llvm/Support/raw_ostream.h>
+
+#ifndef DOLLLVM_PIPELINE_HASH
+#define DOLLLVM_PIPELINE_HASH "unversioned"
+#endif
+
+namespace dolllvm {
+
+using namespace llvm;
+
+namespace {
+
+const char *cacheRoot() {
+  const char *root = std::getenv("DOLRECOMP_LLVM_IR_CACHE");
+  return root && root[0] ? root : nullptr;
+}
+
+void hashText(SHA256 &hash, const std::string &text) {
+  hash.update(StringRef(text.data(), text.size() + 1));
+}
+
+bool hashFile(SHA256 &hash, const char *path) {
+  FILE *file = std::fopen(path, "rb");
+  if (!file)
+    return false;
+  char bytes[4096];
+  size_t count;
+  while ((count = std::fread(bytes, 1, sizeof(bytes), file)) != 0)
+    hash.update(StringRef(bytes, count));
+  std::fclose(file);
+  return true;
+}
+
+SmallString<256> entryPath(const std::string &key, const char *suffix) {
+  SmallString<256> path(cacheRoot());
+  sys::path::append(path, key.substr(0, 2), key + suffix);
+  return path;
+}
+
+bool publish(const char *source, const SmallString<256> &target) {
+  SmallString<256> temp(target);
+  temp += ".tmp." + std::to_string(sys::Process::getProcessId());
+  if (sys::fs::copy_file(source, temp))
+    return false;
+  if (sys::fs::rename(temp, target)) {
+    sys::fs::remove(temp);
+    return false;
+  }
+  return true;
+}
+
+} // namespace
+
+std::string irCacheKey(Module &module, const DolLLVMOptions &options,
+                       int codegen_level) {
+  if (!cacheRoot() || options.emit_ir || !options.emit_thinlto ||
+      !options.thinlto_path ||
+      (options.profile_generate_path && options.profile_generate_path[0]))
+    return {};
+  SmallVector<char, 0> bitcode;
+  raw_svector_ostream stream(bitcode);
+  WriteBitcodeToFile(module, stream);
+  SHA256 hash;
+  hash.update(StringRef(bitcode.data(), bitcode.size()));
+  hashText(hash, "dolllvm-ir-cache-v1");
+  hashText(hash, LLVM_VERSION_STRING);
+  hashText(hash, DOLLLVM_PIPELINE_HASH);
+  hashText(hash, std::to_string(options.optimization_level));
+  hashText(hash, std::to_string(codegen_level));
+  hashText(hash, std::to_string(static_cast<int>(options.semantics)));
+  if (options.profile_use_path && options.profile_use_path[0] &&
+      !hashFile(hash, options.profile_use_path))
+    return {};
+  return toHex(hash.final(), true);
+}
+
+bool irCacheFetch(const std::string &key, const char *object_path,
+                  const char *thinlto_path) {
+  if (key.empty())
+    return false;
+  const SmallString<256> object = entryPath(key, ".o");
+  const SmallString<256> bitcode = entryPath(key, ".bc");
+  return sys::fs::exists(object) && sys::fs::exists(bitcode) &&
+         !sys::fs::copy_file(object, object_path) &&
+         !sys::fs::copy_file(bitcode, thinlto_path);
+}
+
+void irCacheStore(const std::string &key, const char *object_path,
+                  const char *thinlto_path) {
+  if (key.empty())
+    return;
+  const SmallString<256> object = entryPath(key, ".o");
+  if (sys::fs::create_directories(sys::path::parent_path(object)))
+    return;
+  // Bitcode first: a fetch requires both, so a crash between the two
+  // publishes leaves a miss rather than a half entry.
+  if (publish(thinlto_path, entryPath(key, ".bc")))
+    publish(object_path, object);
+}
+
+} // namespace dolllvm
diff --git a/src/backend/llvm/ir_cache.h b/src/backend/llvm/ir_cache.h
new file mode 100644
index 0000000..eaaca1d
--- /dev/null
+++ b/src/backend/llvm/ir_cache.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include "backend/llvm/llvm_backend.h"
+
+#include <string>
+
+namespace llvm {
+class Module;
+}
+
+namespace dolllvm {
+
+// Content-addressed cache for the optimized object of a lowered module.
+// Lowering costs about 1% of emission; optimization and codegen the rest. The
+// job cache in pipeline.c keys on the generator's source hash, so any
+// generator edit misses every chunk. This second level keys on the unoptimized
+// bitcode plus everything that feeds optimization and codegen, so a chunk
+// whose lowered IR is unchanged reuses its object. Enabled by
+// DOLRECOMP_LLVM_IR_CACHE=<dir>; returns an empty key when disabled or when
+// the job asks for output this cache does not hold (IR dumps, PGO generation).
+std::string irCacheKey(llvm::Module &module, const DolLLVMOptions &options,
+                       int codegen_level);
+bool irCacheFetch(const std::string &key, const char *object_path,
+                  const char *thinlto_path);
+void irCacheStore(const std::string &key, const char *object_path,
+                  const char *thinlto_path);
+
+} // namespace dolllvm
