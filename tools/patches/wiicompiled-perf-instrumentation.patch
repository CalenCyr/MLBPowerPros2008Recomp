+// Cumulative counters behind aurora_get_frame_waits.
+struct FrameWaitCounters {
+  std::atomic<uint64_t> stagingMapWaitNs{0}, stagingSplits{0}, submitNs{0}, submits{0}, presentNs{0}, presents{0},
