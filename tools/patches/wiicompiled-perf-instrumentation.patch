+// Diagnostics for thread dumps: milliseconds until the thread's sleep timer fires (negative when
+// overdue), whether one is pending, and whether its park is still tracked as outstanding.
+bool DebugSleepTimerInfo(uint32_t threadPtr, double& msUntilDue, bool& parkOutstanding)
+{
+    {
+        std::lock_guard<std::mutex> lock(gOutstandingParkMutex);
+        parkOutstanding = gOutstandingParks.count(threadPtr) != 0;
+    }
+    std::lock_guard<std::mutex> lock(gSleepTimerMutex);
+    for (const SleepTimerEntry& entry : gSleepTimers) {
+        if (entry.threadPtr == threadPtr) {
+            msUntilDue = std::chrono::duration<double, std::milli>(entry.deadline - std::chrono::steady_clock::now()).count();
+            return true;
+        }
+    }
+    return false;
+}
