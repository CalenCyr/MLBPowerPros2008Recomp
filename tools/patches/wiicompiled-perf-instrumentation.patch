+// WIICOMPILED_BENCH=<minDraws>,<seconds>[,<maxWaitSeconds>]: event-driven benchmark. Waits until a
+// frame issues at least minDraws draw calls (the scene under test), then records frame-to-frame
+// times for the given seconds, prints a summary to stderr and exits. Exits with code 3 if the
+// scene never shows up within maxWaitSeconds (default 600).
+void RunBenchmarkFrame() {
+    struct Bench { unsigned minDraws = 0, seconds = 0, maxWait = 600; bool on = false; };
+    static const Bench cfg = [] {
+        Bench b;
+        if (const char* env = std::getenv("WIICOMPILED_BENCH")) {
+            b.on = std::sscanf(env, "%u,%u,%u", &b.minDraws, &b.seconds, &b.maxWait) >= 2 && b.seconds > 0;
+        }
+        return b;
+    }();
+    if (!cfg.on) return;
+    using Clock = std::chrono::steady_clock;
+    static const Clock::time_point launch = Clock::now();
+    static Clock::time_point start{}, last{};
+    static std::vector<double> frames;
+    static uint64_t drawSum = 0;
+    const Clock::time_point now = Clock::now();
+    const uint32_t draws = aurora_get_stats()->drawCallCount;
+    static AuroraFrameWaits waitsAtStart{};
+    if (start == Clock::time_point{}) {
+        if (draws >= cfg.minDraws) {
+            start = last = now;
+            aurora_get_frame_waits(&waitsAtStart);
+            std::fprintf(stderr, "[bench] scene reached after %.1f s (%u draws)\n",
+                         std::chrono::duration<double>(now - launch).count(), draws);
+        } else if (now - launch > std::chrono::seconds(cfg.maxWait)) {
+            if (FILE* out = std::fopen("bench_result.txt", "w")) {
+                std::fprintf(out, "[bench] scene with %u draws not reached in %u s\n", cfg.minDraws, cfg.maxWait);
+                std::fclose(out);
+            }
+            std::_Exit(3);
+        }
+        return;
+    }
+    // Only frames of the scene under test count; the demo cuts away from it now and then.
+    static double total = 0.0;
+    const double frameMs = std::chrono::duration<double, std::milli>(now - last).count();
+    last = now;
+    if (draws >= cfg.minDraws) {
+        frames.push_back(frameMs);
+        drawSum += draws;
+        total += frameMs;
+    }
+    if (total < cfg.seconds * 1000.0 && now - start < std::chrono::seconds(cfg.seconds * 6)) return;
+    if (frames.empty()) frames.push_back(0.0);
+    std::vector<double> sorted = frames;
+    std::sort(sorted.begin(), sorted.end());
+    const auto pct = [&](double p) { return sorted[std::min(sorted.size() - 1, static_cast<size_t>(p * sorted.size()))]; };
+    const size_t slow = static_cast<size_t>(std::count_if(frames.begin(), frames.end(), [](double f) { return f > 20.0; }));
+    AuroraFrameWaits w{};
+    aurora_get_frame_waits(&w);
+    const double presents = std::max<double>(1.0, static_cast<double>(w.presents - waitsAtStart.presents));
+    const double encoded = std::max<double>(1.0, static_cast<double>(w.encodedFrames - waitsAtStart.encodedFrames));
+    const auto perMs = [](uint64_t a, uint64_t b, double n) { return static_cast<double>(a - b) / 1e6 / n; };
+    char line[768];
+    std::snprintf(line, sizeof(line),
+                  "[bench] frames=%zu fps=%.2f p50=%.2fms p95=%.2fms p99=%.2fms max=%.2fms slow(>20ms)=%.1f%% avgDraws=%.0f\n"
+                  "[bench] per frame: stagingMapWait=%.2fms splits=%.2f encode=%.2fms acquire=%.2fms submit=%.2fms "
+                  "paceWait=%.2fms present=%.2fms efbReadbacks=%.2f efbReadbackWait=%.2fms textureCreates=%.2f (presents=%.0f encoded=%.0f)\n",
+                  frames.size(), 1000.0 * frames.size() / total, pct(0.50), pct(0.95), pct(0.99), sorted.back(),
+                  100.0 * slow / frames.size(), static_cast<double>(drawSum) / frames.size(),
+                  perMs(w.stagingMapWaitNs, waitsAtStart.stagingMapWaitNs, encoded),
+                  static_cast<double>(w.stagingSplits - waitsAtStart.stagingSplits) / encoded,
+                  perMs(w.encodeNs, waitsAtStart.encodeNs, encoded), perMs(w.acquireNs, waitsAtStart.acquireNs, presents),
+                  perMs(w.submitNs, waitsAtStart.submitNs, presents),
+                  perMs(w.scheduleWaitNs, waitsAtStart.scheduleWaitNs, presents),
+                  perMs(w.presentNs, waitsAtStart.presentNs, presents),
+                  static_cast<double>(w.efbReadbacks - waitsAtStart.efbReadbacks) / static_cast<double>(frames.size()),
+                  perMs(w.efbReadbackWaitNs, waitsAtStart.efbReadbackWaitNs, static_cast<double>(frames.size())),
+                  static_cast<double>(w.textureCreates - waitsAtStart.textureCreates) / static_cast<double>(frames.size()),
+                  presents, encoded);
+    // stderr goes through the runtime's log pipe, whose reader thread dies with _Exit: also
+    // write the summary to bench_result.txt in the working directory.
+    if (FILE* out = std::fopen("bench_result.txt", "w")) {
+        std::fputs(line, out);
+        std::fclose(out);
+    }
+    std::fputs(line, stderr);
+    std::fflush(stderr);
+    std::_Exit(0);
+}
+
 void DrawFpsOverlay() {
+    RunBenchmarkFrame();
     AuroraPresentTiming presentTiming{};
