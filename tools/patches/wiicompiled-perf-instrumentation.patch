+extern FrameWaitCounters g_frameWaits;
+// Adds the time since construction to a counter (and bumps an optional event count).
+struct ScopedWaitTimer {
+  std::atomic<uint64_t>& total;
+  std::atomic<uint64_t>* count;
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+  ~ScopedWaitTimer() {
+    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start);
+    total.fetch_add(static_cast<uint64_t>(ns.count()), std::memory_order_relaxed);
+    if (count != nullptr) count->fetch_add(1, std::memory_order_relaxed);
+  }
+};
