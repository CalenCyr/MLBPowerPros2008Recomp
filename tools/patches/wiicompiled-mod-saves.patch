+// Data-changing mods (a roster...) keep their own saves (mods.h). Read on every call: the NAND is
+// touched before mods::Apply runs, so this cannot be decided once like the Riivolution redirect.
+static RiivolutionSaveRedirect ModSaveRedirect() {
+    RiivolutionSaveRedirect redirect;
+    if (auto directory = mods::SaveDirectory(); !directory.empty()) {
+        static std::once_flag created;
+        std::call_once(created, [&] { CreateDirectoryPath(directory); });
+        redirect.enabled = true;
+        redirect.hostDirectory = std::move(directory);
+    }
+    return redirect;
+}
