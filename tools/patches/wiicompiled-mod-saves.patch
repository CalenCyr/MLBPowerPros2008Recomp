+namespace {
+std::filesystem::path g_saveDirectory;
+}  // namespace
+
+std::filesystem::path SaveDirectoryFor(const std::vector<Mod>& all) {
+    std::vector<std::string> ids;
+    for (const Mod& mod : all) {
+        if (mod.enabled && mod.changesRoster) ids.push_back(mod.id);
+    }
+    if (ids.empty()) return {};
+    std::sort(ids.begin(), ids.end());
+    std::string key;
+    for (const std::string& id : ids) key += (key.empty() ? "" : "+") + id;
+    return RuntimeConfigFile::ApplicationDataDirectory() / "ModSaves" / std::filesystem::path(reinterpret_cast<const char8_t*>(key.c_str()));
+}
+
+std::filesystem::path SaveDirectory() { return g_saveDirectory; }
