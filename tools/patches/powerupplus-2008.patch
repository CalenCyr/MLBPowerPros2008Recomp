diff --git a/PowerUp/PowerUp/GameSave/PowerPros2008/PowerPros2008Roster.cs b/PowerUp/PowerUp/GameSave/PowerPros2008/PowerPros2008Roster.cs
new file mode 100644
index 0000000..ef27754
--- /dev/null
+++ b/PowerUp/PowerUp/GameSave/PowerPros2008/PowerPros2008Roster.cs
@@ -0,0 +1,192 @@
+﻿using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text;
+
+namespace PowerUp.GameSave.PowerPros2008
+{
+  /// <summary>
+  /// MLB Power Pros 2008 keeps the roster block of a 2007 save (1500 players of 0xB0 bytes, lineups,
+  /// free agents, 32 teams) in PROJECT.BIN's game_data.pack, after a 0x20-byte PACKWII header. Most
+  /// player fields sit where 2007 has them; PowerPros2008Fields lists the ones that moved. Importing
+  /// turns the 2008 roster into a 2007 save so the rest of PowerUp works unchanged; the game side
+  /// (the recomp's roster mods) converts PowerUp saves back to 2008 with the player's own disc.
+  /// </summary>
+  public static class PowerPros2008Roster
+  {
+    public const int PlayerSize = 0xB0;
+    public const int Slots = 1500;
+    public const int BlockSize = 0x43E80;
+    public const int SaveBlock2007 = 0x68C74;
+    public const int PackBlock2008 = 0x20;
+    private const int VoiceBit = 0x492, VoiceBits = 14;
+    private const int FaceBit = 0x2A4, FaceBits = 8;
+    private const int SkinBit = 0x2AC, SkinBits = 4;
+
+    /// <summary>
+    /// 2007 SkinAndEyes -> 2008's: 2007 has 5 complexions and adds 5 for brown eyes; 2008 inserted
+    /// a complexion at 2 and adds 6 (695 of the 729 common players match this way).
+    /// </summary>
+    public static int Skin2008(int value) => value + (value < 2 ? 0 : value < 7 ? 1 : 2);
+
+    /// <summary>2008 SkinAndEyes -> 2007's; 2008's new complexion becomes the one before it.</summary>
+    public static int Skin2007(int value) => Enumerable.Range(0, 16).Last(v => Skin2008(v) <= value);
+
+    /// <summary>
+    /// 2007 face id -> 2008's: 2008 inserted faces after 27, 105, 160 and 176 (707 of the 729
+    /// players in both games match this way; the rest got another face).
+    /// </summary>
+    public static int Face2008(int face)
+      => face + (face < 28 ? 0 : face < 106 ? 1 : face < 161 ? 2 : face < 177 ? 7 : 12);
+
+    /// <summary>2008 face id -> 2007's, the numbering PowerUp's editor shows; a face 2008 added
+    /// becomes the 2007 one before it.</summary>
+    public static int Face2007(int face)
+      => Enumerable.Range(0, 256).Last(f => Face2008(f) <= face);
+
+    /// <summary>The 2008 face and SkinAndEyes of each player of game_data.pack, by player id.</summary>
+    public static Dictionary<int, (int Face, int Skin)> LooksById(byte[] pack)
+    {
+      var looks = new Dictionary<int, (int Face, int Skin)>();
+      for (var i = 0; i < Slots; i++)
+      {
+        var record = pack.AsSpan(PackBlock2008 + i * PlayerSize, PlayerSize);
+        var id = record[0] << 8 | record[1];
+        if (id != 0)
+          looks.TryAdd(id, ((int)GetBits(record, FaceBit, FaceBits), (int)GetBits(record, SkinBit, SkinBits)));
+      }
+      return looks;
+    }
+
+    /// <summary>
+    /// Where an import keeps the player's 2008 game_data.pack (next to PowerUp's base save, never
+    /// shared), so a 2008 mod export can tell which values the user left as they were.
+    /// </summary>
+    public static string OriginalPackPath(string baseSavePath)
+      => Path.Combine(Path.GetDirectoryName(baseSavePath)!, "PowerPros2008_game_data.pack");
+
+    /// <summary>
+    /// game_data.pack from MLB Power Pros 2008's game_data.pack or PROJECT.BIN (a seekable stream),
+    /// else null. Only the archive header and the one entry are read.
+    /// </summary>
+    public static byte[]? FindGameDataPack(Stream stream)
+    {
+      if (stream.Length == PackBlock2008 + BlockSize)
+      {
+        var whole = ReadAt(stream, 0, (int)stream.Length);
+        return IsGameDataPack(whole) ? whole : null;
+      }
+      // PROJECT.BIN: u32 version 2, u32 sector size 0x800; records of 0x1C bytes at 0x14, an order
+      // table (record index, start sector) at 0x28, names at 0x2C, data at 0x34.
+      if (stream.Length < 0x40)
+        return null;
+      var head = ReadAt(stream, 0, 0x40);
+      if (BE32(head, 0) != 2 || BE32(head, 4) != 0x800 || BE32(head, 0x34) > Math.Min(stream.Length, 0x1000000))
+        return null;
+      var data = ReadAt(stream, 0, (int)BE32(head, 0x34));
+      var records = BE32(data, 0x14);
+      var order = BE32(data, 0x28);
+      var names = BE32(data, 0x2C);
+      for (var slot = 1L; order + slot * 8 + 8 <= names; slot++)
+      {
+        var index = BE32(data, order + slot * 8);
+        var sector = BE32(data, order + slot * 8 + 4);
+        if (index == 0 && sector == 0)
+          break;
+        var record = records + index * 0x1C;
+        var nameStart = names + BE32(data, record + 4);
+        var nameEnd = Array.IndexOf(data, (byte)0, (int)nameStart);
+        var name = Encoding.ASCII.GetString(data, (int)nameStart, nameEnd - (int)nameStart);
+        if (!name.Equals("/game_data.pack", StringComparison.OrdinalIgnoreCase))
+          continue;
+        var pack = ReadAt(stream, data.Length + sector * 0x800, (int)BE32(data, record + 0x18));
+        return IsGameDataPack(pack) ? pack : null;
+      }
+      return null;
+    }
+
+    private static byte[] ReadAt(Stream stream, long offset, int count)
+    {
+      var buffer = new byte[count];
+      stream.Position = offset;
+      stream.ReadExactly(buffer);
+      return buffer;
+    }
+
+    /// <summary>A 2007 save (a copy of <paramref name="baseSave"/>) holding the 2008 roster.</summary>
+    public static byte[] ToGameSave(byte[] pack, byte[] baseSave)
+    {
+      var save = (byte[])baseSave.Clone();
+      var newBlock = pack.AsSpan(PackBlock2008, BlockSize);
+      var oldBlock = save.AsSpan(SaveBlock2007, BlockSize);
+
+      // The second "versus lefty", which 2008 dropped, comes from the base save's record of the
+      // same player (same last and first name, 0x16..0x4D), when there is one. The voice id sits
+      // where 2007 has it and keeps 2008's numbering; face and skin/eyes go back to 2007's.
+      var basePlayers = new Dictionary<string, byte[]>();
+      for (var i = 0; i < Slots; i++)
+      {
+        var record = oldBlock.Slice(i * PlayerSize, PlayerSize).ToArray();
+        if (record[0] != 0 || record[1] != 0)
+          basePlayers.TryAdd(NameKey(record), record);
+      }
+
+      for (var i = 0; i < Slots; i++)
+      {
+        var from = newBlock.Slice(i * PlayerSize, PlayerSize).ToArray();
+        var to = oldBlock.Slice(i * PlayerSize, PlayerSize);
+        to.Clear();
+        if (from[0] == 0 && from[1] == 0)
+          continue;
+        if (basePlayers.TryGetValue(NameKey(from), out var same))
+          same.CopyTo(to);
+        from.AsSpan(0, 0x5C).CopyTo(to);
+        from.AsSpan(0x60, 0x0F).CopyTo(to.Slice(0x60));
+        foreach (var field in PowerPros2008Fields.All)
+        {
+          var value = GetBits(from, field.To, field.ToBits);
+          if (field.BirthYear && value != 0)
+            value -= 1;
+          SetBits(to, field.From, field.Bits, value);
+        }
+        SetBits(to, VoiceBit, VoiceBits, GetBits(from, VoiceBit, VoiceBits));
+        SetBits(to, FaceBit, FaceBits, (uint)Face2007((int)GetBits(from, FaceBit, FaceBits)));
+        SetBits(to, SkinBit, SkinBits, (uint)Skin2007((int)GetBits(from, SkinBit, SkinBits)));
+      }
+
+      var players = Slots * PlayerSize;
+      newBlock.Slice(players).CopyTo(oldBlock.Slice(players));
+      return save;
+    }
+
+    private static bool IsGameDataPack(byte[] data)
+      => data.Length == PackBlock2008 + BlockSize && Encoding.ASCII.GetString(data, 0, 8) == "PACKWII ";
+
+    private static string NameKey(byte[] record) => Convert.ToHexString(record, 0x16, 0x38);
+
+    private static long BE32(byte[] data, long offset)
+      => (long)data[offset] << 24 | (long)data[offset + 1] << 16 | (long)data[offset + 2] << 8 | data[offset + 3];
+
+    private static uint GetBits(ReadOnlySpan<byte> record, int bit, int count)
+    {
+      uint value = 0;
+      for (var i = bit; i < bit + count; i++)
+        value = value << 1 | (uint)(record[i / 8] >> (7 - i % 8) & 1);
+      return value;
+    }
+
+    private static void SetBits(Span<byte> record, int bit, int count, uint value)
+    {
+      for (var i = 0; i < count; i++)
+      {
+        var b = bit + i;
+        var mask = (byte)(0x80 >> (b % 8));
+        if ((value >> (count - 1 - i) & 1) != 0)
+          record[b / 8] |= mask;
+        else
+          record[b / 8] &= (byte)~mask;
+      }
+    }
+  }
+}
