+        lastNames,
+        lastNames.ToDictionary(kvp => kvp.Key, kvp => kvp.Value.RemovePrefixesAndSuffixes().GetSoundex()),
+        firstName,
+        lastName);
+      return (ushort)voices.Select(v => new KeyValuePair<int, string>(v.VoiceId!.Value, "")).MaxBy(kvp => kvp, comparer).Key;
+    }
