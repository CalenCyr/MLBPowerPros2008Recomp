+// POWERPROS_SCHEDULER_IDLE_BEGIN
+namespace
+{
+u32 PowerProsIdleRead32(const u8* ram, u32 offset)
+{
+  return static_cast<u32>(ram[offset]) << 24 | static_cast<u32>(ram[offset + 1]) << 16 |
+         static_cast<u32>(ram[offset + 2]) << 8 | ram[offset + 3];
+}
+
+bool PowerProsCanIdleScheduler(u32 pc, u32 msr, u32 r13, u32 guest_exception,
+                              u32 pending_exceptions, const u8* ram, u32 ram_size)
+{
+  // RL8E54 SelectThread's empty run-queue wait. Require its exact SDA and loop.
+  if (pc != 0x800A4318u || (msr & 0x8000u) == 0 || r13 != 0x80322060u ||
+      guest_exception != 0 || pending_exceptions != 0 || !ram || ram_size < 0x0031B274u)
+    return false;
+  return PowerProsIdleRead32(ram, 0x000A4318u) == 0x800D9210u &&
+         PowerProsIdleRead32(ram, 0x000A431Cu) == 0x2C000000u &&
+         PowerProsIdleRead32(ram, 0x000A4320u) == 0x4182FFF8u &&
+         PowerProsIdleRead32(ram, 0x0031B270u) == 0;
+}
+}
+// POWERPROS_SCHEDULER_IDLE_END
 
