+        // MLB 0x8057BEEC: r0 first holds r4 - 13 (compared with 2), then slwi r0, r3, 2 indexes a
+        // ten-entry table bounded by cmplwi r3, 9. The stale r0 compare must not size the table.
+        const uint baseAddr = 0x80002000;
+        const uint tableAddr = 0x80002200;
