+    private static bool TryFindMaskBound(IReadOnlyList<PpcInstruction> ordered, int startIndex, string register, out int upperBound)
+    {
+        // rlwinm rI, rS, SH, MB, ME producing a word-aligned byte offset: the mask limits the
+        // largest offset, so the table has at most (mask >> 2) + 1 entries.
+        upperBound = 0;
+        for (var i = startIndex - 1; i >= 0 && startIndex - i <= MaxBacktrackInstructions; i--)
+        {
+            var ins = ordered[i];
+            if (ins.Operands.Count == 0 || ins.Operands[0] is not PpcRegisterOperand reg ||
+                !string.Equals(reg.Name, register, StringComparison.OrdinalIgnoreCase))
+            {
+                continue;
+            }
+            if (ins.Mnemonic is not "rlwinm" || ins.Operands.Count < 5 ||
+                ins.Operands[3] is not PpcImmediateOperand mb || ins.Operands[4] is not PpcImmediateOperand me ||
+                mb.Value > me.Value || me.Value != 29)
+            {
+                return false; // the index register comes from something else
+            }
+            var mask = (uint)((1UL << (32 - mb.Value)) - 1) & ~((1u << (31 - me.Value)) - 1);
+            upperBound = (int)(mask >> 2);
+            return true;
+        }
+        return false;
+    }
