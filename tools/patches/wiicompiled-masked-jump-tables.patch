+            PpcInstruction.Synthetic(baseAddr + 0x00, 0, "addi", new PpcOperand[] { new PpcRegisterOperand("r0", 0), new PpcRegisterOperand("r4", 4), new PpcImmediateOperand(-13) }),
+            PpcInstruction.Synthetic(baseAddr + 0x04, 0, "cmplwi", new PpcOperand[] { new PpcRegisterOperand("r0", 0), new PpcImmediateOperand(2) }),
+            PpcInstruction.Synthetic(baseAddr + 0x08, 0, "cmplwi", new PpcOperand[] { new PpcRegisterOperand("r3", 3), new PpcImmediateOperand(3) }),
+            PpcInstruction.Synthetic(baseAddr + 0x0C, 0, "lis", new PpcOperand[] { new PpcRegisterOperand("r5", 5), new PpcImmediateOperand(unchecked((short)0x8000)) }),
+            PpcInstruction.Synthetic(baseAddr + 0x10, 0, "slwi", new PpcOperand[] { new PpcRegisterOperand("r0", 0), new PpcRegisterOperand("r3", 3), new PpcImmediateOperand(2) }),
+            PpcInstruction.Synthetic(baseAddr + 0x14, 0, "addi", new PpcOperand[] { new PpcRegisterOperand("r5", 5), new PpcRegisterOperand("r5", 5), new PpcImmediateOperand(0x2200) }),
+            PpcInstruction.Synthetic(baseAddr + 0x18, 0, "lwzx", new PpcOperand[] { new PpcRegisterOperand("r5", 5), new PpcRegisterOperand("r5", 5), new PpcRegisterOperand("r0", 0) }),
+            PpcInstruction.Synthetic(baseAddr + 0x1C, 0, "mtctr", new PpcOperand[] { new PpcRegisterOperand("r5", 5) }),
