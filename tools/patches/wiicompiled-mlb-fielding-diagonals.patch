diff --git a/runtime/include/mlb_fielding_stick.h b/runtime/include/mlb_fielding_stick.h
new file mode 100644
index 0000000..551aae4
--- /dev/null
+++ b/runtime/include/mlb_fielding_stick.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+// RL8E54 fielding: a fielder runs on a diagonal only when the stick reads like the keyboard's W+D,
+// (127,127) before the GameCube gate scaling. A modern stick is a circle and gives about (90,90)
+// there, so the fielder walks. While the fielding decoder (0x8088540C) is active for a port, that
+// port's main stick is read as a square instead: same direction, the radius on each axis.
+// Batting and pitching never go through the decoder and keep the circle.
+namespace mlb_fielding {
+struct Stick { int x, y; };
+
+inline Stick SquareStick(int x, int y) {
+    if (x == 0 || y == 0) return {x, y};
+    const double radius = std::min(std::hypot(double(x), double(y)), 127.0);
+    const double scale = radius / std::max(std::abs(x), std::abs(y));
+    const auto axis = [&](int v) { return std::clamp(int(std::lround(v * scale)), -127, 127); };
+    return {axis(x), axis(y)};
+}
+
+// PAD reads (one per frame) on which the decoder last ran for each port.
+struct Window {
+    std::array<uint64_t, 4> marked{};
+    void Mark(unsigned port, uint64_t read) { if (port < marked.size()) marked[port] = read + 1; }
+    bool Active(unsigned port, uint64_t read) const {
+        return port < marked.size() && marked[port] != 0 && read <= marked[port];
+    }
+};
+}
