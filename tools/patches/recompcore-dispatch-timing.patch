+// POWERPROS_DISPATCH_TIMING_BEGIN
+namespace
+{
+struct PowerProsDispatchTiming
+{
+  using Clock = std::chrono::steady_clock;
+  static constexpr u64 stride = 4096;
+  struct Aggregate
+  {
+    u64 samples = 0;
+    u64 total_ns = 0;
+    u64 max_ns = 0;
+    void Add(u64 ns)
+    {
+      ++samples;
+      total_ns += ns;
+      if (ns > max_ns)
+        max_ns = ns;
+    }
+  };
+  std::string path;
+  u64 observed[2]{};
+  Aggregate phases[2][3]{};
+  Aggregate clock_pair{};
+
+  static u64 Elapsed(Clock::time_point start)
+  {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                               Clock::now() - start).count());
+  }
+  void Reset(const char* output)
+  {
+    path = output ? output : "";
+    observed[0] = observed[1] = 0;
+    for (auto& context : phases)
+      for (auto& phase : context)
+        phase = {};
+    clock_pair = {};
+    if (!path.empty())
+      for (u32 i = 0; i < 10000; ++i)
+        clock_pair.Add(Elapsed(Clock::now()));
+  }
+  bool Sample(u32 pc, u32 rel_begin, u64 rel_end, u32* context)
+  {
+    if (path.empty())
+      return false;
+    const u32 kind = pc >= rel_begin && static_cast<u64>(pc) < rel_end ? 1 : 0;
+    if ((++observed[kind] % stride) != 0)
+      return false;
+    *context = kind;
+    return true;
+  }
+  void Add(u32 context, u32 phase, u64 ns)
+  {
+    if (!path.empty() && context < 2 && phase < 3)
+      phases[context][phase].Add(ns);
+  }
+  bool Write() const
+  {
+    if (path.empty())
+      return true;
+    std::FILE* file = std::fopen(path.c_str(), "wb");
+    if (!file)
+      return false;
+    std::fprintf(file, "context,phase,observed_dispatches,stride,samples,total_ns,max_ns\n");
+    const char* names[] = {"address_resolution", "module_dispatch", "return_translation"};
+    for (u32 context = 0; context < 2; ++context)
+      for (u32 phase = 0; phase < 3; ++phase)
+      {
+        const Aggregate& value = phases[context][phase];
+        std::fprintf(file, "%s,%s,%llu,%llu,%llu,%llu,%llu\n",
+                     context ? "inside_rel_envelope" : "outside_rel_envelope", names[phase],
+                     static_cast<unsigned long long>(observed[context]),
+                     static_cast<unsigned long long>(stride),
+                     static_cast<unsigned long long>(value.samples),
+                     static_cast<unsigned long long>(value.total_ns),
+                     static_cast<unsigned long long>(value.max_ns));
+      }
+    std::fprintf(file, "calibration,clock_pair,0,0,%llu,%llu,%llu\n",
+                 static_cast<unsigned long long>(clock_pair.samples),
+                 static_cast<unsigned long long>(clock_pair.total_ns),
+                 static_cast<unsigned long long>(clock_pair.max_ns));
+    const bool written = std::ferror(file) == 0;
+    const int closed = std::fclose(file);
+    return written && closed == 0;
+  }
+};
+PowerProsDispatchTiming g_powerpros_dispatch_timing;
+}
+// POWERPROS_DISPATCH_TIMING_END
+
+void PowerProsResetDispatchTiming()
+{
+  g_powerpros_dispatch_timing.Reset(std::getenv("STATICRECOMP_DISPATCH_TIMING"));
+}
+void PowerProsWriteDispatchTiming()
+{
+  if (!g_powerpros_dispatch_timing.Write())
+    std::fprintf(stderr, "[powerpros-diagnostic] dispatch timing output failed\n");
+}
