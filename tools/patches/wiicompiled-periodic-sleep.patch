@@ -23,6 +24,35 @@ namespace OsHleInternal {
 std::mutex gSleepTimerMutex;
 std::vector<SleepTimerEntry> gSleepTimers;
 
+// Earliest pending sleep deadline, never later than the real one (a stale early value only costs
+// one extra scheduler pass). Lets the interrupt-enable hooks test for a due timer without locking.
+std::atomic<std::chrono::steady_clock::rep> gEarliestSleepDeadline{
+    std::numeric_limits<std::chrono::steady_clock::rep>::max()};
+
+// Callers hold gSleepTimerMutex.
+void NoteSleepDeadline(std::chrono::steady_clock::time_point deadline)
+{
+    const auto value = deadline.time_since_epoch().count();
+    if (value < gEarliestSleepDeadline.load(std::memory_order_relaxed)) {
+        gEarliestSleepDeadline.store(value, std::memory_order_relaxed);
+    }
+}
+
+void RefreshEarliestSleepDeadline()
+{
+    auto earliest = std::numeric_limits<std::chrono::steady_clock::rep>::max();
+    for (const SleepTimerEntry& entry : gSleepTimers) {
+        earliest = std::min(earliest, entry.deadline.time_since_epoch().count());
+    }
+    gEarliestSleepDeadline.store(earliest, std::memory_order_relaxed);
+}
+
+bool SleepTimerOverdue()
+{
+    return std::chrono::steady_clock::now().time_since_epoch().count() >=
+           gEarliestSleepDeadline.load(std::memory_order_relaxed);
+}
