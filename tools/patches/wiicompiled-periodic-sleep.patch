+extern "C" void OS_HLE_PreemptionPoint();
+
+// Guest-code entry points only (runtime C++ keeps calling the plain versions above). On hardware,
+// re-enabling interrupts with a timer interrupt pending takes it at once and the interrupt return
+// switches to the woken higher-priority thread. Guest threads here are cooperative fibers, so a
+// due OSSleepTicks timer otherwise waits for the running thread to block: MLB's main thread can
+// compute a whole frame without blocking and starve the 5 ms sound ticker.
+extern "C" int32_t OSRestoreInterrupts_GuestEntry(int32_t level)
+{
+    const int32_t previous = OS__RestoreInterrupts_801a65d4(level);
+    if (level != 0 && previous == 0 && SleepTimerOverdue()) {
+        OS_HLE_PreemptionPoint();
+    }
+    return previous;
+}
+
+extern "C" int32_t OSEnableInterrupts_GuestEntry()
+{
+    const int32_t previous = OS__EnableInterrupts_801a65c0();
+    if (previous == 0 && SleepTimerOverdue()) {
+        OS_HLE_PreemptionPoint();
+    }
+    return previous;
+}
