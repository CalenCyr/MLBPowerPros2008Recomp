+    // Guest threads are cooperative fibers, so a sleep timer only fires when some thread reaches
+    // the scheduler, typically milliseconds late. A loop that repeats the same sleep (MLB's 5 ms
+    // sound ticker, whose wakes advance the commentary phrase clocks) then runs 15-45% slow and
+    // phrases are stopped late. On hardware the alarm interrupt is on time, so anchor a repeated
+    // sleep to the previous deadline; the lost time is caught up, at up to four wakes per period,
+    // when other threads idle or guest code re-enables interrupts (os_interrupt.cpp). A sleep with
+    // a different length or long after the last deadline starts from now, as in the SDK.
+    struct LastSleep { uint64_t ticks; Clock::time_point deadline; };
+    static std::unordered_map<uint32_t, LastSleep> lastSleeps;
+    constexpr auto kMaxCatchUp = std::chrono::milliseconds(50);
 
     std::lock_guard<std::mutex> lock(gSleepTimerMutex);
+    LastSleep& last = lastSleeps[threadPtr];
+    auto anchor = deadline;
+    if (last.ticks == ticks && now - last.deadline <= kMaxCatchUp && last.deadline <= now) {
+        anchor = last.deadline + duration;
+        // The timer itself is never already due: a past deadline can fire before the thread
+        // finishes parking. The anchor keeps the full debt so it is still caught up later.
+        deadline = std::max(anchor, now + duration / 4);
+    }
+    last = {ticks, anchor};
     std::erase_if(gSleepTimers, [threadPtr](const SleepTimerEntry& entry) {
         return entry.threadPtr == threadPtr;
     });
     gSleepTimers.push_back({threadPtr, deadline});
+    NoteSleepDeadline(deadline);
 }
 
