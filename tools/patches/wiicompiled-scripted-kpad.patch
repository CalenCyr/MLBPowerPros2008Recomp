+// Scripted remote on channel 0 for automated probes, no Bluetooth needed:
+// WIICOMPILED_KPAD_SCRIPT="startMs-endMs:hexButtons,..." holds the WPAD_BUTTON_*
+// bits during each window of SDL_GetTicks (milliseconds since SDL started).
+// WIICOMPILED_KPAD_EXT=nunchuk attaches a Nunchuk (C 0x4000, Z 0x2000, stick centred).
+struct ScriptStep {
+    uint64_t start, end;
+    uint32_t hold;
+};
+
+static const std::vector<ScriptStep>* KpadScript() {
+    static const std::vector<ScriptStep>* script = []() -> const std::vector<ScriptStep>* {
+        const char* env = std::getenv("WIICOMPILED_KPAD_SCRIPT");
+        if (env == nullptr || *env == '\0') return nullptr;
+        auto* steps = new std::vector<ScriptStep>;
+        unsigned long long start = 0, end = 0;
+        unsigned int hold = 0;
+        int used = 0;
+        for (const char* p = env; std::sscanf(p, "%llu-%llu:%x%n", &start, &end, &hold, &used) == 3;) {
+            steps->push_back({start, end, hold});
+            p += used;
+            if (*p != ',') break;
+            ++p;
+        }
+        return steps;
+    }();
+    return script;
+}
+
+static bool IsScriptedChannel(uint32_t chan) {
+    return chan == 0 && KpadScript() != nullptr;
+}
+
+static bool ScriptedNunchuk() {
+    static const bool nunchuk = [] {
+        const char* ext = std::getenv("WIICOMPILED_KPAD_EXT");
+        return ext != nullptr && std::strcmp(ext, "nunchuk") == 0;
+    }();
+    return nunchuk;
+}
+
+static uint32_t ScriptedHold() {
+    const uint64_t now = SDL_GetTicks();
+    uint32_t hold = 0;
+    for (const ScriptStep& step : *KpadScript()) {
+        if (now >= step.start && now < step.end) hold |= step.hold;
+    }
+    return hold;
+}
