+// 2007 voice id -> 2008's (kVoiceRuns), or 0 (no voice) for one 2008 removed.
+uint32_t Voice2008(uint32_t voice) {
+    for (const VoiceRun& run : kVoiceRuns) {
+        if (voice >= run.first && voice <= run.last) return voice + run.offset;
+    }
+    return 0;
+}
